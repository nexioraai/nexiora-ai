  "rules": [
    {
      "id": "rule_animal_identite",
      "description": "Une fiche chien exige un nom, une race, une taille et un propriétaire rattaché.",
      "kind": "validation",
      "entityId": "ent_animal",
      "assertions": [
        {
          "fieldId": "fld_animal_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_race",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_taille",
          "operator": "in",
          "value": [
            "petit",
            "moyen",
            "grand",
            "tres_grand"
          ]
        },
        {
          "fieldId": "fld_animal_proprietaire",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_animal_poids_positif",
      "description": "Le poids saisi pour un chien doit être strictement supérieur à zéro.",
      "kind": "validation",
      "entityId": "ent_animal",
      "assertions": [
        {
          "fieldId": "fld_animal_poids",
          "operator": "gt",
          "value": 0
        }
      ]
    },
    {
      "id": "rule_proprietaire_contact",
      "description": "Le propriétaire doit fournir un nom, un téléphone et un email valide pour être joignable.",
      "kind": "validation",
      "entityId": "ent_proprietaire",
      "assertions": [
        {
          "fieldId": "fld_proprio_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_proprio_telephone",
          "operator": "required"
        },
        {
          "fieldId": "fld_proprio_email",
          "operator": "matches",
          "value": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"
        }
      ]
    },
    {
      "id": "rule_prestation_tarif",
      "description": "Une prestation doit porter un nom, un tarif strictement positif et une durée d'au moins 15 minutes.",
      "kind": "validation",
      "entityId": "ent_prestation",
      "assertions": [
        {
          "fieldId": "fld_prestation_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_prestation_prix",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_prestation_duree",
          "operator": "gte",
          "value": 15
        }
      ]
    },
    {
      "id": "rule_rdv_complet",
      "description": "Un rendez-vous exige un chien, une prestation, une date et un statut connu.",
      "kind": "validation",
      "entityId": "ent_rendez_vous",
      "assertions": [
        {
          "fieldId": "fld_rdv_animal",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_prestation",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_statut",
          "operator": "in",
          "value": [
            "demande",
            "confirme",
            "honore",
            "annule"
          ]
        }
      ]
    },
    {
      "id": "rule_rdv_paiement_sur_place",
      "description": "Le règlement se fait exclusivement sur place : aucun autre mode de paiement n'est accepté à la réservation.",
      "kind": "validation",
      "entityId": "ent_rendez_vous",
      "assertions": [
        {
          "fieldId": "fld_rdv_paiement",
          "operator": "eq",
          "value": "sur_place"
        }
      ]
    },
    {
      "id": "rule_vaccination_complete",
      "description": "Une vaccination exige le chien concerné, le type de vaccin, la date d'injection et la date de rappel.",
      "kind": "validation",
      "entityId": "ent_vaccination",
      "assertions": [
        {
          "fieldId": "fld_vaccin_animal",
          "operator": "required"
        },
        {
          "fieldId": "fld_vaccin_type",
          "operator": "in",
          "value": [
            "rage",
            "chpl",
            "toux_du_chenil",
            "leptospirose",
            "piroplasmose"
          ]
        },
        {
          "fieldId": "fld_vaccin_date_injection",
          "operator": "required"
        },
        {
          "fieldId": "fld_vaccin_date_rappel",
          "operator": "required"
        },
        {
          "fieldId": "fld_vaccin_statut",
          "operator": "in",
          "value": [
            "a_jour",
            "rappel_proche",
            "expire"
          ]
        }
      ]
    },
    {
      "id": "rule_visite_paiement",
      "description": "Une visite d'historique enregistre un montant non négatif et un mode de règlement encaissé sur place.",
      "kind": "validation",
      "entityId": "ent_visite",
      "assertions": [
        {
          "fieldId": "fld_visite_date",
          "operator": "required"
