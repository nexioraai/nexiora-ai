        },
        "effect": {
          "kind": "mutation",
          "entityId": "ent_ticket",
          "operation": "update"
        }
      }
    ],
    "rules": [
      {
        "id": "rule_event_publication_valide",
        "description": "Un concert publié doit avoir un titre, une date de début, un statut connu et un tarif positif ou nul.",
        "kind": "validation",
        "entityId": "ent_event",
        "assertions": [
          {
            "fieldId": "fld_event_title",
            "operator": "required"
          },
          {
            "fieldId": "fld_event_starts_at",
            "operator": "required"
          },
          {
            "fieldId": "fld_event_venue",
            "operator": "required"
          },
          {
            "fieldId": "fld_event_price",
            "operator": "gte",
            "value": 0
          },
          {
            "fieldId": "fld_event_status",
            "operator": "in",
            "value": [
              "draft",
              "on_sale",
              "sold_out",
              "cancelled",
              "past"
            ]
          }
        ]
      },
      {
        "id": "rule_event_stock_disponible",
        "description": "Le nombre de places restantes ne peut jamais être négatif.",
        "kind": "validation",
        "entityId": "ent_event",
        "assertions": [
          {
            "fieldId": "fld_event_seats_available",
            "operator": "gte",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_ticket_achat_valide",
        "description": "Un achat de billet porte sur 1 à 6 places, avec un e-mail acheteur valide et un montant payé positif.",
        "kind": "validation",
        "entityId": "ent_ticket",
        "assertions": [
          {
            "fieldId": "fld_ticket_quantity",
            "operator": "gte",
            "value": 1
          },
          {
            "fieldId": "fld_ticket_quantity",
            "operator": "lte",
            "value": 6
          },
          {
            "fieldId": "fld_ticket_buyer_email",
            "operator": "matches",
            "value": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"
          },
          {
            "fieldId": "fld_ticket_amount_paid",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_ticket_holder_name",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_ticket_reference_unique",
        "description": "Chaque billet possède une référence et une charge utile de code scannable non vides.",
        "kind": "validation",
        "entityId": "ent_ticket",
        "assertions": [
          {
            "fieldId": "fld_ticket_reference",
            "operator": "required"
          },
          {
            "fieldId": "fld_ticket_scan_payload",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_ticket_affichage_autorise",
        "description": "Le code scannable n'est affiché que pour un billet payé ou déjà contrôlé à l'entrée.",
        "kind": "authorization",
        "entityId": "ent_ticket",
        "assertions": [
          {
            "fieldId": "fld_ticket_status",
            "operator": "in",
            "value": [
              "paid",
              "checked_in"
            ]
          }
        ]
      },
      {
        "id": "rule_ticket_remboursement_masque",
        "description": "Un billet remboursé ou annulé ne peut plus être présenté au contrôle d'accès.",
        "kind": "authorization",
        "entityId": "ent_ticket",
        "assertions": [
          {
            "fieldId": "fld_ticket_status",
            "operator": "neq",
            "value": "refunded"
          },
          {
            "fieldId": "fld_ticket_status",
            "operator": "neq",
            "value": "cancelled"
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_scan_payload_builder",
        "description": "Construit la charge utile signée du code scannable présenté à l'entrée du concert à partir de la référence du billet.",
        "inputs": [
          {
            "name": "ticketReference",
            "type": "string"
          },
          {
            "name": "eventId",
            "type": "string"
          },
          {
            "name": "issuedAt",
            "type": "datetime"
          }
        ],
        "outputs": [
          {
            "name": "scanPayload",
            "type": "string"
          },
          {
            "name": "expiresAt",
            "type": "datetime"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_calendar_event_builder",
        "description": "Prépare les données d'événement (titre, horaires, lieu, rappel) à insérer dans le calendrier du téléphone.",
        "inputs": [
          {
            "name": "eventTitle",
            "type": "string"
          },
          {
            "name": "startsAt",
            "type": "datetime"
          },
          {
            "name": "endsAt",
            "type": "datetime"
          },
          {
            "name": "venueLabel",
            "type": "string"
          },
          {
            "name": "notes",
            "type": "text"
          }
        ],
        "outputs": [
          {
            "name": "calendarEntry",
            "type": "json"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_event_price_formatter",
        "description": "Formate le prix d'un concert et le montant total du panier selon la locale française et la devise du concert.",
        "inputs": [
          {
            "name": "amount",
            "type": "decimal"
          },
          {
            "name": "currency",
            "type": "enum"
          },
          {
            "name": "quantity",
            "type": "number"
          }
        ],
        "outputs": [
          {
            "name": "formattedUnitPrice",
            "type": "string"
          },
          {
            "name": "formattedTotal",
            "type": "string"
          },
          {
            "name": "totalAmount",
            "type": "decimal"
          }
        ],
        "allowedImports": [
          "intl"
        ]
      },
      {
        "id": "slot_upcoming_events_sorter",
        "description": "Trie et filtre la liste des concerts à venir (statut en vente, date future) pour l'écran d'accueil.",
        "inputs": [
          {
            "name": "events",
            "type": "json"
          },
          {
            "name": "now",
            "type": "datetime"
          }
        ],
        "outputs": [
          {
            "name": "upcomingEvents",
            "type": "json"
          },
          {
            "name": "nextEventLabel",
            "type": "string"
          }
        ],
        "allowedImports": []
      }
    ],
