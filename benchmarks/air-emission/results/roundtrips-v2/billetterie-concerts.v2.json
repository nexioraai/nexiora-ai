        "effect": {
          "kind": "capability",
          "capability": "auth",
          "method": "restoreSession",
          "params": [
            {
              "key": "anonymousAllowed",
              "value": true
            },
            {
              "key": "redirectScreenId",
              "value": "scr_events_list"
            }
          ]
        }
      },
      {
        "id": "act_precharger_hors_ligne",
        "name": "Précharger les concerts pour consultation hors-ligne",
        "trigger": {
          "kind": "lifecycle",
          "event": "app_start"
