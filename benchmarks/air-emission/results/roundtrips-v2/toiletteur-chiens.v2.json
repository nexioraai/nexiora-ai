    "rules": [
      {
        "id": "rule_animal_identite_complete",
        "description": "Un animal doit avoir un nom, une taille et les coordonnées téléphoniques de son propriétaire.",
        "kind": "validation",
        "entityId": "ent_animal",
        "assertions": [
          {
            "fieldId": "fld_animal_nom",
            "operator": "required"
          },
          {
            "fieldId": "fld_animal_taille",
            "operator": "in",
            "value": [
              "petit",
              "moyen",
              "grand",
              "tres_grand"
            ]
          },
          {
            "fieldId": "fld_animal_proprietaire_telephone",
            "operator": "matches",
            "value": "^[+0-9][0-9 .-]{6,19}$"
          }
        ]
      },
      {
        "id": "rule_animal_vaccination",
        "description": "Si la vaccination est déclarée à jour, la date de rappel doit être renseignée pour permettre l'envoi du rappel.",
        "kind": "validation",
        "entityId": "ent_animal",
        "assertions": [
          {
            "fieldId": "fld_animal_vaccin_a_jour",
            "operator": "eq",
            "value": true
          },
          {
            "fieldId": "fld_animal_vaccin_rappel",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_rdv_creneau_valide",
        "description": "Un rendez-vous dure entre 30 et 240 minutes et possède un statut connu ainsi qu'une date de début.",
        "kind": "validation",
        "entityId": "ent_rendez_vous",
        "assertions": [
          {
            "fieldId": "fld_rdv_debut",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_duree_minutes",
            "operator": "gte",
            "value": 30
          },
          {
            "fieldId": "fld_rdv_duree_minutes",
            "operator": "lte",
            "value": 240
          },
          {
            "fieldId": "fld_rdv_statut",
            "operator": "in",
            "value": [
              "demande",
              "confirme",
              "annule",
              "honore"
            ]
          }
        ]
      },
      {
        "id": "rule_visite_paiement_sur_place",
        "description": "Une visite enregistre un montant positif réglé sur place (aucun paiement en ligne).",
        "kind": "validation",
        "entityId": "ent_visite",
        "assertions": [
          {
            "fieldId": "fld_visite_montant",
            "operator": "gte",
            "value": 0
          },
          {
            "fieldId": "fld_visite_mode_paiement",
            "operator": "in",
            "value": [
              "especes",
              "carte_sur_place",
              "cheque"
            ]
          },
          {
            "fieldId": "fld_visite_date",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_acces_fiche_proprietaire",
        "description": "Seul le propriétaire authentifié rattaché à l'animal peut consulter et modifier sa fiche.",
        "kind": "authorization",
        "entityId": "ent_animal",
        "assertions": [
          {
            "fieldId": "fld_animal_proprietaire_email",
            "operator": "eq",
            "value": "current_user.email"
          },
          {
            "fieldId": "fld_animal_actif",
            "operator": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "rule_acces_historique_proprietaire",
        "description": "L'historique d'une visite n'est lisible que pour l'animal appartenant à l'utilisateur connecté.",
        "kind": "authorization",
        "entityId": "ent_visite",
        "assertions": [
          {
            "fieldId": "fld_visite_animal",
            "operator": "in",
            "value": [
              "current_user.animaux"
            ]
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_creneaux_disponibles",
        "description": "Calcule les créneaux de rendez-vous disponibles pour une journée donnée en fonction des horaires du salon, de la prestation demandée et de la taille du chien.",
        "inputs": [
          {
            "name": "jour",
            "type": "date"
          },
          {
            "name": "prestation",
            "type": "enum"
          },
          {
            "name": "tailleAnimal",
            "type": "enum"
          },
          {
            "name": "rendezVousExistants",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "creneaux",
            "type": "json"
          },
          {
            "name": "dureeEstimeeMinutes",
            "type": "number"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_prochain_rappel_vaccination",
        "description": "Détermine la date du prochain rappel de vaccination et si une alerte doit être affichée sur la fiche de l'animal.",
        "inputs": [
          {
            "name": "derniereVaccination",
            "type": "date"
          },
          {
            "name": "rappelDeclare",
            "type": "date"
          },
          {
            "name": "dateReference",
            "type": "date"
          }
        ],
        "outputs": [
          {
            "name": "prochainRappel",
            "type": "date"
          },
          {
            "name": "alerteRequise",
            "type": "boolean"
          },
          {
            "name": "joursRestants",
            "type": "number"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_resume_historique",
        "description": "Agrège l'historique des visites d'un animal : nombre de passages, montant total réglé sur place et fréquence moyenne entre deux toilettages.",
        "inputs": [
          {
            "name": "visites",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "nombreVisites",
            "type": "number"
          },
          {
            "name": "montantTotal",
            "type": "decimal"
          },
          {
            "name": "intervalleMoyenJours",
            "type": "number"
          },
          {
            "name": "derniereVisite",
            "type": "date"
          }
        ],
        "allowedImports": []
      },
