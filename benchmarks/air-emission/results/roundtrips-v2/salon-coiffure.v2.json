    "rules": [
      {
        "id": "rule_prestation_duree_valide",
        "description": "La durée d'une prestation doit être comprise entre 10 et 240 minutes et son prix ne peut pas être négatif.",
        "kind": "validation",
        "entityId": "ent_prestation",
        "assertions": [
          {
            "fieldId": "fld_prestation_duree_minutes",
            "operator": "gte",
            "value": 10
          },
          {
            "fieldId": "fld_prestation_duree_minutes",
            "operator": "lte",
            "value": 240
          },
          {
            "fieldId": "fld_prestation_prix",
            "operator": "gte",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_prestation_reservable",
        "description": "Seules les prestations actives et rattachées à une catégorie connue peuvent être réservées.",
        "kind": "validation",
        "entityId": "ent_prestation",
        "assertions": [
          {
            "fieldId": "fld_prestation_active",
            "operator": "eq",
            "value": true
          },
          {
            "fieldId": "fld_prestation_categorie",
            "operator": "in",
            "value": [
              "coupe",
              "couleur",
              "coiffage",
              "soin",
              "barbe"
            ]
          }
        ]
      },
      {
        "id": "rule_creneau_reservable",
        "description": "Un créneau ne peut être proposé que s'il est marqué disponible et possède une date de début et un coiffeur.",
        "kind": "validation",
        "entityId": "ent_creneau",
        "assertions": [
          {
            "fieldId": "fld_creneau_disponible",
            "operator": "eq",
            "value": true
          },
          {
            "fieldId": "fld_creneau_debut",
            "operator": "required"
          },
          {
            "fieldId": "fld_creneau_coiffeur",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_rdv_contact_client",
        "description": "Le nom du client est obligatoire et le téléphone doit être un numéro valide (format international ou national à 10 chiffres).",
        "kind": "validation",
        "entityId": "ent_rendez_vous",
        "assertions": [
          {
            "fieldId": "fld_rdv_client_nom",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_client_telephone",
            "operator": "matches",
            "value": "^(\\+[1-9][0-9]{7,14}|0[1-9][0-9]{8})$"
          },
          {
            "fieldId": "fld_rdv_client_email",
            "operator": "matches",
            "value": "^$|^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$"
          }
        ]
      },
      {
        "id": "rule_rdv_coherence_reservation",
        "description": "Un rendez-vous doit référencer une prestation et un créneau, porter un statut connu et déclarer si le rappel de la veille est actif.",
        "kind": "validation",
        "entityId": "ent_rendez_vous",
        "assertions": [
          {
            "fieldId": "fld_rdv_prestation",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_creneau",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_debut",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_statut",
            "operator": "in",
            "value": [
              "confirme",
              "annule",
              "honore",
              "absent"
            ]
          },
          {
            "fieldId": "fld_rdv_rappel_actif",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_rdv_annulation_client",
        "description": "Seul le propriétaire du rendez-vous (identifié par son téléphone enregistré) peut consulter ou annuler un rendez-vous non encore honoré.",
        "kind": "authorization",
        "entityId": "ent_rendez_vous",
        "assertions": [
          {
            "fieldId": "fld_rdv_client_telephone",
            "operator": "required"
          },
          {
            "fieldId": "fld_rdv_statut",
            "operator": "neq",
            "value": "honore"
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_calcul_creneaux_disponibles",
        "description": "Calcule la liste des créneaux réservables pour une journée donnée en fonction de la durée de la prestation, des horaires d'ouverture du salon et des rendez-vous déjà pris.",
        "inputs": [
          {
            "name": "jour",
            "type": "date"
          },
          {
            "name": "dureePrestationMinutes",
            "type": "number"
          },
          {
            "name": "creneauxBruts",
            "type": "json"
          },
          {
            "name": "rendezVousExistants",
            "type": "json"
          }
        ],
        "outputs": [
          {
            "name": "creneauxDisponibles",
            "type": "json"
          },
          {
            "name": "premierCreneau",
            "type": "datetime"
          }
        ],
        "allowedImports": [
          "date-fns",
          "date-fns-tz"
        ]
      },
      {
        "id": "slot_format_duree_prix",
        "description": "Formate la durée (en minutes) et le prix d'une prestation en libellés lisibles selon la locale fr ou en.",
        "inputs": [
          {
            "name": "dureeMinutes",
            "type": "number"
          },
          {
            "name": "prix",
            "type": "decimal"
          },
          {
            "name": "locale",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "libelleDuree",
            "type": "string"
          },
          {
            "name": "libellePrix",
            "type": "string"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_planification_rappel_veille",
        "description": "Détermine la date/heure d'envoi du rappel la veille du rendez-vous (18h00 heure locale du salon) et compose le titre et le corps localisés de la notification.",
        "inputs": [
          {
            "name": "debutRendezVous",
            "type": "datetime"
          },
          {
            "name": "nomPrestation",
            "type": "string"
          },
          {
            "name": "locale",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "rappelPlanifieLe",
            "type": "datetime"
          },
          {
            "name": "titre",
            "type": "string"
          },
          {
            "name": "corps",
            "type": "string"
          },
          {
            "name": "planifiable",
            "type": "boolean"
          }
        ],
        "allowedImports": [
          "date-fns",
          "date-fns-tz"
        ]
      },
      {
        "id": "slot_generation_reference_rdv",
        "description": "Génère une référence de rendez-vous courte, lisible et non devinable à partir de la date du créneau et d'un aléa local.",
        "inputs": [
          {
            "name": "debutRendezVous",
            "type": "datetime"
          },
          {
            "name": "identifiantPrestation",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "reference",
            "type": "string"
          }
        ],
        "allowedImports": [
          "nanoid"
        ]
      }
    ],
