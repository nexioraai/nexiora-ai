  "rules": [
    {
      "id": "rule_chien_identite",
      "description": "Un chien doit porter un nom, un propriétaire joignable et une taille pour choisir la prestation adaptée.",
      "kind": "validation",
      "entityId": "ent_chien",
      "assertions": [
        {
          "fieldId": "fld_chien_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_chien_proprietaire",
          "operator": "required"
        },
        {
          "fieldId": "fld_chien_telephone",
          "operator": "matches",
          "value": "^[0-9 +().-]{8,20}$"
        },
        {
          "fieldId": "fld_chien_taille",
          "operator": "in",
          "value": [
            "Très petit",
            "Petit",
            "Moyen",
            "Grand",
            "Très grand"
          ]
        }
      ]
    },
    {
      "id": "rule_prestation_tarif",
      "description": "Une prestation affichée au catalogue doit avoir un nom, une catégorie connue, un tarif indicatif positif et une durée d'au moins 15 minutes.",
      "kind": "validation",
      "entityId": "ent_prestation",
      "assertions": [
        {
          "fieldId": "fld_prestation_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_prestation_categorie",
          "operator": "in",
          "value": [
            "Toilettage complet",
            "Bain et brossage",
            "Tonte",
            "Soins",
            "Forfait"
          ]
        },
        {
          "fieldId": "fld_prestation_prix",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_prestation_duree",
          "operator": "gte",
          "value": 15
        }
      ]
    },
    {
      "id": "rule_rdv_valide",
      "description": "Une demande de rendez-vous exige un chien, une prestation, une date et heure, et un règlement sur place au salon.",
      "kind": "validation",
      "entityId": "ent_rendezvous",
      "assertions": [
        {
          "fieldId": "fld_rdv_chien",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_prestation",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_statut",
          "operator": "in",
          "value": [
            "Demandé",
            "Confirmé",
            "Honoré",
            "Annulé"
          ]
        },
        {
          "fieldId": "fld_rdv_reglement",
          "operator": "eq",
          "value": "Sur place au salon"
        }
      ]
    },
    {
      "id": "rule_vaccination_rappel",
      "description": "Un vaccin enregistré doit préciser le chien, le type, la date d'injection et la date de rappel utilisée pour l'alerte.",
      "kind": "validation",
      "entityId": "ent_vaccination",
      "assertions": [
        {
          "fieldId": "fld_vacc_chien",
          "operator": "required"
        },
        {
          "fieldId": "fld_vacc_type",
          "operator": "required"
        },
        {
          "fieldId": "fld_vacc_date_injection",
          "operator": "required"
        },
        {
          "fieldId": "fld_vacc_date_rappel",
          "operator": "required"
        },
        {
          "fieldId": "fld_vacc_statut",
          "operator": "in",
          "value": [
            "À jour",
            "Rappel proche",
            "Expiré"
          ]
        }
      ]
    },
    {
      "id": "rule_visite_reglement",
      "description": "Une visite de l'historique doit indiquer le chien, la date, un montant encaissé positif ou nul et un mode de règlement sur place.",
      "kind": "validation",
      "entityId": "ent_visite",
      "assertions": [
        {
          "fieldId": "fld_visite_chien",
          "operator": "required"
        },
        {
          "fieldId": "fld_visite_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_visite_montant_paye",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_visite_mode_paiement",
          "operator": "in",
          "value": [
            "Espèces sur place",
            "Carte sur place",
            "Chèque sur place"
          ]
        }
      ]
    }
  ],
  "slots": [
    {
      "id": "slot_alertes_vaccination",
      "description": "Calcule, à partir des vaccins enregistrés et de la date du jour, le nombre de rappels de vaccination proches ou dépassés et produit le titre et le message d'alerte affichés en tête de l'écran des rappels.",
      "inputs": [
        {
          "name": "vaccinations",
          "type": "json"
        },
        {
          "name": "dateDuJour",
          "type": "date"
        },
        {
          "name": "fenetreJours",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "titreAlerte",
          "type": "string"
        },
        {
          "name": "messageAlerte",
          "type": "string"
        },
        {
          "name": "rappelsUrgents",
          "type": "number"
        }
      ],
      "allowedImports": []
    },
    {
      "id": "slot_resume_historique",
      "description": "Résume l'historique des visites d'un salon : nombre de passages, montant total réglé sur place et dernière prestation effectuée, pour affichage en tête de l'écran d'historique.",
      "inputs": [
        {
          "name": "visites",
          "type": "json"
        },
        {
          "name": "dateDuJour",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "titreResume",
          "type": "string"
        },
        {
          "name": "sousTitreResume",
          "type": "string"
        }
      ],
      "allowedImports": []
    },
    {
      "id": "slot_estimation_rendezvous",
      "description": "Estime le montant à régler sur place et la durée du rendez-vous en croisant la prestation choisie avec la taille et le type de poil du chien.",
      "inputs": [
        {
          "name": "chiens",
          "type": "json"
        },
        {
          "name": "prestations",
          "type": "json"
        },
        {
          "name": "deviseLibelle",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "titreEstimation",
          "type": "string"
        },
        {
          "name": "detailEstimation",
          "type": "string"
        }
      ],
      "allowedImports": []
    }
  ]
}
