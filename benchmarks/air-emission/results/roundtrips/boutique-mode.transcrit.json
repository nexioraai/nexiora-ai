    "rules": [
      {
        "id": "rule_article_prix_positif",
        "description": "Le prix d'un article doit être strictement positif et exprimé en euros.",
        "kind": "validation",
        "entityId": "ent_article",
        "assertions": [
          {
            "fieldId": "fld_article_prix",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_article_devise",
            "operator": "eq",
            "value": "EUR"
          }
        ]
      },
      {
        "id": "rule_article_stock_valide",
        "description": "Le stock ne peut pas être négatif et un article sans stock ne peut pas être marqué disponible.",
        "kind": "validation",
        "entityId": "ent_article",
        "assertions": [
          {
            "fieldId": "fld_article_stock",
            "operator": "gte",
            "value": 0
          },
          {
            "fieldId": "fld_article_disponible",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_article_code_barres_format",
        "description": "Le code-barres scanné en magasin doit respecter le format EAN-8 ou EAN-13 (8 à 13 chiffres).",
        "kind": "validation",
        "entityId": "ent_article",
        "assertions": [
          {
            "fieldId": "fld_article_code_barres",
            "operator": "matches",
            "value": "^[0-9]{8,13}$"
          },
          {
            "fieldId": "fld_article_code_barres",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_coherence",
        "description": "Une commande doit avoir un statut connu, un total non négatif, un email client valide et une adresse de livraison.",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_statut",
            "operator": "in",
            "value": [
              "panier",
              "en_attente_paiement",
              "payee",
              "en_preparation",
              "expediee",
              "livree",
              "annulee",
              "remboursee"
            ]
          },
          {
            "fieldId": "fld_commande_total",
            "operator": "gte",
            "value": 0
          },
          {
            "fieldId": "fld_commande_email",
            "operator": "matches",
            "value": "^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$"
          },
          {
            "fieldId": "fld_commande_adresse_livraison",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_expediee_suivi",
        "description": "Une commande expédiée doit porter un numéro de suivi transporteur pour permettre le suivi dans l'app.",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_statut",
            "operator": "eq",
            "value": "expediee"
          },
          {
            "fieldId": "fld_commande_suivi",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_acces_proprietaire",
        "description": "Un client ne peut consulter et suivre que les commandes rattachées à son propre compte (email authentifié).",
        "kind": "authorization",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_email",
            "operator": "eq",
            "value": "$currentUser.email"
          }
        ]
      },
      {
        "id": "rule_catalogue_lecture_publique",
        "description": "Seuls les articles actifs et disponibles sont exposés dans le catalogue public de l'app.",
        "kind": "authorization",
        "entityId": "ent_article",
        "assertions": [
          {
            "fieldId": "fld_article_disponible",
            "operator": "eq",
            "value": true
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_recherche_par_code_barres",
        "description": "Résout un code-barres scanné en magasin vers la référence de l'article correspondant du catalogue.",
        "inputs": [
          {
