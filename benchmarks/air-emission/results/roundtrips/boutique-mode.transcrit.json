    "expectedTests": [
      {
        "id": "test_prix_positif_refuse_zero",
        "description": "La validation de l'entité article rejette un prix nul ou négatif et n'accepte que la devise EUR.",
        "kind": "deterministic",
        "targetId": "ent_article"
      },
      {
        "id": "test_stock_negatif_refuse",
        "description": "Un article avec un stock négatif est rejeté et un article à stock nul ne peut pas être marqué disponible.",
        "kind": "deterministic",
        "targetId": "ent_article"
      },
      {
        "id": "test_code_barres_format_ean",
        "description": "Le format du code-barres de l'article accepte 8 à 13 chiffres et rejette lettres, espaces et longueurs invalides.",
        "kind": "deterministic",
        "targetId": "ent_article"
      },
      {
        "id": "test_slot_resolution_code_barres",
        "description": "L'action de résolution du code-barres retourne la référence attendue pour un code connu et signale trouve=false avec message d'erreur pour un code inconnu.",
        "kind": "deterministic",
        "targetId": "act_resoudre_code_barres"
      },
      {
        "id": "test_slot_total_panier",
        "description": "Le recalcul du panier produit sous-total, remise, frais de livraison et total TTC cohérents, y compris sans code promo.",
        "kind": "deterministic",
        "targetId": "act_calculer_total_panier"
      },
      {
        "id": "test_slot_libelle_statut",
        "description": "Chaque statut de commande produit le libellé français attendu et une progression croissante entre 0 et 1.",
        "kind": "deterministic",
        "targetId": "act_afficher_libelle_statut"
      },
      {
        "id": "test_slot_tailles_commandables",
        "description": "Le calcul des tailles ne retourne que les tailles commandables et signale la rupture totale quand le stock est à zéro.",
        "kind": "deterministic",
        "targetId": "act_calculer_tailles"
      },
      {
        "id": "test_commande_expediee_exige_suivi",
        "description": "Une commande passée au statut expédiée sans numéro de suivi est rejetée par la validation de l'entité commande.",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_acces_commandes_proprietaire",
        "description": "Un client authentifié ne peut lire que les commandes rattachées à son propre email.",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_catalogue_articles_disponibles",
        "description": "Le catalogue public n'expose que les articles marqués disponibles.",
        "kind": "deterministic",
        "targetId": "ent_article"
      },
      {
        "id": "test_contrat_paiement_psp",
        "description": "Contrat du PSP via l'action de paiement : création d'intention en EUR par carte avec 3DS, puis réception du webhook de confirmation.",
        "kind": "contract",
        "targetId": "act_payer_par_carte"
      },
      {
        "id": "test_contrat_api_catalogue",
        "description": "Contrat REST du backend lors de la synchronisation : listes des catégories et articles conformes aux entités et limitées au domaine autorisé.",
        "kind": "contract",
        "targetId": "act_synchroniser_catalogue"
      },
      {
        "id": "test_contrat_push_jetons",
        "description": "Contrat du fournisseur push : enregistrement du jeton et abonnement au topic suivi_commande à la création d'une commande.",
        "kind": "contract",
        "targetId": "act_abonner_suivi_commande"
      },
      {
        "id": "test_e2e_parcours_achat",
        "description": "Parcours complet : catalogue, ouverture d'une fiche article, choix d'une taille, ajout au panier, saisie livraison, paiement par carte puis affichage de la commande dans le suivi.",
        "kind": "e2e",
        "targetId": "scr_panier"
      },
      {
        "id": "test_e2e_scan_magasin",
        "description": "Depuis le catalogue, le scan d'un code-barres EAN-13 ouvre la fiche de l'article correspondant.",
        "kind": "e2e",
        "targetId": "scr_catalogue"
      },
      {
        "id": "test_e2e_suivi_commande",
        "description": "L'écran Mes commandes affiche la progression du statut et les informations transporteur, et l'actualisation met à jour l'état.",
        "kind": "e2e",
        "targetId": "scr_commandes"
      },
      {
        "id": "test_e2e_catalogue_hors_ligne",
        "description": "Sans réseau, le catalogue mis en cache reste consultable et la fiche article s'ouvre avec les données locales.",
        "kind": "e2e",
        "targetId": "scr_article"
      }
    ]
  }
