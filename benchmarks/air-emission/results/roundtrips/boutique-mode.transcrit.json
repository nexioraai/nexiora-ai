            }
          ]
        }
      },
      {
        "id": "act_resoudre_code_barres",
        "name": "Résoudre le code-barres scanné vers un article",
        "trigger": {
          "kind": "lifecycle",
          "event": "screen_open",
          "screenId": "scr_article"
        },
        "effect": {
          "kind": "slot",
          "slotId": "slot_recherche_par_code_barres"
        }
      },
      {
