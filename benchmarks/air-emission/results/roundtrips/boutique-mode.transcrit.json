          },
          {
            "name": "totalTtc",
            "type": "decimal"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_libelle_statut_commande",
        "description": "Produit le libellé français et la progression (0 à 1) affichés dans le suivi de l'état d'une commande.",
        "inputs": [
          {
            "name": "statut",
            "type": "enum"
