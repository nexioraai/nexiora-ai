        "id": "act_synchroniser_catalogue",
        "name": "Synchroniser le catalogue hors-ligne",
        "trigger": {
          "kind": "lifecycle",
          "event": "screen_open",
          "screenId": "scr_catalogue"
        },
        "effect": {
          "kind": "capability",
          "capability": "offline_storage",
          "method": "syncCollection",
          "params": [
            {
