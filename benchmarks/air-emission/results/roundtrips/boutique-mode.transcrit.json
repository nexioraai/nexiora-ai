      {
        "id": "act_ouvrir_scanner",
        "name": "Ouvrir le scanner de code-barres en magasin",
        "trigger": {
          "kind": "ui",
          "blockId": "blk_catalogue_scan_bouton"
        },
        "effect": {
          "kind": "capability",
          "capability": "barcode_scan",
          "method": "scanCode",
          "params": [
            {
              "key": "formats",
              "value": [
                "ean_8",
                "ean_13"
              ]
            },
            {
              "key": "torchAutorisee",
