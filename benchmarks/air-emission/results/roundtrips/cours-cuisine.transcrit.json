          },
          {
            "name": "dateAchat",
            "type": "datetime"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_format_prix_localise",
        "description": "Formate le prix d'un cours selon la locale active (fr/en) et la devise du store.",
        "inputs": [
          {
            "name": "montant",
            "type": "decimal"
          },
          {
            "name": "locale",
            "type": "string"
          },
          {
            "name": "devise",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "prixFormate",
            "type": "string"
          }
        ],
        "allowedImports": [
          "intl"
        ]
      },
      {
        "id": "slot_reprise_progression",
        "description": "Calcule la position de reprise de lecture à partir de la progression enregistrée et de la durée du cours.",
        "inputs": [
          {
            "name": "progression",
            "type": "number"
          },
          {
            "name": "dureeMinutes",
            "type": "number"
          }
        ],
        "outputs": [
          {
            "name": "positionSecondes",
            "type": "number"
          },
          {
            "name": "termine",
            "type": "boolean"
          }
        ],
        "allowedImports": []
      }
    ],
