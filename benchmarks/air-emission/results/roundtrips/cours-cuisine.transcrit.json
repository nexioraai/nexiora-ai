    "expectedTests": [
      {
        "id": "test_rule_cours_valide",
        "description": "Règle rule_cours_valide : un cours publié sans identifiant produit IAP, sans URL vidéo, avec un prix nul ou une durée nulle est rejeté.",
        "kind": "deterministic",
        "targetId": "ent_cours"
      },
      {
        "id": "test_rule_achat_valide",
        "description": "Règle rule_achat_valide : un achat sans cours, sans utilisateur, sans transaction unique ou avec un statut inconnu est rejeté.",
        "kind": "deterministic",
        "targetId": "ent_achat"
      },
      {
        "id": "test_rule_lecture_reservee",
        "description": "Règle rule_lecture_reservee_acheteur : la lecture est refusée si l'achat n'est pas au statut validé ou appartient à un autre utilisateur.",
        "kind": "deterministic",
        "targetId": "act_verifier_droit_lecture"
      },
      {
        "id": "test_rule_recette_libre",
        "description": "Règle rule_recette_libre : une recette non publiée ou dépourvue de contenu en français ou en anglais n'est pas exposée en accès libre.",
        "kind": "deterministic",
        "targetId": "ent_recette"
      },
      {
        "id": "test_rule_catalogue_public",
        "description": "Règle rule_catalogue_lecture_publique : le catalogue n'expose que les cours dont le champ publie vaut true, y compris pour un visiteur non authentifié.",
        "kind": "deterministic",
        "targetId": "scr_catalogue"
      },
      {
        "id": "test_slot_droit_lecture",
        "description": "Slot slot_verification_droit_lecture : renvoie autorise=false sans URL pour un utilisateur sans achat validé, et une URL signée expirante sinon.",
        "kind": "deterministic",
        "targetId": "act_verifier_droit_lecture"
      },
      {
        "id": "test_slot_recu_iap",
        "description": "Slot slot_validation_recu_iap : normalise les statuts valide, rembourse et en_attente et retourne un identifiant de transaction stable.",
        "kind": "deterministic",
        "targetId": "act_valider_recu_achat"
      },
      {
        "id": "test_slot_prix_localise",
        "description": "Slot slot_format_prix_localise : le formatage du prix respecte les conventions fr et en et la devise fournie par le store.",
        "kind": "deterministic",
        "targetId": "scr_cours_detail"
      },
      {
        "id": "test_slot_reprise_progression",
        "description": "Slot slot_reprise_progression : la position de reprise est bornée à la durée du cours et termine=true au-delà du seuil de complétion.",
        "kind": "deterministic",
        "targetId": "act_reprendre_lecture"
      },
      {
        "id": "test_contract_iap_verify",
        "description": "Contrat de vérification de reçu IAP : la requête vers l'endpoint renvoie un statut et une transaction exploitables, et échoue proprement en cas de reçu invalide.",
        "kind": "contract",
        "targetId": "act_acheter_cours"
      },
      {
        "id": "test_contract_media_signature",
        "description": "Contrat de signature média : l'endpoint retourne une URL HLS signée avec une expiration inférieure ou égale au TTL configuré.",
        "kind": "contract",
        "targetId": "scr_lecteur_video"
      },
      {
        "id": "test_contract_backend_network",
        "description": "Contrat réseau : seuls les appels vers api.chefstudio.app aboutissent, tout autre domaine est bloqué par la politique deny_by_default.",
        "kind": "contract",
        "targetId": "act_demarrage_session"
      },
      {
        "id": "test_contract_deep_links",
        "description": "Contrat de liens profonds : /cours/:id et /recettes/:id ouvrent les bons écrans, un chemin inconnu retombe sur le catalogue.",
        "kind": "contract",
        "targetId": "act_traiter_lien_profond"
      },
      {
        "id": "test_e2e_achat_puis_lecture",
        "description": "Parcours complet : depuis le catalogue, ouvrir un cours, effectuer l'achat intégré, voir le reçu validé puis lire la vidéo débloquée.",
        "kind": "e2e",
        "targetId": "act_acheter_cours"
      },
      {
        "id": "test_e2e_restauration_achats",
        "description": "Après réinstallation, la restauration des achats depuis le détail du cours redonne accès aux cours déjà payés sans nouveau paiement.",
        "kind": "e2e",
        "targetId": "scr_cours_detail"
      },
      {
        "id": "test_e2e_lecture_non_achetee",
        "description": "L'ouverture du lecteur pour un cours non acheté affiche le garde d'accès et renvoie vers le détail du cours.",
        "kind": "e2e",
        "targetId": "scr_lecteur_video"
      },
      {
        "id": "test_e2e_recettes_acces_libre",
        "description": "Les recettes publiées sont consultables, recherchables et filtrables sans authentification ni achat.",
