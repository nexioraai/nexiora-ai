    "rules": [
      {
        "id": "rule_cours_valide",
        "description": "Un cours publié doit avoir un identifiant produit IAP, une vidéo, un prix positif et une durée non nulle.",
        "kind": "validation",
        "entityId": "ent_cours",
        "assertions": [
          {
            "fieldId": "fld_cours_iap_product_id",
            "operator": "required"
          },
          {
            "fieldId": "fld_cours_video_url",
            "operator": "required"
          },
          {
            "fieldId": "fld_cours_prix_affiche",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_cours_duree_minutes",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_cours_titre_fr",
            "operator": "required"
          },
          {
            "fieldId": "fld_cours_titre_en",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_achat_valide",
        "description": "Un achat doit référencer un cours, un utilisateur, un identifiant de transaction unique et un statut connu.",
        "kind": "validation",
        "entityId": "ent_achat",
        "assertions": [
          {
            "fieldId": "fld_achat_cours",
            "operator": "required"
          },
          {
            "fieldId": "fld_achat_utilisateur_id",
            "operator": "required"
          },
          {
            "fieldId": "fld_achat_transaction_id",
            "operator": "required"
          },
          {
            "fieldId": "fld_achat_statut",
            "operator": "in",
            "value": [
              "en_attente",
              "valide",
              "rembourse",
              "expire"
            ]
          },
          {
            "fieldId": "fld_achat_progression",
            "operator": "gte",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_lecture_reservee_acheteur",
        "description": "La lecture d'une vidéo n'est autorisée que pour l'utilisateur propriétaire d'un achat au statut validé.",
        "kind": "authorization",
        "entityId": "ent_achat",
        "assertions": [
          {
            "fieldId": "fld_achat_statut",
            "operator": "eq",
            "value": "valide"
          },
          {
            "fieldId": "fld_achat_utilisateur_id",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_recette_libre",
        "description": "Les recettes en accès libre doivent être publiées et disposer d'un contenu dans les deux langues.",
        "kind": "validation",
        "entityId": "ent_recette",
        "assertions": [
          {
            "fieldId": "fld_recette_publie",
            "operator": "eq",
            "value": true
          },
          {
            "fieldId": "fld_recette_contenu_fr",
            "operator": "required"
          },
          {
            "fieldId": "fld_recette_contenu_en",
            "operator": "required"
          },
          {
            "fieldId": "fld_recette_temps_minutes",
            "operator": "gt",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_catalogue_lecture_publique",
        "description": "Le catalogue n'expose que les cours publiés aux visiteurs non authentifiés.",
        "kind": "authorization",
        "entityId": "ent_cours",
        "assertions": [
          {
            "fieldId": "fld_cours_publie",
            "operator": "eq",
            "value": true
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_verification_droit_lecture",
        "description": "Détermine si l'utilisateur courant possède un achat validé pour le cours demandé et renvoie une URL de lecture signée à durée limitée.",
        "inputs": [
          {
            "name": "coursId",
            "type": "reference"
          },
          {
            "name": "utilisateurId",
            "type": "string"
          }
        ],
        "outputs": [
