    "rules": [
      {
        "id": "rule_plat_prix_positif",
        "description": "Le prix d'un plat doit être strictement supérieur à 0 FCFA et sa disponibilité doit être renseignée.",
        "kind": "validation",
        "entityId": "ent_plat",
        "assertions": [
          {
            "fieldId": "fld_plat_prix_xof",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_plat_nom",
            "operator": "required"
          },
          {
            "fieldId": "fld_plat_disponible",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_client_valide",
        "description": "Une commande doit porter un nom de client et un numéro de téléphone ivoirien valide (format international ou local).",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_cmd_client_nom",
            "operator": "required"
          },
          {
            "fieldId": "fld_cmd_client_telephone",
            "operator": "matches",
            "value": "^(\\+225)?[0-9]{8,10}$"
          },
          {
            "fieldId": "fld_cmd_total_xof",
            "operator": "gt",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_ligne_quantite_bornee",
        "description": "Chaque ligne de commande doit comporter entre 1 et 20 unités du même plat.",
        "kind": "validation",
        "entityId": "ent_ligne_commande",
        "assertions": [
          {
            "fieldId": "fld_lig_quantite",
            "operator": "gte",
            "value": 1
          },
          {
            "fieldId": "fld_lig_quantite",
            "operator": "lte",
            "value": 20
          },
          {
            "fieldId": "fld_lig_prix_unitaire_xof",
            "operator": "gt",
            "value": 0
          }
        ]
      },
      {
        "id": "rule_commande_preparation_apres_paiement",
        "description": "Une commande ne peut entrer en préparation ou être déclarée prête que si le paiement par carte est encaissé.",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_cmd_statut_paiement",
            "operator": "eq",
            "value": "paye"
          },
          {
            "fieldId": "fld_cmd_statut",
            "operator": "in",
            "value": [
              "en_preparation",
              "prete",
              "retiree"
            ]
          }
        ]
      },
      {
        "id": "rule_auth_suivi_commande_proprietaire",
        "description": "Seul le client authentifié propriétaire de la commande peut consulter son suivi ; les commandes annulées ne sont pas accessibles.",
        "kind": "authorization",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_cmd_client_telephone",
            "operator": "required"
          },
          {
            "fieldId": "fld_cmd_statut",
            "operator": "neq",
            "value": "annulee"
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_calcul_total_panier",
        "description": "Calcule le sous-total de chaque ligne et le total de la commande en FCFA à partir des articles du panier (quantités et prix unitaires), sans arrondi décimal car le franc CFA n'a pas de subdivision.",
        "inputs": [
          {
            "name": "lignesPanier",
            "type": "json"
          },
          {
            "name": "codeDevise",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "totalXof",
            "type": "decimal"
          },
          {
            "name": "lignesCalculees",
            "type": "json"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_format_prix_fcfa",
        "description": "Formate un montant numérique en libellé de prix lisible en français ivoirien, par exemple « 2 500 FCFA ».",
        "inputs": [
          {
            "name": "montant",
            "type": "decimal"
          }
        ],
        "outputs": [
          {
            "name": "prixFormate",
            "type": "string"
          }
        ],
        "allowedImports": [
          "intl"
        ]
      },
      {
        "id": "slot_libelle_statut_commande",
        "description": "Traduit le statut technique d'une commande en libellé et message français affichés sur l'écran de suivi et dans la notification push « commande prête ».",
        "inputs": [
          {
            "name": "statut",
            "type": "enum"
          },
          {
            "name": "numeroCommande",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "libelle",
            "type": "string"
          },
          {
            "name": "messageNotification",
            "type": "text"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_estimation_temps_retrait",
        "description": "Estime l'heure de retrait à emporter à partir des délais de préparation des plats commandés et de l'horodatage de paiement.",
        "inputs": [
          {
            "name": "lignesPanier",
            "type": "json"
          },
          {
            "name": "paiementLe",
            "type": "datetime"
          }
        ],
        "outputs": [
          {
            "name": "heureRetraitEstimee",
            "type": "datetime"
          },
          {
            "name": "delaiMinutes",
            "type": "number"
          }
        ],
        "allowedImports": []
      }
    ],
