    "expectedTests": [
      {
        "id": "test_slot_total_panier_xof",
        "description": "Le recalcul du panier retourne des sous-totaux quantité × prix unitaire et un total en FCFA sans décimale (ex. 2 plats à 2 500 + 1 boisson à 1 000 = 6 000).",
        "kind": "deterministic",
        "targetId": "act_recalculer_total_panier"
      },
      {
        "id": "test_slot_format_prix_fcfa",
        "description": "Les prix du menu s'affichent « 2 500 FCFA » pour 2500 et « 0 FCFA » pour 0, avec séparateur de milliers français et aucune décimale.",
        "kind": "deterministic",
        "targetId": "scr_menu"
      },
      {
        "id": "test_slot_libelle_statut",
        "description": "Chaque statut de commande produit le libellé français attendu et le message de notification contenant le numéro de commande pour le statut « prete ».",
        "kind": "deterministic",
        "targetId": "act_libeller_statut_commande"
      },
      {
        "id": "test_slot_estimation_retrait",
        "description": "L'heure de retrait estimée vaut l'horodatage de paiement plus le délai de préparation maximal des plats commandés, en minutes entières.",
        "kind": "deterministic",
        "targetId": "act_estimer_heure_retrait"
      },
      {
        "id": "test_rule_plat_prix_positif",
        "description": "Un plat sans nom ou avec un prix inférieur ou égal à 0 FCFA est rejeté par la validation du catalogue.",
        "kind": "deterministic",
        "targetId": "ent_plat"
      },
      {
        "id": "test_rule_telephone_ivoirien",
        "description": "La validation de commande accepte « +2250700000000 » et « 07000000 » et rejette « 0700 » ou un numéro contenant des lettres.",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_rule_quantite_bornee",
        "description": "Une ligne de commande avec quantité 0 ou 21 est refusée, une quantité entre 1 et 20 est acceptée.",
        "kind": "deterministic",
        "targetId": "ent_ligne_commande"
      },
      {
        "id": "test_rule_preparation_apres_paiement",
        "description": "Une commande dont le paiement n'est pas encaissé ne peut pas passer aux statuts en_preparation, prete ou retiree.",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_rule_auth_suivi_proprietaire",
        "description": "Un client authentifié n'accède qu'au suivi de ses propres commandes ; les commandes annulées renvoient un refus d'accès.",
        "kind": "deterministic",
        "targetId": "scr_suivi_commande"
      },
      {
        "id": "test_action_ajout_panier",
        "description": "Appuyer sur « Ajouter au panier » crée une ligne de commande avec le plat, la quantité choisie et les instructions saisies.",
        "kind": "deterministic",
        "targetId": "act_ajouter_au_panier"
      },
      {
        "id": "test_action_bouton_desactive_plat_epuise",
        "description": "Sur un plat marqué indisponible, le bouton d'ajout au panier de l'écran de détail est désactivé et affiche « Plat momentanément épuisé ».",
        "kind": "deterministic",
        "targetId": "scr_plat_detail"
      },
      {
        "id": "test_contract_psp_checkout",
        "description": "La création de paiement envoie devise XOF, montant total, référence de commande, capture automatique et retourne un statut de paiement exploitable.",
        "kind": "contract",
        "targetId": "act_payer_commande"
      },
      {
        "id": "test_contract_push_envoi",
        "description": "L'envoi push accepte le topic commande_statut, un titre et un corps en français et retourne un identifiant de message.",
        "kind": "contract",
        "targetId": "act_notifier_commande_prete"
      },
      {
        "id": "test_contract_api_menu",
        "description": "Le backend expose la liste des plats disponibles avec nom, prix, catégorie et photo, et tout appel vers un domaine hors api.maquis-express.app est refusé.",
        "kind": "contract",
        "targetId": "ent_plat"
      },
      {
        "id": "test_contract_auth_otp",
        "description": "L'authentification envoie un code OTP à 6 chiffres vers un numéro +225 et ouvre une session valide 30 jours avant l'accès au suivi.",
        "kind": "contract",
        "targetId": "act_authentifier_client_suivi"
      },
      {
        "id": "test_e2e_commande_paiement_notification",
        "description": "Parcours complet : consultation du menu, ajout de deux plats, saisie des coordonnées, paiement par carte réussi, arrivée sur le suivi et réception de la notification « Votre commande est prête ! ».",
        "kind": "e2e",
        "targetId": "scr_panier"
      },
      {
        "id": "test_e2e_notification_unique",
        "description": "Le passage au statut « prete » n'envoie qu'une seule notification grâce au drapeau notifiee_prete, même après plusieurs mises à jour de la commande.",
        "kind": "e2e",
        "targetId": "act_notifier_commande_prete"
      },
      {
        "id": "test_e2e_menu_hors_ligne",
        "description": "Après un premier lancement en ligne, le menu et ses photos restent consultables sans réseau et le paiement affiche un message d'indisponibilité.",
        "kind": "e2e",
        "targetId": "scr_menu"
      },
      {
        "id": "test_e2e_annulation_avant_preparation",
        "description": "L'annulation aboutit tant que la commande est au statut payee et est refusée dès le passage en préparation.",
        "kind": "e2e",
        "targetId": "act_annuler_commande"
      }
    ]
