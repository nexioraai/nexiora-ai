    "expectedTests": [
      {
        "id": "test_regle_prix_stock_panier",
        "description": "Vérifie que la validation du panier (rule_panier_prix_positif) rejette un prix nul ou négatif, un stock négatif ou un nom manquant.",
        "kind": "deterministic",
        "targetId": "ent_panier"
      },
      {
        "id": "test_regle_taille_panier",
        "description": "Vérifie que seule une taille parmi petit, moyen et familial est acceptée pour un panier (rule_panier_taille_valide).",
        "kind": "deterministic",
        "targetId": "ent_panier"
      },
      {
        "id": "test_regle_code_postal_adresse",
        "description": "Vérifie que l'adresse de livraison refuse un code postal non composé de 5 chiffres et exige rue et ville (rule_adresse_code_postal).",
        "kind": "deterministic",
        "targetId": "ent_adresse_livraison"
      },
      {
        "id": "test_regle_quantite_montant_commande",
        "description": "Vérifie que la quantité commandée reste entre 1 et 5, que le montant total est strictement positif et que l'adresse est obligatoire (rule_commande_quantite_montant).",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_regle_commande_modifiable",
        "description": "Vérifie qu'une commande en livraison ou livrée n'est plus modifiable ni annulable par le client (rule_commande_modifiable).",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_regle_paiement_avant_preparation",
        "description": "Vérifie qu'une commande sans paiement autorisé ou capturé, ou sans créneau, ne peut pas passer en préparation (rule_commande_paiement_avant_preparation).",
        "kind": "deterministic",
        "targetId": "ent_commande"
      },
      {
        "id": "test_slot_calcul_montant",
        "description": "Vérifie via l'action de calcul le montant total (prix unitaire × quantité + frais) et le passage à livraison offerte au-delà du seuil.",
        "kind": "deterministic",
        "targetId": "act_calculer_montant"
      },
      {
        "id": "test_slot_zone_livraison",
        "description": "Vérifie que la vérification de zone renvoie zoneDesservie=false et un message en français pour un code postal hors zone.",
        "kind": "deterministic",
        "targetId": "act_verifier_zone_livraison"
      },
      {
        "id": "test_slot_format_creneau",
        "description": "Vérifie que le créneau de livraison est formaté en libellé français lisible et stable selon la locale fr.",
        "kind": "deterministic",
        "targetId": "act_formater_creneau"
      },
      {
        "id": "test_contrat_api_paniers",
        "description": "Vérifie le contrat de l'API backend lors de la synchronisation des paniers de la semaine : schéma des champs, domaine autorisé et gestion des erreurs.",
        "kind": "contract",
        "targetId": "act_synchroniser_paniers"
      },
      {
        "id": "test_contrat_paiement_carte",
        "description": "Vérifie le contrat du PSP : création d'intention de paiement en EUR, retour des statuts autorise/capture/echoue et absence de données de carte stockées.",
        "kind": "contract",
        "targetId": "act_payer_commande"
      },
      {
        "id": "test_contrat_push_livraison",
