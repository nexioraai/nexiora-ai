    "rules": [
      {
        "id": "rule_panier_prix_positif",
        "description": "Le prix d'un panier doit être strictement supérieur à 0 et le stock ne peut pas être négatif.",
        "kind": "validation",
        "entityId": "ent_panier",
        "assertions": [
          {
            "fieldId": "fld_panier_prix",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_panier_stock",
            "operator": "gte",
            "value": 0
          },
          {
            "fieldId": "fld_panier_nom",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_panier_taille_valide",
        "description": "La taille du panier doit appartenir aux tailles proposées.",
        "kind": "validation",
        "entityId": "ent_panier",
        "assertions": [
          {
            "fieldId": "fld_panier_taille",
            "operator": "in",
            "value": [
              "petit",
              "moyen",
              "familial"
            ]
          }
        ]
      },
      {
        "id": "rule_adresse_code_postal",
        "description": "Le code postal doit être composé de 5 chiffres et la ville est obligatoire.",
        "kind": "validation",
        "entityId": "ent_adresse_livraison",
        "assertions": [
          {
            "fieldId": "fld_adresse_code_postal",
            "operator": "matches",
            "value": "^[0-9]{5}$"
          },
          {
            "fieldId": "fld_adresse_ville",
            "operator": "required"
          },
          {
            "fieldId": "fld_adresse_rue",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_quantite_montant",
        "description": "Une commande porte sur au moins un panier, au maximum cinq, avec un montant total positif et une adresse de livraison.",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_quantite",
            "operator": "gte",
            "value": 1
          },
          {
            "fieldId": "fld_commande_quantite",
            "operator": "lte",
            "value": 5
          },
          {
            "fieldId": "fld_commande_montant_total",
            "operator": "gt",
            "value": 0
          },
          {
            "fieldId": "fld_commande_adresse",
            "operator": "required"
          }
        ]
      },
      {
        "id": "rule_commande_modifiable",
        "description": "Une commande ne peut être modifiée ou annulée par le client que tant qu'elle n'est pas en livraison ou livrée.",
        "kind": "authorization",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_statut",
            "operator": "in",
            "value": [
              "en_attente",
              "payee"
            ]
          }
        ]
      },
      {
        "id": "rule_commande_paiement_avant_preparation",
        "description": "Le passage en préparation exige un paiement capturé.",
        "kind": "validation",
        "entityId": "ent_commande",
        "assertions": [
          {
            "fieldId": "fld_commande_statut_paiement",
            "operator": "in",
            "value": [
              "autorise",
              "capture"
            ]
          },
          {
            "fieldId": "fld_commande_creneau_livraison",
            "operator": "required"
          }
        ]
      }
    ],
    "slots": [
      {
        "id": "slot_calcul_montant_commande",
        "description": "Calcule le montant total d'une commande à partir du prix unitaire du panier, de la quantité et des frais de livraison (livraison offerte au-delà d'un seuil).",
        "inputs": [
          {
            "name": "prixUnitaire",
            "type": "decimal"
          },
          {
            "name": "quantite",
            "type": "number"
          },
          {
            "name": "fraisLivraison",
            "type": "decimal"
          }
        ],
        "outputs": [
          {
            "name": "montantTotal",
            "type": "decimal"
          },
          {
            "name": "livraisonOfferte",
            "type": "boolean"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_verification_zone_livraison",
        "description": "Vérifie que la position ou le code postal saisi appartient à une zone de livraison desservie et renvoie un message explicatif en français.",
        "inputs": [
          {
            "name": "latitude",
            "type": "decimal"
          },
          {
            "name": "longitude",
            "type": "decimal"
          },
          {
            "name": "codePostal",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "zoneDesservie",
            "type": "boolean"
          },
          {
            "name": "message",
            "type": "string"
          }
        ],
        "allowedImports": []
      },
      {
        "id": "slot_format_creneau_livraison",
        "description": "Formate un créneau de livraison en libellé lisible en français (ex. « jeudi 12 juin, 17h-19h »).",
        "inputs": [
          {
            "name": "creneau",
            "type": "datetime"
          }
        ],
        "outputs": [
          {
            "name": "libelle",
            "type": "string"
          }
        ],
        "allowedImports": [
          "intl"
        ]
      }
    ],
