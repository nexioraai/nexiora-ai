  "expectedTests": [
    {
      "description": "Vérifie qu'un animal sans nom, sans taille valide ou avec un téléphone propriétaire mal formé est rejeté par la validation de l'entité animal.",
      "id": "test_rule_animal_identite",
      "kind": "deterministic",
      "targetId": "ent_animal"
    },
    {
      "description": "Vérifie qu'une fiche animal déclarée vaccination à jour exige une date de rappel renseignée.",
      "id": "test_rule_vaccination_rappel",
      "kind": "deterministic",
      "targetId": "ent_animal"
    },
    {
      "description": "Vérifie qu'un rendez-vous de moins de 30 minutes ou de plus de 240 minutes, ou sans date de début, est refusé.",
      "id": "test_rule_creneau_valide",
      "kind": "deterministic",
      "targetId": "ent_rendez_vous"
    },
    {
      "description": "Vérifie qu'une visite n'accepte que les modes de paiement sur place (espèces, carte sur place, chèque) et un montant non négatif.",
      "id": "test_rule_paiement_sur_place",
      "kind": "deterministic",
      "targetId": "ent_visite"
    },
    {
      "description": "Vérifie qu'un utilisateur non propriétaire ou une fiche animal inactive ne donne pas accès à la fiche.",
      "id": "test_rule_acces_fiche",
      "kind": "deterministic",
      "targetId": "ent_animal"
    },
    {
      "description": "Vérifie que l'historique d'une visite n'est lisible que pour les animaux rattachés à l'utilisateur connecté.",
      "id": "test_rule_acces_historique",
      "kind": "deterministic",
      "targetId": "ent_visite"
    },
    {
      "description": "Vérifie que le calcul des créneaux déclenché à l'ouverture de l'accueil exclut les rendez-vous existants et adapte la durée estimée à la prestation et à la taille du chien.",
      "id": "test_slot_creneaux",
      "kind": "deterministic",
      "targetId": "act_calculer_creneaux"
    },
    {
      "description": "Vérifie le calcul du prochain rappel de vaccination, des jours restants et le déclenchement de l'alerte à moins de 14 jours.",
      "id": "test_slot_rappel_vaccin",
      "kind": "deterministic",
      "targetId": "act_accueil_alertes_vaccin"
    },
    {
      "description": "Vérifie l'agrégation de l'historique après création d'une visite : nombre de visites, montant total et intervalle moyen entre deux toilettages.",
      "id": "test_slot_resume_historique",
      "kind": "deterministic",
      "targetId": "act_resume_historique"
    },
    {
      "description": "Vérifie que le tarif indicatif calculé à la création du rendez-vous varie selon la taille, le type de poil et le démêlage requis, et reste positif.",
      "id": "test_slot_tarif_estime",
      "kind": "deterministic",
      "targetId": "act_estimer_tarif"
    },
    {
      "description": "Parcours : ouverture de l'accueil, affichage de l'alerte de rappel de vaccination puis navigation vers la fiche animal.",
      "id": "test_e2e_accueil_alerte",
      "kind": "e2e",
      "targetId": "scr_accueil"
    },
    {
      "description": "Parcours : depuis la carte du prochain rendez-vous, affichage des créneaux disponibles, création du rendez-vous et tarif estimé à régler sur place.",
      "id": "test_e2e_prise_rdv",
      "kind": "e2e",
      "targetId": "act_ouvrir_rdv_depuis_carte"
    },
    {
      "description": "Parcours : création d'une fiche animal avec import d'une photo depuis la bibliothèque après consentement à la permission.",
      "id": "test_e2e_photo_animal",
      "kind": "e2e",
      "targetId": "act_importer_photo_animal"
    },
    {
      "description": "Parcours : consultation de l'historique des visites d'un chien avec résumé (nombre de passages, montant total, dernière visite).",
      "id": "test_e2e_historique",
      "kind": "e2e",
      "targetId": "ent_visite"
    },
    {
      "description": "Contrat du fournisseur d'identité au lancement : restauration de session, expiration à 30 jours et disponibilité de l'endpoint de suppression de compte.",
      "id": "test_contract_auth",
      "kind": "contract",
      "targetId": "act_demarrer_session"
    },
    {
      "description": "Contrat de synchronisation hors-ligne : chiffrement local, résolution last_write_wins et rejeu des mutations en file d'attente.",
      "id": "test_contract_sync_offline",
      "kind": "contract",
      "targetId": "act_sync_hors_ligne"
    },
    {
      "description": "Contrat d'import de médias : refus des types non autorisés, limite de 8 Mo et suppression des métadonnées GPS.",
      "id": "test_contract_medias",
      "kind": "contract",
      "targetId": "act_importer_photo_animal"
    },
    {
      "description": "Contrat de notifications : enregistrement de l'appareil, respect des heures calmes et planification du rappel 14 jours avant.",
      "id": "test_contract_push",
      "kind": "contract",
      "targetId": "act_programmer_rappel_vaccin"
    },
    {
      "description": "Contrat calendrier : création d'événement uniquement après confirmation utilisateur, avec titre, durée et alarme corrects.",
      "id": "test_contract_calendrier",
      "kind": "contract",
