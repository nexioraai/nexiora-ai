      {
        "id": "nav_accueil",
        "screenId": "scr_accueil",
        "title": [
          {
            "locale": "fr",
            "text": "Accueil"
          }
        ]
      }
    ]
  },
  "network": {
    "allowedDomains": [
      "api.toilettage-canin.app"
    ],
    "policy": "deny_by_default"
  },
  "permissions": [
    {
      "permission": "NSPhotoLibraryUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr",
          "text": "L'accès à vos photos permet d'ajouter la photo de votre chien à sa fiche de toilettage."
        }
      ],
      "requiredByCapability": "media_upload"
    },
    {
      "permission": "android.permission.READ_MEDIA_IMAGES",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "L'accès à vos images permet de choisir la photo de votre chien pour sa fiche de toilettage."
        }
      ],
      "requiredByCapability": "media_upload"
    },
    {
      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "Les notifications servent à vous rappeler les rendez-vous de toilettage et les rappels de vaccination."
        }
      ],
      "requiredByCapability": "push_notifications"
    },
    {
      "permission": "NSCalendarsFullAccessUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr",
          "text": "L'accès au calendrier permet d'ajouter vos rendez-vous de toilettage à l'agenda de votre appareil."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.READ_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "La lecture du calendrier permet de vérifier vos disponibilités avant de proposer un créneau de toilettage."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.WRITE_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "L'écriture dans le calendrier permet d'enregistrer vos rendez-vous de toilettage dans votre agenda."
        }
      ],
      "requiredByCapability": "calendar"
    }
  ],
  "projectId": "prj_toilettage_canin",
  "relations": [
    {
      "fromEntityId": "ent_animal",
      "id": "rel_animal_rendez_vous",
      "kind": "one_to_many",
      "toEntityId": "ent_rendez_vous"
    },
    {
      "fromEntityId": "ent_animal",
      "id": "rel_animal_visites",
      "kind": "one_to_many",
      "toEntityId": "ent_visite"
    },
    {
      "fromEntityId": "ent_rendez_vous",
      "id": "rel_rendez_vous_visite",
      "kind": "one_to_one",
      "toEntityId": "ent_visite"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_animal_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_taille",
          "operator": "in",
          "value": [
            "petit",
            "moyen",
            "grand",
            "tres_grand"
          ]
        },
        {
          "fieldId": "fld_animal_proprietaire_telephone",
          "operator": "matches",
          "value": "^[+0-9][0-9 .-]{6,19}$"
        }
      ],
      "description": "Un animal doit avoir un nom, une taille et les coordonnées téléphoniques de son propriétaire.",
      "entityId": "ent_animal",
      "id": "rule_animal_identite_complete",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_animal_vaccin_a_jour",
          "operator": "eq",
          "value": true
        },
        {
          "fieldId": "fld_animal_vaccin_rappel",
          "operator": "required"
        }
      ],
      "description": "Si la vaccination est déclarée à jour, la date de rappel doit être renseignée pour permettre l'envoi du rappel.",
      "entityId": "ent_animal",
      "id": "rule_animal_vaccination",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_rdv_debut",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_duree_minutes",
          "operator": "gte",
          "value": 30
        },
        {
          "fieldId": "fld_rdv_duree_minutes",
          "operator": "lte",
          "value": 240
        },
        {
          "fieldId": "fld_rdv_statut",
          "operator": "in",
          "value": [
            "demande",
            "confirme",
            "annule",
            "honore"
          ]
        }
      ],
      "description": "Un rendez-vous dure entre 30 et 240 minutes et possède un statut connu ainsi qu'une date de début.",
      "entityId": "ent_rendez_vous",
      "id": "rule_rdv_creneau_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_visite_montant",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_visite_mode_paiement",
          "operator": "in",
          "value": [
            "especes",
            "carte_sur_place",
            "cheque"
          ]
        },
        {
          "fieldId": "fld_visite_date",
          "operator": "required"
        }
      ],
      "description": "Une visite enregistre un montant positif réglé sur place (aucun paiement en ligne).",
      "entityId": "ent_visite",
      "id": "rule_visite_paiement_sur_place",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_animal_proprietaire_email",
          "operator": "eq",
          "value": "current_user.email"
        },
        {
          "fieldId": "fld_animal_actif",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Seul le propriétaire authentifié rattaché à l'animal peut consulter et modifier sa fiche.",
      "entityId": "ent_animal",
      "id": "rule_acces_fiche_proprietaire",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_visite_animal",
          "operator": "in",
          "value": [
            "current_user.animaux"
          ]
        }
      ],
      "description": "L'historique d'une visite n'est lisible que pour l'animal appartenant à l'utilisateur connecté.",
      "entityId": "ent_visite",
      "id": "rule_acces_historique_proprietaire",
      "kind": "authorization"
    }
  ],
