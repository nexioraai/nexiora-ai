  "slots": [
    {
      "allowedImports": [],
      "description": "Calcule les créneaux de rendez-vous disponibles pour une journée donnée en fonction des horaires du salon, de la prestation demandée et de la taille du chien.",
      "id": "slot_creneaux_disponibles",
      "inputs": [
        {
          "name": "jour",
          "type": "date"
        },
        {
          "name": "prestation",
          "type": "enum"
        },
        {
          "name": "tailleAnimal",
          "type": "enum"
        },
        {
          "name": "rendezVousExistants",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "creneaux",
          "type": "json"
        },
        {
          "name": "dureeEstimeeMinutes",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Détermine la date du prochain rappel de vaccination et si une alerte doit être affichée sur la fiche de l'animal.",
      "id": "slot_prochain_rappel_vaccination",
      "inputs": [
        {
          "name": "derniereVaccination",
          "type": "date"
        },
        {
          "name": "rappelDeclare",
          "type": "date"
        },
        {
          "name": "dateReference",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "prochainRappel",
          "type": "date"
        },
        {
          "name": "alerteRequise",
          "type": "boolean"
        },
        {
          "name": "joursRestants",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Agrège l'historique des visites d'un animal : nombre de passages, montant total réglé sur place et fréquence moyenne entre deux toilettages.",
      "id": "slot_resume_historique",
      "inputs": [
        {
          "name": "visites",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "nombreVisites",
          "type": "number"
        },
        {
          "name": "montantTotal",
          "type": "decimal"
        },
        {
          "name": "intervalleMoyenJours",
          "type": "number"
        },
        {
          "name": "derniereVisite",
          "type": "date"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Estime le tarif indicatif d'une prestation selon la taille, le type de poil et l'état du pelage, à régler sur place.",
      "id": "slot_tarif_estime",
      "inputs": [
        {
          "name": "prestation",
          "type": "enum"
        },
        {
          "name": "tailleAnimal",
          "type": "enum"
        },
        {
          "name": "typePoil",
          "type": "enum"
        },
        {
          "name": "demelageRequis",
          "type": "boolean"
        }
      ],
      "outputs": [
        {
          "name": "tarifEstime",
          "type": "decimal"
        },
        {
          "name": "detailCalcul",
          "type": "text"
        }
      ]
    }
  ]
}
