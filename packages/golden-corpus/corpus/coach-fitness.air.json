  "slots": [
    {
      "allowedImports": [],
      "description": "Détermine l'état d'accès de l'utilisateur (actif, en période d'essai, expiré) à partir du reçu d'achat intégré et de la date courante.",
      "id": "slot_statut_abonnement",
      "inputs": [
        {
          "name": "recuAchat",
          "type": "json"
        },
        {
          "name": "dateCourante",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "statut",
          "type": "enum"
        },
        {
          "name": "dateFinAcces",
          "type": "datetime"
        },
        {
          "name": "accesDebloque",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Calcule le pourcentage d'avancement d'un programme et la prochaine séance recommandée à partir du journal des séances réalisées.",
      "id": "slot_progression_programme",
      "inputs": [
        {
          "name": "programmeId",
          "type": "reference"
        },
        {
          "name": "journaux",
          "type": "json"
        },
        {
          "name": "nombreSeances",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "progressionPourcent",
          "type": "decimal"
        },
        {
          "name": "prochaineSeanceOrdre",
          "type": "number"
        },
        {
          "name": "resume",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Construit l'URL de lecture temporaire d'une vidéo de séance à partir de l'identifiant de vidéo et du jeton d'accès émis par l'API, sans exposer de secret.",
      "id": "slot_lecture_video_securisee",
      "inputs": [
        {
          "name": "videoId",
          "type": "string"
        },
        {
          "name": "accesDebloque",
          "type": "boolean"
        }
      ],
      "outputs": [
        {
          "name": "urlLecture",
          "type": "string"
        },
        {
          "name": "lectureAutorisee",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Agrège les séances réalisées par semaine pour afficher la régularité et la série en cours dans l'écran de suivi.",
      "id": "slot_serie_hebdomadaire",
      "inputs": [
        {
          "name": "journaux",
          "type": "json"
        },
        {
          "name": "dateReference",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "seancesSemaine",
          "type": "number"
