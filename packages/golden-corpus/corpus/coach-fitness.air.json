  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_programme_titre",
          "operator": "required"
        },
        {
          "fieldId": "fld_programme_niveau",
          "operator": "in",
          "value": [
            "debutant",
            "intermediaire",
            "avance"
          ]
        },
        {
          "fieldId": "fld_programme_duree_semaines",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_programme_seances_par_semaine",
          "operator": "gte",
          "value": 1
        }
      ],
      "description": "Un programme doit avoir un titre, un niveau reconnu et une durée d'au moins une semaine.",
      "entityId": "ent_programme",
      "id": "rule_programme_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_seance_programme",
          "operator": "required"
        },
        {
          "fieldId": "fld_seance_numero_ordre",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_seance_duree_minutes",
          "operator": "gte",
          "value": 5
        },
        {
          "fieldId": "fld_seance_duree_minutes",
          "operator": "lte",
          "value": 180
        },
        {
          "fieldId": "fld_seance_video_id",
          "operator": "matches",
          "value": "^[a-z0-9_-]{6,64}$"
        }
      ],
      "description": "Une séance doit être rattachée à un programme, ordonnée et durer entre 5 et 180 minutes.",
      "entityId": "ent_seance",
      "id": "rule_seance_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_journal_seance",
          "operator": "required"
        },
        {
          "fieldId": "fld_journal_date_realisee",
          "operator": "required"
        },
        {
          "fieldId": "fld_journal_duree_reelle",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_journal_progression_pourcent",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_journal_progression_pourcent",
          "operator": "lte",
          "value": 100
        },
        {
          "fieldId": "fld_journal_ressenti",
          "operator": "in",
          "value": [
            "facile",
            "correct",
            "difficile",
            "epuisant"
          ]
        }
      ],
      "description": "Un enregistrement de séance doit référencer une séance, une date de réalisation et une progression comprise entre 0 et 100.",
      "entityId": "ent_journal_seance",
      "id": "rule_journal_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_programme_publie",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Seuls les programmes publiés sont visibles dans l'application.",
      "entityId": "ent_programme",
      "id": "rule_acces_programme_publie",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_seance_gratuite",
          "operator": "eq",
          "value": false
        }
      ],
      "description": "La lecture vidéo d'une séance non gratuite est réservée aux utilisateurs disposant d'un abonnement mensuel actif.",
      "entityId": "ent_seance",
      "id": "rule_acces_seance_abonnes",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_journal_seance",
          "operator": "required"
        },
        {
          "fieldId": "fld_journal_terminee",
          "operator": "in",
          "value": [
            true,
            false
          ]
        }
      ],
      "description": "Un utilisateur ne peut créer ou consulter que ses propres enregistrements de séances terminées ou en cours.",
      "entityId": "ent_journal_seance",
      "id": "rule_journal_proprietaire",
      "kind": "authorization"
    }
  ],
