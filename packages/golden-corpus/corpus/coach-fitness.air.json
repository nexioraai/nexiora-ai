  "expectedTests": [
    {
      "description": "Vérifie que l'évaluation du statut d'abonnement (slot_statut_abonnement) renvoie accesDebloque=true et une dateFinAcces future pour un reçu mensuel valide, statut expiré et accesDebloque=false pour un reçu échu, et statut aucun pour un reçu absent.",
      "id": "test_statut_abonnement",
      "kind": "deterministic",
      "targetId": "act_evaluer_statut_abonnement"
    },
    {
      "description": "Vérifie que la lecture sécurisée (slot_lecture_video_securisee) ne produit une urlLecture que si accesDebloque=true, et retourne lectureAutorisee=false sans URL pour une séance non gratuite sans abonnement actif.",
      "id": "test_lecture_video_securisee",
      "kind": "deterministic",
      "targetId": "act_lire_video_seance"
    },
    {
      "description": "Vérifie le calcul de progressionPourcent (0, partiel, 100) et de prochaineSeanceOrdre par slot_progression_programme à partir des journaux de séances terminées d'un programme.",
      "id": "test_progression_programme",
      "kind": "deterministic",
      "targetId": "act_calculer_progression"
    },
    {
      "description": "Vérifie l'agrégation des séances par semaine via slot_serie_hebdomadaire, le calcul de la série en cours et sa remise à zéro après une semaine sans séance.",
      "id": "test_serie_hebdomadaire",
      "kind": "deterministic",
      "targetId": "act_agreger_serie_hebdomadaire"
    },
    {
      "description": "Vérifie que rule_seance_valide rejette une séance sans programme, avec un numéro d'ordre inférieur à 1, une durée hors bornes 5-180 minutes ou un video_id ne respectant pas le format attendu.",
      "id": "test_seance_valide",
      "kind": "deterministic",
      "targetId": "ent_seance"
    },
    {
      "description": "Vérifie que rule_journal_valide rejette une progression hors de l'intervalle 0-100, une durée réelle nulle, un ressenti hors énumération ou une séance manquante.",
      "id": "test_journal_valide",
      "kind": "deterministic",
      "targetId": "ent_journal_seance"
    },
    {
      "description": "Vérifie que rule_acces_seance_abonnes bloque la lecture des séances non gratuites sans abonnement actif et autorise systématiquement les séances gratuites.",
      "id": "test_acces_seance_abonnes",
      "kind": "deterministic",
      "targetId": "ent_seance"
    },
    {
      "description": "Vérifie que rule_acces_programme_publie ne retourne que les programmes avec publie=true dans la liste blk_programmes_liste.",
      "id": "test_acces_programme_publie",
      "kind": "deterministic",
      "targetId": "ent_programme"
    },
    {
      "description": "Parcours complet en environnement sandbox : ouverture du paywall, achat de l'abonnement mensuel, validation du reçu et déverrouillage immédiat des programmes réservés.",
      "id": "test_e2e_souscription_abonnement",
      "kind": "e2e",
      "targetId": "act_souscrire_abonnement"
    },
    {
      "description": "Vérifie qu'après réinstallation la restauration des achats rétablit le statut d'abonnement actif et l'accès aux vidéos sans nouveau paiement.",
      "id": "test_e2e_restauration_achats",
      "kind": "e2e",
      "targetId": "act_restaurer_achats"
    },
    {
      "description": "Parcours complet : lecture d'une séance, enregistrement du journal (durée, ressenti, progression) puis apparition de la séance dans l'écran de suivi avec statistiques mises à jour.",
      "id": "test_e2e_enregistrer_seance",
      "kind": "e2e",
      "targetId": "act_enregistrer_seance"
    },
    {
      "description": "Vérifie qu'un utilisateur non abonné qui tente de lire une vidéo réservée est redirigé vers l'écran d'abonnement avec le libellé de verrouillage affiché.",
      "id": "test_e2e_paywall_depuis_video_verrouillee",
      "kind": "e2e",
      "targetId": "scr_abonnement"
    },
    {
      "description": "Vérifie que les séances du programme consulté sont mises en cache puis consultables en mode avion, sans exposer de vidéo réservée à un utilisateur non abonné.",
      "id": "test_e2e_cache_hors_ligne",
      "kind": "e2e",
      "targetId": "act_precharger_seances_hors_ligne"
    },
    {
      "description": "Vérifie que la demande d'autorisation des rappels d'entraînement est déclenchée depuis le suivi et que le refus n'interrompt pas l'usage de l'application.",
      "id": "test_e2e_optin_rappels_push",
      "kind": "e2e",
      "targetId": "act_activer_rappels_push"
    },
    {
      "description": "Contrat de l'intégration intg_verification_recu : schéma des réponses actif/essai/expiré, gestion des codes 401 et 5xx, respect du délai de 8 s et de la politique de reprise.",
      "id": "test_contract_verification_recu",
      "kind": "contract",
      "targetId": "act_evaluer_statut_abonnement"
    },
    {
      "description": "Contrat de l'intégration intg_video_streaming : autorisation HLS signée à durée de vie de 300 s, refus sans abonnement actif et absence de secret dans la réponse.",
      "id": "test_contract_video_streaming",
      "kind": "contract",
      "targetId": "act_lire_video_seance"
    },
    {
      "description": "Contrat de l'intégration intg_store_billing : disponibilité du produit coach_fit_studio_mensuel, périodicité P1M, renouvellement automatique et prise en charge de la restauration.",
      "id": "test_contract_store_billing",
      "kind": "contract",
      "targetId": "act_souscrire_abonnement"
    },
    {
      "description": "Contrat de l'intégration intg_auth_identite : ouverture et rafraîchissement silencieux de la session, expiration de l'OTP après 600 s et effectivité de la suppression de compte.",
      "id": "test_contract_auth_identite",
      "kind": "contract",
      "targetId": "act_restaurer_session"
    },
    {
      "description": "Contrat de l'intégration intg_analytics_produit : aucun événement envoyé sans consentement, IP anonymisée et seuls les événements déclarés acceptés par l'endpoint d'ingestion.",
      "id": "test_contract_analytics_consentement",
      "kind": "contract",
      "targetId": "act_analytics_seance_terminee"
    }
  ],
