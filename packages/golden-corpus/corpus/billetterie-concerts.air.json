  "native": {
    "minAndroidSdk": 26,
    "minIosVersion": "16.0"
  },
  "navigation": {
    "entryScreenId": "scr_events_list",
    "routes": [
      {
        "id": "nav_events_list",
        "screenId": "scr_events_list",
        "title": [
          {
            "locale": "fr",
            "text": "Concerts à venir"
          }
        ]
      }
    ]
  },
  "network": {
    "allowedDomains": [
      "api.scene-locale.app"
    ],
    "policy": "deny_by_default"
  },
  "permissions": [
    {
      "permission": "NSCalendarsFullAccessUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr",
          "text": "L'accès à votre calendrier permet d'ajouter la date et le lieu du concert pour lequel vous avez acheté un billet."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.READ_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "La lecture du calendrier sert à vérifier que le concert n'y figure pas déjà avant de l'ajouter."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.WRITE_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "L'écriture dans le calendrier permet d'y enregistrer le concert avec son horaire, son lieu et un rappel."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "Les notifications vous rappellent l'heure d'ouverture des portes et vous préviennent en cas de changement concernant votre concert."
        }
      ],
      "requiredByCapability": "push_notifications"
    }
  ],
  "projectId": "prj_scene_locale",
  "relations": [
    {
      "fromEntityId": "ent_venue",
      "id": "rel_venue_events",
      "kind": "one_to_many",
      "toEntityId": "ent_event"
    },
    {
      "fromEntityId": "ent_event",
      "id": "rel_event_tickets",
      "kind": "one_to_many",
      "toEntityId": "ent_ticket"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_event_title",
          "operator": "required"
        },
        {
          "fieldId": "fld_event_starts_at",
          "operator": "required"
        },
        {
          "fieldId": "fld_event_venue",
          "operator": "required"
        },
        {
          "fieldId": "fld_event_price",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_event_status",
          "operator": "in",
          "value": [
            "draft",
            "on_sale",
            "sold_out",
            "cancelled",
            "past"
          ]
        }
      ],
      "description": "Un concert publié doit avoir un titre, une date de début, un statut connu et un tarif positif ou nul.",
      "entityId": "ent_event",
      "id": "rule_event_publication_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_event_seats_available",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Le nombre de places restantes ne peut jamais être négatif.",
      "entityId": "ent_event",
      "id": "rule_event_stock_disponible",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_ticket_quantity",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_ticket_quantity",
          "operator": "lte",
          "value": 6
        },
        {
          "fieldId": "fld_ticket_buyer_email",
          "operator": "matches",
          "value": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"
        },
        {
          "fieldId": "fld_ticket_amount_paid",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_ticket_holder_name",
          "operator": "required"
        }
      ],
      "description": "Un achat de billet porte sur 1 à 6 places, avec un e-mail acheteur valide et un montant payé positif.",
      "entityId": "ent_ticket",
      "id": "rule_ticket_achat_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_ticket_reference",
          "operator": "required"
        },
        {
          "fieldId": "fld_ticket_scan_payload",
          "operator": "required"
        }
      ],
      "description": "Chaque billet possède une référence et une charge utile de code scannable non vides.",
      "entityId": "ent_ticket",
      "id": "rule_ticket_reference_unique",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_ticket_status",
          "operator": "in",
          "value": [
            "paid",
            "checked_in"
          ]
        }
      ],
      "description": "Le code scannable n'est affiché que pour un billet payé ou déjà contrôlé à l'entrée.",
      "entityId": "ent_ticket",
      "id": "rule_ticket_affichage_autorise",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_ticket_status",
          "operator": "neq",
          "value": "refunded"
        },
        {
          "fieldId": "fld_ticket_status",
          "operator": "neq",
          "value": "cancelled"
        }
      ],
      "description": "Un billet remboursé ou annulé ne peut plus être présenté au contrôle d'accès.",
      "entityId": "ent_ticket",
      "id": "rule_ticket_remboursement_masque",
      "kind": "authorization"
    }
  ],
  "screens": [
    {
      "blocks": [
        {
          "blockType": "header",
          "id": "blk_events_header",
          "props": [
            {
              "key": "title",
              "value": "Concerts à venir"
            },
            {
              "key": "subtitle",
              "value": "La scène locale, près de chez vous"
            },
            {
              "key": "style",
              "value": "large"
            }
          ]
        },
        {
          "blockType": "filter_bar",
          "id": "blk_events_filters",
          "props": [
            {
              "key": "options",
              "value": [
                "Tous",
                "Cette semaine",
                "Ce mois-ci",
                "Dernières places"
              ]
            },
            {
              "key": "defaultOption",
              "value": "Tous"
            },
            {
              "key": "filterFieldId",
              "value": "fld_event_starts_at"
            }
          ]
        },
        {
          "blockType": "list",
          "entityId": "ent_event",
          "id": "blk_events_list"
        },
        {
          "blockType": "empty_state",
          "id": "blk_events_empty",
          "props": [
            {
              "key": "title",
              "value": "Aucun concert programmé"
            },
            {
              "key": "message",
              "value": "Revenez bientôt : de nouvelles dates sont annoncées chaque semaine."
            },
            {
              "key": "icon",
              "value": "calendar_music"
            }
          ]
        }
      ],
      "id": "scr_events_list",
      "title": [
        {
          "locale": "fr",
          "text": "Concerts à venir"
        }
      ]
    }
  ],
  "slots": [
    {
      "allowedImports": [],
      "description": "Construit la charge utile signée du code scannable présenté à l'entrée du concert à partir de la référence du billet.",
      "id": "slot_scan_payload_builder",
      "inputs": [
        {
          "name": "ticketReference",
          "type": "string"
        },
        {
          "name": "eventId",
          "type": "string"
        },
        {
          "name": "issuedAt",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "scanPayload",
          "type": "string"
        },
        {
          "name": "expiresAt",
          "type": "datetime"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Prépare les données d'événement (titre, horaires, lieu, rappel) à insérer dans le calendrier du téléphone.",
      "id": "slot_calendar_event_builder",
      "inputs": [
        {
          "name": "eventTitle",
          "type": "string"
        },
        {
          "name": "startsAt",
          "type": "datetime"
        },
        {
          "name": "endsAt",
          "type": "datetime"
        },
        {
          "name": "venueLabel",
          "type": "string"
        },
        {
          "name": "notes",
          "type": "text"
        }
      ],
      "outputs": [
        {
          "name": "calendarEntry",
          "type": "json"
        }
      ]
    },
    {
      "allowedImports": [
        "intl"
      ],
      "description": "Formate le prix d'un concert et le montant total du panier selon la locale française et la devise du concert.",
      "id": "slot_event_price_formatter",
      "inputs": [
        {
          "name": "amount",
          "type": "decimal"
        },
        {
          "name": "currency",
          "type": "enum"
        },
        {
          "name": "quantity",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "formattedUnitPrice",
          "type": "string"
        },
        {
          "name": "formattedTotal",
          "type": "string"
        },
        {
          "name": "totalAmount",
          "type": "decimal"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Trie et filtre la liste des concerts à venir (statut en vente, date future) pour l'écran d'accueil.",
      "id": "slot_upcoming_events_sorter",
      "inputs": [
        {
          "name": "events",
          "type": "json"
        },
        {
          "name": "now",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "upcomingEvents",
          "type": "json"
        },
        {
          "name": "nextEventLabel",
          "type": "string"
        }
      ]
    }
  ]
}
