    },
    {
      "capability": "analytics",
      "config": [
        {
          "key": "ingestPath",
          "value": "/v1/analytics/events"
        },
        {
          "key": "anonymizeIp",
          "value": true
        },
        {
          "key": "collectCrashDiagnostics",
          "value": true
        },
        {
          "key": "batchIntervalSeconds",
          "value": 30
        },
        {
          "key": "piiFieldsExcluded",
          "value": [
            "fld_ticket_buyer_email",
            "fld_ticket_holder_name"
          ]
        }
      ],
      "id": "intg_analytics_produit",
