    {
      "config": [
        {
          "key": "baseUrl",
          "value": "https://api.scene-locale.app"
        },
        {
          "key": "eventsPath",
          "value": "/v1/events"
        },
        {
          "key": "ticketsPath",
          "value": "/v1/tickets"
        },
        {
          "key": "timeoutMs",
          "value": 8000
        },
        {
          "key": "retryCount",
          "value": 2
        },
        {
          "key": "authMode",
