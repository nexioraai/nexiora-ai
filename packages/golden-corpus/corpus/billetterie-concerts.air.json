          "key": "calendarTarget",
          "value": "default"
        },
        {
          "key": "defaultReminderMinutes",
          "value": 120
        },
        {
          "key": "writeOnlyUserInitiated",
          "value": true
        },
        {
          "key": "allowDuplicates",
          "value": false
        },
        {
          "key": "timezoneMode",
          "value": "event_local"
        }
      ],
      "id": "intg_calendrier_appareil",
      "providerClass": "device_calendar"
    },
    {
      "capability": "push_notifications",
      "config": [
        {
          "key": "registrationPath",
          "value": "/v1/devices/register"
        },
        {
          "key": "topics",
          "value": [
            "rappel_concert",
