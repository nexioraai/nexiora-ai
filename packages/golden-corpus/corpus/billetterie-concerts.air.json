  "expectedTests": [
    {
      "description": "Règle rule_ticket_achat_valide : vérifie que l'achat rejette une quantité hors bornes (0 ou 7), un e-mail acheteur mal formé ou un montant payé nul, et accepte un achat de 1 à 6 places avec e-mail valide.",
      "id": "test_rule_achat_billet_valide",
      "kind": "deterministic",
      "targetId": "ent_ticket"
    },
    {
      "description": "Règle rule_event_stock_disponible : vérifie qu'un concert dont les places restantes deviendraient négatives est refusé.",
      "id": "test_rule_stock_non_negatif",
      "kind": "deterministic",
      "targetId": "ent_event"
    },
    {
      "description": "Règle rule_event_publication_valide : vérifie qu'un concert sans titre, sans date de début, sans lieu, avec tarif négatif ou statut inconnu est rejeté à la publication.",
      "id": "test_rule_publication_concert",
      "kind": "deterministic",
      "targetId": "ent_event"
    },
    {
      "description": "Règles rule_ticket_affichage_autorise et rule_ticket_remboursement_masque : le code scannable n'est exposé que pour un billet payé ou contrôlé, jamais pour un billet réservé, annulé ou remboursé.",
      "id": "test_rule_affichage_code_scannable",
      "kind": "deterministic",
      "targetId": "ent_ticket"
    },
    {
      "description": "Slot slot_scan_payload_builder : vérifie que la charge utile générée est non vide, stable pour une même référence de billet, avec une date d'expiration postérieure à l'émission.",
      "id": "test_slot_scan_payload",
      "kind": "deterministic",
      "targetId": "act_generer_code_scannable"
    },
    {
      "description": "Slot slot_calendar_event_builder : vérifie que l'entrée de calendrier générée contient le titre du concert, un horaire de fin cohérent avec le début et le libellé du lieu.",
      "id": "test_slot_entree_calendrier",
      "kind": "deterministic",
      "targetId": "act_preparer_entree_calendrier"
    },
    {
      "description": "Slot slot_event_price_formatter : vérifie le formatage du tarif unitaire et du total en locale française pour EUR et CHF, y compris le calcul du total pour plusieurs places.",
      "id": "test_slot_formatage_prix",
      "kind": "deterministic",
      "targetId": "act_formater_tarif_concert"
    },
    {
      "description": "Slot slot_upcoming_events_sorter : seuls les concerts en vente et à date future sont conservés, triés par date croissante, avec un libellé de prochain concert correct.",
      "id": "test_slot_tri_concerts_a_venir",
      "kind": "deterministic",
      "targetId": "act_trier_concerts_a_venir"
    },
    {
      "description": "Contrat du PSP carte (intg_psp_carte) : la création de paiement envoie le montant et la devise du billet, respecte la politique réseau (api.scene-locale.app uniquement) et ne transporte aucun secret côté application.",
      "id": "test_contract_psp_checkout",
      "kind": "contract",
      "targetId": "act_payer_billet_carte"
    },
    {
      "description": "Contrat de l'intégration calendrier (intg_calendrier_appareil) : l'ajout n'est déclenché qu'à l'initiative de l'utilisateur, applique un rappel de 120 minutes et n'insère pas de doublon.",
      "id": "test_contract_calendrier",
      "kind": "contract",
      "targetId": "act_ajouter_concert_calendrier"
    },
    {
      "description": "Contrat des notifications (intg_push_rappels) : enregistrement de l'appareil et programmation d'un rappel 180 minutes avant le début du concert sur le sujet rappel_concert.",
      "id": "test_contract_push_rappels",
      "kind": "contract",
      "targetId": "act_programmer_rappel_concert"
    },
    {
      "description": "Contrat de l'API backend (intg_api_backend) : les appels concerts et billets ciblent uniquement les chemins déclarés du domaine autorisé api.scene-locale.app, avec délai et nouvelles tentatives conformes.",
      "id": "test_contract_api_backend",
      "kind": "contract",
      "targetId": "ent_event"
    },
    {
      "description": "Contrat analytics (intg_analytics_produit) : les événements envoyés excluent l'e-mail et le nom du porteur du billet et anonymisent l'adresse IP.",
      "id": "test_contract_analytics_sans_pii",
      "kind": "contract",
      "targetId": "act_suivre_ecran_concerts"
    },
    {
      "description": "Parcours : à l'ouverture de l'app la liste des concerts à venir s'affiche, le filtre « Cette semaine » réduit la liste, et l'état vide apparaît quand aucun concert n'est programmé.",
      "id": "test_e2e_liste_concerts",
      "kind": "e2e",
      "targetId": "scr_events_list"
    },
    {
      "description": "Parcours : depuis la liste, la réservation est créée puis payée par carte, et le billet passe au statut payé avec retour sur l'écran des concerts.",
      "id": "test_e2e_achat_billet_carte",
      "kind": "e2e",
      "targetId": "act_payer_billet_carte"
    },
    {
      "description": "Parcours : après paiement, le code scannable du billet est généré et présentable au contrôle à l'entrée.",
      "id": "test_e2e_affichage_code_entree",
      "kind": "e2e",
      "targetId": "act_generer_code_scannable"
    },
    {
      "description": "Parcours : l'utilisateur ajoute le concert à son calendrier après octroi de la permission, et le billet est marqué comme ajouté au calendrier.",
      "id": "test_e2e_ajout_calendrier",
      "kind": "e2e",
      "targetId": "act_ajouter_concert_calendrier"
    },
    {
      "description": "Parcours : après préchargement, la liste des concerts et le billet payé restent consultables sans réseau.",
      "id": "test_e2e_consultation_hors_ligne",
      "kind": "e2e",
      "targetId": "act_precharger_hors_ligne"
    }
  ],
