        },
        {
          "key": "syncedEntities",
          "value": [
            "ent_event",
            "ent_venue",
            "ent_ticket"
          ]
        },
        {
          "key": "maxAgeMinutes",
          "value": 120
        },
        {
          "key": "evictionPolicy",
