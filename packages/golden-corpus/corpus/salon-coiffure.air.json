  "expectedTests": [
    {
      "description": "act_calculer_creneaux ne retient que des créneaux dont la plage libre couvre la durée de la prestation, sans chevaucher un rendez-vous existant.",
      "id": "test_slot_creneaux_duree",
      "kind": "deterministic",
      "targetId": "act_calculer_creneaux"
    },
    {
      "description": "act_calculer_creneaux produit une liste vide et aucun premier créneau lorsque tous les créneaux du jour sont déjà réservés ou hors horaires d'ouverture.",
      "id": "test_slot_creneaux_journee_complete",
      "kind": "deterministic",
      "targetId": "act_calculer_creneaux"
    },
    {
      "description": "act_formater_catalogue formate durée et prix correctement en fr (« 45 min », « 32,00 € ») et en en (« 45 min », « €32.00 ») pour les mêmes entrées.",
      "id": "test_slot_format_locales",
      "kind": "deterministic",
      "targetId": "act_formater_catalogue"
    },
    {
      "description": "act_planifier_rappel_veille place le rappel la veille à 18h00 heure locale du salon, y compris lors d'un changement d'heure, et renvoie titre et corps dans la locale demandée.",
      "id": "test_slot_rappel_veille_18h",
      "kind": "deterministic",
      "targetId": "act_planifier_rappel_veille"
    },
    {
      "description": "act_planifier_rappel_veille marque le rappel comme non planifiable quand la veille 18h est déjà passée (rendez-vous pris le jour même ou le lendemain matin).",
      "id": "test_slot_rappel_non_planifiable",
      "kind": "deterministic",
      "targetId": "act_planifier_rappel_veille"
    },
    {
      "description": "act_generer_reference produit des références uniques, non séquentielles et au format lisible attendu sur 10 000 générations.",
      "id": "test_slot_reference_unicite",
      "kind": "deterministic",
      "targetId": "act_generer_reference"
    },
    {
      "description": "La validation de ent_prestation rejette une durée hors de l'intervalle 10–240 minutes et un prix négatif.",
      "id": "test_rule_duree_prestation",
      "kind": "deterministic",
      "targetId": "ent_prestation"
    },
    {
      "description": "La validation de ent_rendez_vous accepte les téléphones au format international (+33...) ou national à 10 chiffres et rejette les autres, en tolérant un email vide.",
      "id": "test_rule_telephone_client",
      "kind": "deterministic",
      "targetId": "ent_rendez_vous"
    },
    {
      "description": "La validation de ent_creneau interdit la réservation d'un créneau marqué indisponible ou sans coiffeur assigné.",
      "id": "test_rule_creneau_reservable",
      "kind": "deterministic",
      "targetId": "ent_creneau"
    },
    {
      "description": "L'autorisation sur ent_rendez_vous empêche l'accès et l'annulation d'un rendez-vous par un téléphone différent de celui enregistré, et bloque l'annulation d'un rendez-vous honoré.",
      "id": "test_rule_autorisation_annulation",
      "kind": "deterministic",
      "targetId": "ent_rendez_vous"
    },
    {
      "description": "Parcours complet : sélection d'une prestation, choix d'un créneau puis confirmation déclenchant act_enregistrer_rendez_vous, avec création du rendez-vous et affichage de la référence.",
      "id": "test_e2e_reservation_complete",
      "kind": "e2e",
      "targetId": "act_enregistrer_rendez_vous"
    },
    {
      "description": "Après act_enregistrer_rendez_vous, act_bloquer_creneau rend le créneau indisponible et celui-ci n'apparaît plus dans la liste des créneaux proposés.",
      "id": "test_e2e_creneau_bloque_apres_reservation",
      "kind": "e2e",
      "targetId": "act_bloquer_creneau"
    },
    {
      "description": "À la création d'un rendez-vous, act_programmer_notification_rappel programme une notification locale sur le canal rappels_rdv à la date calculée, uniquement si l'utilisateur a donné son accord.",
      "id": "test_e2e_rappel_programme",
      "kind": "e2e",
      "targetId": "act_programmer_notification_rappel"
    },
    {
      "description": "L'annulation d'un rendez-vous déclenche act_annuler_notification_rappel et libère le créneau correspondant.",
      "id": "test_e2e_annulation_libere_et_annule_rappel",
      "kind": "e2e",
      "targetId": "act_annuler_notification_rappel"
    },
    {
      "description": "Une recherche sans résultat sur scr_prestations affiche l'état vide et masque la liste des prestations.",
      "id": "test_e2e_recherche_et_etat_vide",
      "kind": "e2e",
      "targetId": "scr_prestations"
    },
    {
      "description": "Sans connexion réseau, act_voir_mes_rendez_vous restitue les rendez-vous préalablement mis en cache par act_precharger_hors_ligne.",
      "id": "test_e2e_mes_rendez_vous_hors_ligne",
      "kind": "e2e",
      "targetId": "act_voir_mes_rendez_vous"
    },
    {
      "description": "Le basculement de la locale fr vers en met à jour les titres d'écrans, les libellés de blocs et les formats de durée/prix sans redémarrage.",
      "id": "test_e2e_bascule_fr_en",
      "kind": "e2e",
      "targetId": "scr_prestations"
    },
    {
      "description": "La synchronisation déclenchée par act_precharger_hors_ligne consomme des prestations et créneaux conformes à ent_prestation et ent_creneau (types, énumérations, champs requis) et refuse tout domaine autre que api.salon-rdv.app.",
      "id": "test_contract_api_prestations_creneaux",
      "kind": "contract",
      "targetId": "act_precharger_hors_ligne"
    },
    {
      "description": "act_enregistrer_rendez_vous respecte le schéma ent_rendez_vous, obtient une référence unique et un statut « confirme », et remonte un conflit si le créneau est déjà pris.",
      "id": "test_contract_creation_rendez_vous",
      "kind": "contract",
      "targetId": "act_enregistrer_rendez_vous"
    },
    {
      "description": "act_ajouter_au_calendrier crée un événement dont la durée correspond à fld_prestation_duree_minutes, avec une alarme 120 minutes avant et une confirmation utilisateur préalable.",
      "id": "test_contract_calendrier_evenement",
      "kind": "contract",
      "targetId": "act_ajouter_au_calendrier"
    },
    {
      "description": "act_mesurer_reservation n'émet aucun identifiant personnel (nom, téléphone, email) et n'envoie rien sans consentement.",
      "id": "test_contract_analytics_sans_donnees_perso",
      "kind": "contract",
      "targetId": "act_mesurer_reservation"
    },
    {
      "description": "Le cache alimenté par act_precharger_hors_ligne chiffre les données au repos, respecte la rétention de 30 jours et purge les entrées selon la politique LRU.",
      "id": "test_contract_cache_chiffre",
      "kind": "contract",
      "targetId": "act_precharger_hors_ligne"
    },
    {
      "description": "act_programmer_notification_rappel n'opère qu'avec POST_NOTIFICATIONS déclarée et justifiée en fr et en, et les permissions calendrier (READ_CALENDAR, WRITE_CALENDAR, NSCalendarsFullAccessUsageDescription) restent rattachées à la capability calendar.",
      "id": "test_contract_permissions_declarees",
      "kind": "contract",
      "targetId": "act_programmer_notification_rappel"
    }
  ],
