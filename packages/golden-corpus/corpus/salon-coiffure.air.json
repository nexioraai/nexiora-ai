  "slots": [
    {
      "allowedImports": [
        "date-fns",
        "date-fns-tz"
      ],
      "description": "Calcule la liste des créneaux réservables pour une journée donnée en fonction de la durée de la prestation, des horaires d'ouverture du salon et des rendez-vous déjà pris.",
      "id": "slot_calcul_creneaux_disponibles",
      "inputs": [
        {
          "name": "jour",
          "type": "date"
        },
        {
          "name": "dureePrestationMinutes",
          "type": "number"
        },
        {
          "name": "creneauxBruts",
          "type": "json"
        },
        {
          "name": "rendezVousExistants",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "creneauxDisponibles",
          "type": "json"
        },
        {
          "name": "premierCreneau",
          "type": "datetime"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Formate la durée (en minutes) et le prix d'une prestation en libellés lisibles selon la locale fr ou en.",
      "id": "slot_format_duree_prix",
      "inputs": [
        {
          "name": "dureeMinutes",
          "type": "number"
        },
        {
          "name": "prix",
          "type": "decimal"
        },
        {
          "name": "locale",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "libelleDuree",
          "type": "string"
        },
        {
          "name": "libellePrix",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [
        "date-fns",
        "date-fns-tz"
      ],
      "description": "Détermine la date/heure d'envoi du rappel la veille du rendez-vous (18h00 heure locale du salon) et compose le titre et le corps localisés de la notification.",
      "id": "slot_planification_rappel_veille",
      "inputs": [
        {
          "name": "debutRendezVous",
          "type": "datetime"
        },
        {
          "name": "nomPrestation",
          "type": "string"
        },
        {
          "name": "locale",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "rappelPlanifieLe",
          "type": "datetime"
        },
        {
          "name": "titre",
          "type": "string"
        },
        {
          "name": "corps",
          "type": "string"
        },
        {
          "name": "planifiable",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [
        "nanoid"
      ],
      "description": "Génère une référence de rendez-vous courte, lisible et non devinable à partir de la date du créneau et d'un aléa local.",
      "id": "slot_generation_reference_rdv",
      "inputs": [
        {
          "name": "debutRendezVous",
          "type": "datetime"
        },
        {
          "name": "identifiantPrestation",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "reference",
          "type": "string"
        }
      ]
    }
  ]
}
