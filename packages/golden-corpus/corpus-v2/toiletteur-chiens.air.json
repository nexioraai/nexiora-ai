      "permission": "NSPhotoLibraryUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "L'accès à votre photothèque permet d'ajouter la photo de votre chien à sa fiche du salon."
        }
      ],
      "requiredByCapability": "media_upload"
    },
    {
      "permission": "android.permission.READ_MEDIA_IMAGES",
      "platform": "android",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "L'accès à vos images permet de choisir la photo de votre chien pour sa fiche du salon."
        }
      ],
      "requiredByCapability": "media_upload"
    },
    {
      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "Les notifications servent à vous rappeler la vaccination de votre chien et à confirmer vos rendez-vous de toilettage."
        }
      ],
      "requiredByCapability": "push_notifications"
    }
  ],
  "projectId": "prj_toilettage_canin",
  "relations": [
    {
      "fromEntityId": "ent_animal",
      "id": "rel_animal_rendez_vous",
      "kind": "one_to_many",
      "toEntityId": "ent_rendez_vous"
    },
    {
      "fromEntityId": "ent_animal",
      "id": "rel_animal_visites",
      "kind": "one_to_many",
      "toEntityId": "ent_visite"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_animal_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_proprietaire",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_telephone",
          "operator": "matches",
          "value": "^(\\+33|0)[1-9][0-9]{8}$"
        }
      ],
      "description": "La fiche d'un chien doit comporter son nom, le nom du propriétaire et un numéro de téléphone français valide.",
      "entityId": "ent_animal",
      "id": "rule_animal_contact_obligatoire",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_animal_rappel_actif",
          "operator": "eq",
          "value": true
        },
        {
          "fieldId": "fld_animal_vaccin_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_animal_vaccin_rappel",
          "operator": "required"
        }
      ],
      "description": "Un rappel de vaccination ne peut être activé que si la date de la dernière vaccination et la date de rappel sont renseignées.",
      "entityId": "ent_animal",
      "id": "rule_animal_rappel_vaccin",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_rdv_animal",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_date_heure",
          "operator": "required"
        },
        {
          "fieldId": "fld_rdv_prestation",
          "operator": "in",
          "value": [
            "bain",
            "tonte",
            "coupe_ciseaux",
            "demelage",
            "soin_complet"
          ]
        },
        {
          "fieldId": "fld_rdv_statut",
          "operator": "in",
          "value": [
            "demande",
            "confirme",
            "honore",
            "annule"
          ]
        },
        {
          "fieldId": "fld_rdv_duree_minutes",
          "operator": "gte",
          "value": 15
        }
      ],
      "description": "Un rendez-vous doit cibler un chien, porter une date et heure, une prestation du catalogue et un statut connu.",
      "entityId": "ent_rendez_vous",
      "id": "rule_rdv_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_rdv_statut",
          "operator": "neq",
          "value": "honore"
        },
        {
          "fieldId": "fld_rdv_statut",
          "operator": "neq",
          "value": "annule"
        }
      ],
      "description": "Le propriétaire ne peut modifier ou annuler qu'un rendez-vous qui n'a pas encore été honoré ni déjà annulé.",
      "entityId": "ent_rendez_vous",
      "id": "rule_rdv_modification_client",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_visite_animal",
          "operator": "required"
        },
        {
          "fieldId": "fld_visite_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_visite_montant_regle",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_visite_mode_paiement",
          "operator": "in",
          "value": [
            "especes_sur_place",
            "carte_sur_place",
            "cheque_sur_place"
          ]
        }
      ],
      "description": "Une visite d'historique enregistre un montant positif réglé sur place au salon (espèces, carte ou chèque).",
      "entityId": "ent_visite",
      "id": "rule_visite_paiement_sur_place",
      "kind": "validation"
    }
  ],
