  "expectedTests": [
    {
      "description": "Règle rule_animal_contact_obligatoire : vérifie que l'enregistrement d'une fiche animal échoue sans nom, sans propriétaire ou avec un téléphone qui ne respecte pas le format français (+33 ou 0 suivi de 9 chiffres).",
      "id": "test_rule_animal_contact",
      "kind": "deterministic",
      "targetId": "ent_animal"
    },
    {
      "description": "Règle rule_animal_rappel_vaccin : vérifie qu'activer le rappel de vaccination sans date de dernière vaccination ni date de rappel est refusé, et accepté lorsque les deux dates sont renseignées.",
      "id": "test_rule_rappel_vaccin",
      "kind": "deterministic",
      "targetId": "act_enregistrer_animal"
    },
    {
      "description": "Règle rule_rdv_valide : vérifie qu'un rendez-vous sans animal, sans date/heure, avec une prestation hors catalogue ou d'une durée inférieure à 15 minutes est rejeté.",
      "id": "test_rule_rdv_valide",
      "kind": "deterministic",
      "targetId": "ent_rendez_vous"
    },
    {
      "description": "Règle rule_rdv_modification_client : vérifie qu'un rendez-vous au statut honore ou annule ne peut plus être modifié ni annulé par le propriétaire.",
      "id": "test_rule_rdv_modification",
      "kind": "deterministic",
      "targetId": "act_annuler_rendez_vous"
    },
    {
      "description": "Règle rule_visite_paiement_sur_place : vérifie qu'une visite n'accepte qu'un montant positif et un mode de paiement sur place (espèces, carte ou chèque), tout autre mode étant refusé.",
      "id": "test_rule_visite_paiement",
      "kind": "deterministic",
      "targetId": "ent_visite"
    },
    {
      "description": "Slot slot_calcul_rappel_vaccin : vérifie que le calcul du rappel de vaccination retourne une date à 12 mois de la dernière vaccination, le drapeau rappelDu et le nombre de jours restants, y compris pour une date échue.",
      "id": "test_slot_rappel_vaccin",
      "kind": "deterministic",
      "targetId": "act_calculer_rappel_vaccin"
    },
    {
      "description": "Slot slot_creneaux_disponibles : vérifie que les créneaux disponibles excluent les horaires déjà confirmés, respectent la durée de la prestation et signalent aucunCreneau quand la journée est complète.",
      "id": "test_slot_creneaux",
      "kind": "deterministic",
      "targetId": "act_charger_creneaux"
    },
    {
      "description": "Slot slot_resume_historique : vérifie que le résumé d'historique calcule le nombre de visites, le montant total réglé sur place et la date de la dernière prestation, avec un résumé vide si aucune visite.",
      "id": "test_slot_resume_historique",
      "kind": "deterministic",
      "targetId": "act_resume_historique"
    },
    {
      "description": "Parcours complet : depuis l'écran Mes chiens, l'utilisateur ouvre la création, remplit la fiche avec une photo importée puis l'enregistre et la retrouve dans la liste.",
      "id": "test_e2e_creation_fiche_animal",
      "kind": "e2e",
      "targetId": "scr_fiche_animal"
    },
    {
      "description": "Parcours complet : depuis la fiche animal, l'utilisateur ouvre la prise de rendez-vous, demande un créneau et voit le rendez-vous au statut demande dans la liste des rendez-vous à venir.",
      "id": "test_e2e_prise_rendez_vous",
      "kind": "e2e",
      "targetId": "scr_rendez_vous"
    },
    {
      "description": "Parcours complet : depuis la fiche animal, l'utilisateur consulte l'historique et voit les visites passées avec leur montant réglé sur place, ou l'état vide proposant de prendre rendez-vous.",
      "id": "test_e2e_historique_visites",
      "kind": "e2e",
      "targetId": "scr_historique"
    },
    {
      "description": "Contrat du service de notifications : la programmation locale d'un rappel de vaccination utilise le canal rappels_vaccination et déclenche l'alerte 14 jours avant la date de rappel.",
      "id": "test_contract_push_rappel",
      "kind": "contract",
      "targetId": "act_programmer_rappel_vaccin"
    },
    {
      "description": "Contrat de l'import de médias sur la fiche animal : seuls les fichiers image/jpeg et image/png de moins de 8 Mo issus de la photothèque sont acceptés pour la photo de l'animal.",
      "id": "test_contract_media_upload",
      "kind": "contract",
      "targetId": "scr_fiche_animal"
    },
    {
      "description": "Contrat du stockage hors-ligne : les entités animal, rendez_vous et visite sont synchronisées en last_write_wins et restent lisibles sans réseau pendant 90 jours.",
      "id": "test_contract_offline_sync",
      "kind": "contract",
      "targetId": "act_sync_animaux_hors_ligne"
    },
    {
      "description": "Contrat d'authentification : la restauration de session au démarrage refuse l'accès anonyme et redirige vers l'écran Mes chiens en cas de session valide.",
      "id": "test_contract_auth_session",
      "kind": "contract",
      "targetId": "act_connexion_demarrage"
    }
  ],
