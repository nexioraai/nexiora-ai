  "slots": [
    {
      "allowedImports": [
        "dart:core",
        "package:intl/intl.dart"
      ],
      "description": "Calcule la date du prochain rappel de vaccination (12 mois après la dernière vaccination) et indique si le rappel est échu ou proche.",
      "id": "slot_calcul_rappel_vaccin",
      "inputs": [
        {
          "name": "derniereVaccination",
          "type": "date"
        },
        {
          "name": "dateReference",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "dateRappel",
          "type": "date"
        },
        {
          "name": "rappelDu",
          "type": "boolean"
        },
        {
          "name": "joursRestants",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [
        "dart:core",
        "package:intl/intl.dart"
      ],
      "description": "Construit la liste des créneaux de rendez-vous disponibles pour une journée donnée en tenant compte de la durée de la prestation et des rendez-vous déjà confirmés.",
      "id": "slot_creneaux_disponibles",
      "inputs": [
        {
          "name": "jour",
          "type": "date"
        },
        {
          "name": "dureeMinutes",
          "type": "number"
        },
        {
          "name": "rendezVousExistants",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "creneaux",
          "type": "json"
        },
        {
          "name": "aucunCreneau",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [
        "dart:core",
        "package:intl/intl.dart"
      ],
      "description": "Résume l'historique des visites d'un chien : nombre de visites, montant total réglé sur place et date de la dernière prestation.",
      "id": "slot_resume_historique",
      "inputs": [
        {
          "name": "visites",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "nombreVisites",
          "type": "number"
        },
        {
          "name": "montantTotal",
          "type": "decimal"
        },
        {
          "name": "derniereVisite",
          "type": "date"
        },
        {
          "name": "resume",
          "type": "string"
        }
      ]
    }
