{
  "actions": [
    {
      "effect": {
        "kind": "navigate",
        "screenId": "scr_store"
      },
      "id": "act_open_store",
      "name": "Ouvrir la boutique de packs",
      "trigger": {
        "blockId": "blk_home_open_store",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "capability": "payments.iap",
        "kind": "capability",
        "method": "purchase",
        "params": [
          {
            "key": "productIdFieldId",
            "value": "fld_pack_product_id"
          },
          {
            "key": "productType",
            "value": "non_consumable"
          },
          {
            "key": "quantity",
            "value": 1
          }
        ]
      },
      "id": "act_purchase_pack",
      "name": "Acheter un pack de leçons",
      "trigger": {
        "blockId": "blk_store_buy_button",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "capability": "payments.iap",
        "kind": "capability",
        "method": "restorePurchases",
        "params": [
          {
            "key": "scope",
            "value": "all_non_consumables"
          }
        ]
      },
      "id": "act_restore_purchases",
      "name": "Restaurer les achats",
      "trigger": {
        "blockId": "blk_store_restore_button",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "kind": "slot",
        "slotId": "slot_pack_price_formatter"
      },
      "id": "act_format_pack_prices",
      "name": "Formater les prix du catalogue",
      "trigger": {
        "event": "screen_open",
        "kind": "lifecycle",
        "screenId": "scr_store"
      }
    },
    {
      "effect": {
        "capability": "analytics",
        "kind": "capability",
        "method": "track",
        "params": [
          {
            "key": "eventName",
            "value": "lesson_pack_unlocked"
          },
          {
            "key": "properties",
            "value": [
              "pack_title",
              "pack_level",
              "pack_language"
            ]
          }
        ]
      },
      "id": "act_track_pack_unlocked",
      "name": "Journaliser le déblocage d'un pack",
      "trigger": {
        "entityId": "ent_lesson_pack",
        "event": "updated",
        "kind": "data"
      }
    },
    {
      "effect": {
        "entityId": "ent_lesson",
        "kind": "mutation",
        "operation": "update"
      },
      "id": "act_start_lesson",
      "name": "Commencer la leçon",
      "trigger": {
        "blockId": "blk_lesson_start_button",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "entityId": "ent_progress_entry",
        "kind": "mutation",
        "operation": "create"
      },
      "id": "act_save_progress",
      "name": "Enregistrer la progression de la session",
      "trigger": {
        "blockId": "blk_lesson_progress_form",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "kind": "slot",
        "slotId": "slot_review_scheduler"
      },
      "id": "act_compute_review_schedule",
      "name": "Calculer la prochaine révision",
      "trigger": {
        "entityId": "ent_progress_entry",
        "event": "created",
        "kind": "data"
      }
    },
    {
      "effect": {
        "kind": "slot",
        "slotId": "slot_progress_summary"
      },
      "id": "act_load_progress_summary",
      "name": "Calculer le résumé de progression",
      "trigger": {
        "event": "screen_open",
        "kind": "lifecycle",
        "screenId": "scr_progress"
      }
    },
    {
      "effect": {
        "capability": "push_notifications",
        "kind": "capability",
        "method": "scheduleDaily",
        "params": [
          {
            "key": "channelId",
            "value": "daily_review"
          },
          {
            "key": "timeFieldId",
            "value": "fld_prog_reminder_time"
          },
          {
            "key": "titleFr",
            "value": "C'est l'heure de réviser"
          },
          {
            "key": "titleEn",
            "value": "Time to review"
          },
          {
            "key": "bodyFr",
            "value": "Quelques minutes suffisent pour consolider votre leçon du jour."
          },
          {
            "key": "bodyEn",
            "value": "A few minutes are enough to consolidate today's lesson."
          }
        ]
      },
      "id": "act_schedule_daily_reminder",
      "name": "Programmer le rappel quotidien de révision",
      "trigger": {
        "blockId": "blk_progress_reminder_button",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "capability": "push_notifications",
        "kind": "capability",
        "method": "requestPermission",
        "params": [
          {
            "key": "rationaleFr",
            "value": "Pour recevoir vos rappels quotidiens de révision."
          },
          {
            "key": "rationaleEn",
            "value": "To receive your daily review reminders."
          }
        ]
      },
      "id": "act_request_notification_permission",
      "name": "Demander l'autorisation de notifications",
      "trigger": {
        "event": "screen_open",
        "kind": "lifecycle",
        "screenId": "scr_home"
      }
    },
    {
      "effect": {
        "capability": "auth",
        "kind": "capability",
        "method": "signIn",
        "params": [
          {
            "key": "method",
            "value": "email_otp"
          },
          {
            "key": "allowAnonymousBrowsing",
            "value": true
          }
        ]
      },
      "id": "act_sign_in_learner",
      "name": "Authentifier l'apprenant",
      "trigger": {
        "event": "app_start",
        "kind": "lifecycle"
      }
    },
    {
      "effect": {
        "capability": "offline_storage",
        "kind": "capability",
        "method": "sync",
        "params": [
          {
            "key": "entities",
            "value": [
              "ent_lesson_pack",
              "ent_lesson",
              "ent_progress_entry"
            ]
          },
          {
            "key": "strategy",
            "value": "last_write_wins"
          }
        ]
      },
      "id": "act_sync_offline_catalog",
      "name": "Synchroniser le contenu hors-ligne",
      "trigger": {
        "event": "app_start",
        "kind": "lifecycle"
      }
    },
    {
      "effect": {
        "capability": "analytics",
        "kind": "capability",
        "method": "track",
        "params": [
          {
            "key": "eventName",
            "value": "lesson_status_changed"
          },
          {
            "key": "properties",
            "value": [
              "lesson_status",
              "lesson_position"
            ]
          }
        ]
      },
      "id": "act_track_lesson_completed",
      "name": "Journaliser une leçon terminée",
      "trigger": {
        "entityId": "ent_lesson",
        "event": "updated",
        "kind": "data"
      }
    }
  ],
