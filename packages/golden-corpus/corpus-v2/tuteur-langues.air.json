  "expectedTests": [
    {
      "description": "Vérifie qu'un pack de leçons sans identifiant produit IAP, sans libellé de prix ou avec moins d'une leçon est rejeté (règle rule_pack_catalog_valid).",
      "id": "test_pack_catalog_validation",
      "kind": "deterministic",
      "targetId": "ent_lesson_pack"
    },
    {
      "description": "Vérifie qu'une leçon sans pack, de position inférieure à 1, de durée inférieure à 3 minutes ou de statut inconnu est refusée (règle rule_lesson_valid).",
      "id": "test_lesson_validation",
      "kind": "deterministic",
      "targetId": "ent_lesson"
    },
    {
      "description": "Vérifie que les scores hors intervalle 0-100 sont rejetés et que les scores limites 0 et 100 sont acceptés (règle rule_progress_score_range).",
      "id": "test_progress_score_range",
      "kind": "deterministic",
      "targetId": "ent_progress_entry"
    },
    {
      "description": "Vérifie que l'heure de rappel respecte le format 24h HH:MM lorsque le rappel est activé (24:00 et 7:5 refusés, 09:30 accepté) — règle rule_reminder_time_format.",
      "id": "test_reminder_time_format",
      "kind": "deterministic",
      "targetId": "ent_progress_entry"
    },
    {
      "description": "Vérifie que l'action de résumé de progression (slot_progress_summary) calcule un pourcentage d'avancement borné, une série de jours consécutifs correcte et un libellé localisable.",
      "id": "test_progress_summary_slot",
      "kind": "deterministic",
      "targetId": "act_load_progress_summary"
    },
    {
      "description": "Vérifie que le calcul de révision (slot_review_scheduler) produit une date postérieure à l'achèvement, plus rapprochée quand le score est faible, et un prochain rappel à l'heure demandée.",
      "id": "test_review_scheduler_slot",
      "kind": "deterministic",
      "targetId": "act_compute_review_schedule"
    },
    {
      "description": "Vérifie que le formatage des prix du catalogue (slot_pack_price_formatter) produit un libellé correct pour les locales fr (défaut) et en sans perte de devise.",
      "id": "test_price_formatter_locales",
      "kind": "deterministic",
      "targetId": "act_format_pack_prices"
    },
    {
      "description": "Contrat de la boutique intégrée : achat non consommable, retour de reçu validé côté serveur et gestion des cas annulation/échec réseau.",
      "id": "test_iap_purchase_contract",
      "kind": "contract",
      "targetId": "act_purchase_pack"
    },
    {
      "description": "Contrat de restauration des achats : les packs déjà achetés reviennent marqués comme possédés sans nouvelle facturation.",
      "id": "test_iap_restore_contract",
      "kind": "contract",
      "targetId": "act_restore_purchases"
    },
    {
      "description": "Contrat de l'API backend lors de l'authentification : seul api.linguapacks.app est appelé, en-tête Accept-Language fr/en honoré, timeouts et reprises respectés.",
      "id": "test_backend_api_contract",
      "kind": "contract",
      "targetId": "act_sign_in_learner"
    },
    {
      "description": "Contrat du service de notifications : programmation quotidienne sur le canal daily_review avec titres et corps localisés fr/en.",
      "id": "test_push_reminder_contract",
      "kind": "contract",
      "targetId": "act_schedule_daily_reminder"
    },
    {
      "description": "Contrat du cache local : synchronisation chiffrée des packs, leçons et progressions avec résolution last_write_wins.",
      "id": "test_offline_sync_contract",
      "kind": "contract",
      "targetId": "act_sync_offline_catalog"
    },
    {
      "description": "Contrat analytics : aucun identifiant d'appareil transmis, IP anonymisée, événement lesson_pack_unlocked émis avec ses propriétés.",
      "id": "test_analytics_privacy_contract",
      "kind": "contract",
      "targetId": "act_track_pack_unlocked"
    },
    {
      "description": "Parcours complet : ouverture de la boutique depuis l'accueil, achat d'un pack, déblocage des leçons puis démarrage d'une leçon.",
      "id": "test_e2e_purchase_then_learn",
      "kind": "e2e",
      "targetId": "scr_store"
    },
    {
      "description": "Parcours complet : enregistrement d'une session sur l'écran de leçon, calcul de la prochaine révision et activation du rappel quotidien depuis l'écran de progression.",
      "id": "test_e2e_save_progress_and_reminder",
      "kind": "e2e",
      "targetId": "scr_progress"
    },
    {
      "description": "Parcours complet : bascule de l'interface entre le français (défaut) et l'anglais, tous les libellés d'écrans et de boutons restant traduits.",
      "id": "test_e2e_locale_switch",
      "kind": "e2e",
      "targetId": "scr_home"
    }
  ],
