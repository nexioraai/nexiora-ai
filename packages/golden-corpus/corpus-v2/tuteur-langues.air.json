  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_pack_title",
          "operator": "required"
        },
        {
          "fieldId": "fld_pack_product_id",
          "operator": "required"
        },
        {
          "fieldId": "fld_pack_price_label",
          "operator": "required"
        },
        {
          "fieldId": "fld_pack_lesson_count",
          "operator": "gte",
          "value": 1
        }
      ],
      "description": "Un pack de leçons doit avoir un titre, un identifiant produit IAP, un libellé de prix et au moins une leçon.",
      "entityId": "ent_lesson_pack",
      "id": "rule_pack_catalog_valid",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_lesson_pack",
          "operator": "required"
        },
        {
          "fieldId": "fld_lesson_order",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_lesson_duration_min",
          "operator": "gte",
          "value": 3
        },
        {
          "fieldId": "fld_lesson_status",
          "operator": "in",
          "value": [
            "not_started",
            "in_progress",
            "completed"
          ]
        }
      ],
      "description": "Une leçon est rattachée à un pack, possède une position positive, une durée d'au moins 3 minutes et un statut connu.",
      "entityId": "ent_lesson",
      "id": "rule_lesson_valid",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_prog_lesson",
          "operator": "required"
        },
        {
          "fieldId": "fld_prog_score",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_prog_score",
          "operator": "lte",
          "value": 100
        }
      ],
      "description": "Le score de progression est compris entre 0 et 100 et référence une leçon existante.",
      "entityId": "ent_progress_entry",
      "id": "rule_progress_score_range",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_prog_reminder_enabled",
          "operator": "eq",
          "value": true
        },
        {
          "fieldId": "fld_prog_reminder_time",
          "operator": "matches",
          "value": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      ],
      "description": "Si un rappel quotidien est activé, l'heure de rappel doit respecter le format HH:MM sur 24 heures.",
      "entityId": "ent_progress_entry",
      "id": "rule_reminder_time_format",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_pack_owned",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Le contenu d'une leçon n'est lisible que si le pack correspondant a été acheté (pack marqué comme possédé).",
      "entityId": "ent_lesson_pack",
      "id": "rule_lesson_access_requires_purchase",
      "kind": "authorization"
    }
  ],
