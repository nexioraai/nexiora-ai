  "slots": [
    {
      "allowedImports": [],
      "description": "Calcule le pourcentage d'avancement et la série de jours consécutifs à partir des entrées de progression de l'apprenant.",
      "id": "slot_progress_summary",
      "inputs": [
        {
          "name": "progressEntries",
          "type": "json"
        },
        {
          "name": "totalLessons",
          "type": "number"
        },
        {
          "name": "today",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "completionPercent",
          "type": "decimal"
        },
        {
          "name": "streakDays",
          "type": "number"
        },
        {
          "name": "summaryLabel",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Détermine la prochaine date de révision et l'horaire du rappel quotidien selon le score obtenu et la date d'achèvement de la leçon.",
      "id": "slot_review_scheduler",
      "inputs": [
        {
          "name": "score",
          "type": "decimal"
        },
        {
          "name": "completedAt",
          "type": "datetime"
        },
        {
          "name": "reminderTime",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "reviewDueOn",
          "type": "date"
        },
        {
          "name": "nextReminderAt",
          "type": "datetime"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Formate le libellé de prix d'un pack retourné par la boutique intégrée selon la locale active (fr par défaut, en).",
      "id": "slot_pack_price_formatter",
      "inputs": [
        {
          "name": "rawPrice",
          "type": "json"
        },
        {
          "name": "locale",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "priceLabel",
          "type": "string"
        }
      ]
    }
