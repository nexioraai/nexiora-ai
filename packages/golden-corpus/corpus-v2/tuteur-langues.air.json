  "projectId": "prj_lingua_packs",
  "relations": [
    {
      "fromEntityId": "ent_lesson_pack",
      "id": "rel_pack_lessons",
      "kind": "one_to_many",
      "toEntityId": "ent_lesson"
    },
    {
      "fromEntityId": "ent_lesson",
      "id": "rel_lesson_progress",
      "kind": "one_to_many",
      "toEntityId": "ent_progress_entry"
    }
