  "expectedTests": [
    {
      "description": "Vérifie qu'un cours sans titre, sans identifiant de produit d'achat intégré conforme, non publié ou de durée nulle est rejeté par la règle de publication.",
      "id": "test_rule_cours_publiable",
      "kind": "deterministic",
      "targetId": "ent_cours"
    },
    {
      "description": "Vérifie qu'un achat sans identifiant de transaction, avec un statut ou une plateforme inconnus, ou une progression supérieure à 100, est refusé.",
      "id": "test_rule_achat_coherent",
      "kind": "deterministic",
      "targetId": "ent_achat"
    },
    {
      "description": "Vérifie que la lecture est autorisée uniquement pour un achat au statut validé rattaché au cours demandé, et refusée pour les statuts en_attente, rembourse et annule.",
      "id": "test_rule_lecture_reservee",
      "kind": "deterministic",
      "targetId": "act_lire_cours"
    },
    {
      "description": "Vérifie que les recettes publiées sont lisibles sans compte ni achat et que les recettes non publiées restent inaccessibles.",
      "id": "test_rule_recette_acces_libre",
      "kind": "deterministic",
      "targetId": "ent_recette"
    },
    {
      "description": "Vérifie qu'une recette sans titre, sans ingrédients, sans étapes ou avec un temps de préparation inférieur à 1 minute est invalide.",
      "id": "test_rule_recette_contenu",
      "kind": "deterministic",
      "targetId": "ent_recette"
    },
    {
      "description": "Vérifie que le prix d'un cours est formaté selon la locale active, en français par défaut et en anglais en secondaire.",
      "id": "test_slot_prix_localise",
      "kind": "deterministic",
      "targetId": "act_afficher_prix_localise"
    },
    {
      "description": "Vérifie le calcul du pourcentage de progression et de la position de reprise, bornes incluses (0 seconde et durée complète).",
      "id": "test_slot_progression_reprise",
      "kind": "deterministic",
      "targetId": "act_calculer_reprise"
    },
    {
      "description": "Vérifie le filtrage des recettes par catégorie et temps maximum, ainsi que le tri stable des résultats.",
      "id": "test_slot_filtre_recettes",
      "kind": "deterministic",
      "targetId": "act_filtrer_recettes"
    },
    {
      "description": "Contrat de l'intégration d'achats intégrés : achat d'un produit non consommable, validation du reçu et création d'un achat au statut attendu.",
      "id": "test_contract_iap_achat",
      "kind": "contract",
      "targetId": "act_acheter_cours"
    },
    {
      "description": "Contrat de restauration des achats : les cours déjà acquis sont rétablis et aucun doublon de transaction n'est créé.",
      "id": "test_contract_iap_restauration",
      "kind": "contract",
      "targetId": "act_restaurer_achats"
    },
    {
      "description": "Contrat de résolution de l'URL de lecture signée : URL valide et date d'expiration renvoyées pour un achat validé, erreur sinon.",
      "id": "test_contract_url_lecture",
      "kind": "contract",
      "targetId": "act_resoudre_url_lecture"
    },
    {
      "description": "Contrat d'authentification : restauration de session, navigation anonyme autorisée et suppression de compte disponible.",
      "id": "test_contract_auth_session",
      "kind": "contract",
      "targetId": "act_restaurer_session"
    },
    {
      "description": "Contrat des notifications : demande d'autorisation provisoire et programmation d'une notification locale de nouveau cours en français et en anglais.",
      "id": "test_contract_push_gateway",
      "kind": "contract",
      "targetId": "act_demander_notifications"
    },
    {
      "description": "Contrat des liens profonds : un lien vers un cours ouvre l'écran de détail, un lien inconnu retombe sur le catalogue.",
      "id": "test_contract_deep_links",
      "kind": "contract",
      "targetId": "act_resoudre_lien_profond"
    },
    {
      "description": "Parcours complet : depuis le catalogue, ouvrir un cours, l'acheter via l'achat intégré, puis lancer la lecture de la vidéo débloquée.",
      "id": "test_e2e_achat_puis_lecture",
      "kind": "e2e",
      "targetId": "scr_cours_detail"
    },
    {
      "description": "Parcours : un cours non acheté affiche l'état verrouillé du lecteur avec l'appel à l'achat au lieu de la vidéo.",
      "id": "test_e2e_lecture_verrouillee",
      "kind": "e2e",
      "targetId": "scr_lecteur"
    },
    {
      "description": "Parcours : consulter la liste des recettes publiées sans compte, filtrer par catégorie, puis rejoindre le catalogue des cours.",
      "id": "test_e2e_recettes_acces_libre",
      "kind": "e2e",
      "targetId": "scr_recettes"
    },
    {
      "description": "Parcours : quitter le lecteur en cours de vidéo puis y revenir et reprendre la lecture à la position enregistrée.",
      "id": "test_e2e_reprise_progression",
      "kind": "e2e",
      "targetId": "act_enregistrer_progression"
    },
    {
      "description": "Parcours : les recettes mises en cache restent consultables sans réseau après un premier affichage de l'écran Recettes.",
      "id": "test_e2e_recettes_hors_ligne",
      "kind": "e2e",
      "targetId": "act_cacher_recettes_hors_ligne"
    },
    {
      "description": "Parcours : basculer l'application de français à anglais et vérifier les titres d'écrans, libellés de boutons et prix affichés.",
      "id": "test_e2e_bascule_langue",
      "kind": "e2e",
      "targetId": "scr_catalogue"
    }
  ],
