  "slots": [
    {
      "allowedImports": [
        "@air/runtime/intl"
      ],
      "description": "Formate le prix d'un cours à partir des informations de la boutique d'achats intégrés selon la locale active (fr par défaut, en secondaire).",
      "id": "slot_prix_localise",
      "inputs": [
        {
          "name": "produitIap",
          "type": "string"
        },
        {
          "name": "locale",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "prixAffiche",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [
        "@air/runtime/http"
      ],
      "description": "Résout l'URL de lecture signée et sa date d'expiration pour un cours acheté et validé.",
      "id": "slot_url_lecture_securisee",
      "inputs": [
        {
          "name": "coursId",
          "type": "reference"
        },
        {
          "name": "transactionId",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "urlLecture",
          "type": "string"
        },
        {
          "name": "expireLe",
          "type": "datetime"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Calcule le pourcentage de progression et la position de reprise d'un cours à partir de la dernière position lue.",
      "id": "slot_progression_reprise",
      "inputs": [
        {
          "name": "positionSecondes",
          "type": "number"
        },
        {
          "name": "dureeMinutes",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "progressionPourcent",
          "type": "decimal"
        },
        {
          "name": "repriseSecondes",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Filtre et trie la liste des recettes en accès libre par catégorie et temps de préparation.",
      "id": "slot_filtre_recettes",
      "inputs": [
        {
          "name": "categorie",
          "type": "enum"
        },
        {
          "name": "tempsMax",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "resultats",
          "type": "json"
        }
      ]
    }
  ]
