  "projectId": "prj_cours_cuisine_video",
  "relations": [
    {
      "fromEntityId": "ent_cours",
      "id": "rel_cours_achats",
      "kind": "one_to_many",
      "toEntityId": "ent_achat"
    },
    {
      "fromEntityId": "ent_cours",
      "id": "rel_cours_recettes",
      "kind": "one_to_many",
      "toEntityId": "ent_recette"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_cours_titre",
          "operator": "required"
        },
        {
          "fieldId": "fld_cours_produit_iap",
          "operator": "matches",
          "value": "^[a-z0-9_.]{6,64}$"
        },
        {
          "fieldId": "fld_cours_publie",
          "operator": "eq",
          "value": true
        },
        {
          "fieldId": "fld_cours_duree_minutes",
          "operator": "gt",
          "value": 0
        }
      ],
      "description": "Un cours n'est visible au catalogue que s'il est publié et rattaché à un identifiant de produit achat intégré valide.",
      "entityId": "ent_cours",
      "id": "rule_cours_publiable",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_achat_transaction_id",
          "operator": "required"
        },
        {
          "fieldId": "fld_achat_statut",
          "operator": "in",
          "value": [
            "en_attente",
            "valide",
            "rembourse",
            "annule"
          ]
        },
        {
          "fieldId": "fld_achat_plateforme",
          "operator": "in",
          "value": [
            "ios",
            "android"
          ]
        },
        {
          "fieldId": "fld_achat_progression",
          "operator": "lte",
          "value": 100
        }
      ],
      "description": "Un achat doit porter un statut connu, un identifiant de transaction et une plateforme supportée.",
      "entityId": "ent_achat",
      "id": "rule_achat_coherent",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_achat_statut",
          "operator": "eq",
          "value": "valide"
        },
        {
          "fieldId": "fld_achat_cours",
          "operator": "required"
        }
      ],
      "description": "La lecture de la vidéo d'un cours n'est autorisée que si l'utilisateur possède un achat au statut validé pour ce cours.",
      "entityId": "ent_achat",
      "id": "rule_lecture_reservee",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_recette_publiee",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Les recettes publiées sont consultables librement, sans compte ni achat.",
      "entityId": "ent_recette",
      "id": "rule_recette_acces_libre",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_recette_titre",
          "operator": "required"
        },
        {
          "fieldId": "fld_recette_ingredients",
          "operator": "required"
        },
        {
          "fieldId": "fld_recette_etapes",
          "operator": "required"
        },
        {
          "fieldId": "fld_recette_temps_minutes",
          "operator": "gte",
          "value": 1
        }
      ],
      "description": "Une recette doit comporter un titre, ses ingrédients et ses étapes.",
      "entityId": "ent_recette",
      "id": "rule_recette_contenu",
      "kind": "validation"
    }
  ],
