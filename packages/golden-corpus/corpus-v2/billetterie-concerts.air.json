  "slots": [
    {
      "allowedImports": [],
      "description": "Calcule le montant total d'une commande de billets à partir du prix unitaire du concert, de la quantité demandée et des frais de service, puis vérifie la disponibilité des places restantes.",
      "id": "slot_calcul_montant_commande",
      "inputs": [
        {
          "name": "prixUnitaire",
          "type": "decimal"
        },
        {
          "name": "quantite",
          "type": "number"
        },
        {
          "name": "placesRestantes",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "montantTotal",
          "type": "decimal"
        },
        {
          "name": "disponible",
          "type": "boolean"
        },
        {
          "name": "messageIndisponibilite",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Génère la référence lisible et le code scannable unique d'un billet après confirmation du paiement, ainsi que la charge utile encodée dans le QR code présenté à l'entrée.",
      "id": "slot_generation_code_billet",
      "inputs": [
        {
          "name": "evenementId",
          "type": "string"
        },
        {
          "name": "acheteurEmail",
          "type": "string"
        },
        {
          "name": "dateAchat",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "reference",
          "type": "string"
        },
        {
          "name": "codeScan",
          "type": "string"
        },
        {
          "name": "chargeUtileQr",
          "type": "json"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Prépare l'entrée de calendrier d'un concert (titre, horaires, lieu formaté, rappel avant le début) à partir des données de l'événement, pour ajout dans le calendrier de l'appareil.",
      "id": "slot_evenement_calendrier",
      "inputs": [
        {
          "name": "titre",
          "type": "string"
        },
        {
          "name": "dateDebut",
          "type": "datetime"
        },
        {
          "name": "dateFin",
          "type": "datetime"
        },
        {
          "name": "lieuNom",
          "type": "string"
        },
        {
          "name": "lieuAdresse",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "evenementCalendrier",
          "type": "json"
        },
        {
          "name": "minutesRappel",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Met en forme pour l'affichage la date, l'heure et le libellé de disponibilité de chaque concert de la liste selon la locale fr-FR.",
      "id": "slot_formatage_liste_evenements",
      "inputs": [
        {
          "name": "dateDebut",
          "type": "datetime"
        },
        {
          "name": "placesRestantes",
          "type": "number"
        },
        {
          "name": "statut",
          "type": "enum"
        }
      ],
      "outputs": [
        {
          "name": "dateAffichee",
          "type": "string"
        },
        {
          "name": "libelleDisponibilite",
          "type": "string"
        }
      ]
    }
