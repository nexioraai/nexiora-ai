      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "Les notifications servent à vous rappeler l'heure de votre concert et à confirmer la validation de votre billet."
        }
      ],
      "requiredByCapability": "push_notifications"
    }
