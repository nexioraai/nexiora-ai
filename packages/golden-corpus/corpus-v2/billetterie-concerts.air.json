      "permission": "NSCalendarsFullAccessUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "L'accès au calendrier permet d'ajouter la date et l'heure du concert que vous avez choisi à votre agenda."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.READ_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "La lecture du calendrier permet de vérifier que le concert n'est pas déjà enregistré dans votre agenda avant de l'ajouter."
        }
      ],
      "requiredByCapability": "calendar"
    },
    {
      "permission": "android.permission.WRITE_CALENDAR",
      "platform": "android",
      "reason": [
        {
          "locale": "fr-FR",
          "text": "L'écriture dans le calendrier permet d'ajouter le concert et son rappel à votre agenda."
        }
