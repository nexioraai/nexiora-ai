  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_evenement_statut",
          "operator": "in",
          "value": [
            "en_vente",
            "complet"
          ]
        },
        {
          "fieldId": "fld_evenement_prix",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_evenement_debut",
          "operator": "required"
        },
        {
          "fieldId": "fld_evenement_places",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Un concert n'est visible et achetable que s'il est en vente, avec un prix positif, une date de début renseignée et au moins une place restante.",
      "entityId": "ent_evenement",
      "id": "rule_evenement_publiable",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_billet_reference",
          "operator": "matches",
          "value": "^SL-[0-9A-Z]{8}$"
        },
        {
          "fieldId": "fld_billet_code_scan",
          "operator": "required"
        },
        {
          "fieldId": "fld_billet_quantite",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_billet_montant",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_billet_acheteur_email",
          "operator": "matches",
          "value": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        }
      ],
      "description": "Un billet doit porter une référence, un code scannable unique, une quantité d'au moins 1 et un montant total positif.",
      "entityId": "ent_billet",
      "id": "rule_billet_coherent",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_billet_acheteur_email",
          "operator": "required"
        },
        {
          "fieldId": "fld_billet_statut",
          "operator": "in",
          "value": [
            "valide",
            "utilise"
          ]
        }
      ],
      "description": "Seul l'acheteur identifié par son adresse e-mail peut consulter son billet, et uniquement si celui-ci n'est ni annulé ni remboursé.",
      "entityId": "ent_billet",
      "id": "rule_billet_acces_proprietaire",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_billet_statut",
          "operator": "eq",
          "value": "valide"
        },
        {
          "fieldId": "fld_billet_evenement",
          "operator": "required"
        },
        {
          "fieldId": "fld_billet_code_scan",
          "operator": "matches",
          "value": "^[0-9A-Z]{16}$"
        }
      ],
      "description": "Le contrôle à l'entrée n'accepte qu'un billet au statut valide dont le code scannable correspond à l'événement du jour.",
      "entityId": "ent_billet",
      "id": "rule_billet_scan_entree",
      "kind": "validation"
    }
  ],
