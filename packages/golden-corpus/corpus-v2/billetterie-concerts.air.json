  "expectedTests": [
    {
      "description": "Le calcul du montant de commande déclenché à l'ouverture de l'écran d'achat multiplie le prix unitaire par la quantité, renvoie disponible=false et un message explicite lorsque la quantité dépasse les places restantes.",
      "id": "test_montant_commande",
      "kind": "deterministic",
      "targetId": "act_calculer_montant_commande"
    },
    {
      "description": "À la création du billet, la génération produit une référence au format SL-XXXXXXXX, un code scannable unique de 16 caractères alphanumériques majuscules et une charge utile QR cohérente avec l'événement et l'acheteur.",
      "id": "test_code_billet",
      "kind": "deterministic",
      "targetId": "act_generer_code_billet"
    },
    {
      "description": "La préparation de l'entrée de calendrier restitue titre, horaires en Europe/Paris, lieu formaté avec adresse et un rappel de 120 minutes, y compris lorsque la date de fin est absente.",
      "id": "test_preparation_calendrier",
      "kind": "deterministic",
      "targetId": "act_preparer_calendrier"
    },
    {
      "description": "Le formatage de la programmation affiche la date en fr-FR et un libellé de disponibilité distinct pour les statuts en_vente, complet et annule.",
      "id": "test_formatage_liste",
      "kind": "deterministic",
      "targetId": "act_formater_liste_evenements"
    },
    {
      "description": "Un concert au statut brouillon, sans date de début ou avec un prix négatif est rejeté par la validation de l'entité evenement, tandis qu'un concert en_vente valide est accepté.",
      "id": "test_evenement_publiable",
      "kind": "deterministic",
      "targetId": "ent_evenement"
    },
    {
      "description": "Un billet avec référence mal formée, e-mail invalide, quantité nulle ou montant nul est refusé par la validation de l'entité billet.",
      "id": "test_billet_coherent",
      "kind": "deterministic",
      "targetId": "ent_billet"
    },
    {
      "description": "L'ouverture de l'écran billet exige une session : la consultation est refusée à un autre e-mail que celui de l'acheteur et pour un billet annulé ou remboursé, avec retour à la programmation.",
      "id": "test_billet_acces",
      "kind": "deterministic",
      "targetId": "act_authentifier_acheteur"
    },
    {
      "description": "Le contrôle à l'entrée n'accepte que les billets au statut valide dont le code scannable respecte le format à 16 caractères et correspond à l'événement.",
      "id": "test_scan_entree",
      "kind": "deterministic",
      "targetId": "ent_billet"
    },
    {
      "description": "Parcours complet : ouverture de la liste des concerts, sélection d'une date, saisie des coordonnées, paiement par carte puis affichage du billet avec son code scannable.",
      "id": "test_e2e_parcours_achat",
      "kind": "e2e",
      "targetId": "scr_achat"
    },
    {
      "description": "Depuis le détail du concert, l'appui sur « Ajouter à mon calendrier » demande la permission calendrier puis crée l'événement avec un rappel de 2 heures.",
      "id": "test_e2e_ajout_calendrier",
      "kind": "e2e",
      "targetId": "act_ajouter_au_calendrier"
    },
    {
      "description": "Sans billet enregistré, l'écran Mon billet affiche l'état vide et le bouton « Découvrir les concerts » ramène à la programmation.",
      "id": "test_e2e_billet_vide",
      "kind": "e2e",
      "targetId": "scr_billet"
    },
    {
      "description": "Contrat PSP : création d'intention de paiement en EUR, retour sur l'écran billet après succès, gestion des cas refus et abandon sans création de billet valide.",
      "id": "test_contract_paiement_carte",
      "kind": "contract",
      "targetId": "act_payer_par_carte"
    },
    {
      "description": "Contrat REST : la synchronisation des concerts sur api.scenelocale.app respecte les schémas d'entités attendus, l'authentification bearer et le timeout de 10 s.",
      "id": "test_contract_api_billetterie",
      "kind": "contract",
      "targetId": "act_rafraichir_evenements"
    },
    {
      "description": "Contrat calendrier appareil : refus de permission géré sans plantage, détection des doublons et création d'un événement unique avec rappel.",
      "id": "test_contract_calendrier",
      "kind": "contract",
      "targetId": "act_ajouter_au_calendrier"
    },
    {
      "description": "Contrat notifications : programmation locale du rappel 180 minutes avant le concert sur le canal rappels_concerts, annulée si le billet est annulé ou remboursé.",
      "id": "test_contract_rappels_push",
      "kind": "contract",
      "targetId": "act_notifier_rappel_concert"
    }
  ],
