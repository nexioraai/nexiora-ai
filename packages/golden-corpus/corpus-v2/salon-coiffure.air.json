  "slots": [
    {
      "allowedImports": [
        "date-fns"
      ],
      "description": "Calcule la liste des créneaux disponibles pour une prestation et une journée données, en tenant compte de la durée de la prestation et des créneaux déjà réservés.",
      "id": "slot_available_slots",
      "inputs": [
        {
          "name": "serviceId",
          "type": "reference"
        },
        {
          "name": "day",
          "type": "date"
        },
        {
          "name": "durationMinutes",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "availableSlots",
          "type": "json"
        },
        {
          "name": "slotCount",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [
        "date-fns",
        "date-fns-tz"
      ],
      "description": "Détermine la date et l'heure du rappel local à programmer la veille du rendez-vous (18h00 heure locale du salon).",
      "id": "slot_reminder_schedule",
      "inputs": [
        {
          "name": "appointmentStartsAt",
          "type": "datetime"
        },
        {
          "name": "reminderEnabled",
          "type": "boolean"
        }
      ],
      "outputs": [
        {
          "name": "reminderAt",
          "type": "datetime"
        },
        {
          "name": "shouldSchedule",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Génère une référence de réservation courte, lisible et unique pour un nouveau rendez-vous.",
      "id": "slot_booking_reference",
      "inputs": [
        {
          "name": "serviceName",
          "type": "string"
        },
        {
          "name": "startsAt",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "reference",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Formate la durée d'une prestation en libellé localisé (fr/en), par exemple « 1 h 15 » ou « 1 hr 15 min ».",
      "id": "slot_duration_label",
      "inputs": [
        {
          "name": "durationMinutes",
          "type": "number"
        },
        {
          "name": "locale",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "label",
          "type": "string"
        }
      ]
    }
  ]
