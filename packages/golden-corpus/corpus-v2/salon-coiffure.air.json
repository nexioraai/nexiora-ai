          "locale": "fr",
          "text": "Pour vous envoyer le rappel de votre rendez-vous la veille à 18h00."
        },
        {
          "locale": "en",
          "text": "To send you the reminder for your appointment the day before at 6:00 PM."
        }
      ],
      "requiredByCapability": "push_notifications"
    }
  ],
  "projectId": "prj_salon_rdv",
  "relations": [
    {
      "fromEntityId": "ent_service",
      "id": "rel_service_time_slots",
      "kind": "one_to_many",
      "toEntityId": "ent_time_slot"
    },
    {
      "fromEntityId": "ent_service",
      "id": "rel_service_appointments",
      "kind": "one_to_many",
      "toEntityId": "ent_appointment"
    },
    {
      "fromEntityId": "ent_time_slot",
      "id": "rel_slot_appointment",
      "kind": "one_to_one",
      "toEntityId": "ent_appointment"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_service_duration_minutes",
          "operator": "gte",
          "value": 5
        },
        {
          "fieldId": "fld_service_duration_minutes",
          "operator": "lte",
          "value": 300
        }
      ],
      "description": "La durée d'une prestation doit être d'au moins 5 minutes et ne pas dépasser 300 minutes.",
      "entityId": "ent_service",
      "id": "rule_service_duration_positive",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_service_price",
          "operator": "required"
        },
        {
          "fieldId": "fld_service_price",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Le prix affiché doit être renseigné et positif (paiement sur place, à titre indicatif).",
      "entityId": "ent_service",
      "id": "rule_service_price_valid",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_slot_status",
          "operator": "in",
          "value": [
            "available",
            "held",
            "booked",
            "closed"
          ]
        },
        {
          "fieldId": "fld_slot_starts_at",
          "operator": "required"
        },
        {
          "fieldId": "fld_slot_ends_at",
          "operator": "required"
        }
      ],
      "description": "Seul un créneau au statut disponible peut être proposé à la réservation.",
      "entityId": "ent_time_slot",
      "id": "rule_slot_bookable",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_appt_customer_name",
          "operator": "required"
        },
        {
          "fieldId": "fld_appt_customer_phone",
          "operator": "matches",
          "value": "^\\+?[0-9 .-]{9,20}$"
        }
      ],
      "description": "Un rendez-vous exige un nom et un numéro de téléphone français ou international valide.",
      "entityId": "ent_appointment",
      "id": "rule_appointment_contact_valid",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_appt_status",
          "operator": "in",
          "value": [
            "pending",
            "confirmed",
            "cancelled",
            "completed"
          ]
        },
        {
          "fieldId": "fld_appt_slot",
          "operator": "required"
        },
        {
          "fieldId": "fld_appt_service",
          "operator": "required"
        }
      ],
      "description": "Le statut d'un rendez-vous doit appartenir au cycle de vie autorisé et le créneau doit être renseigné.",
      "entityId": "ent_appointment",
      "id": "rule_appointment_status_flow",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_appt_customer_phone",
          "operator": "required"
        },
        {
          "fieldId": "fld_appt_status",
          "operator": "neq",
          "value": "completed"
        }
      ],
      "description": "Un client ne peut consulter, modifier ou annuler que les rendez-vous associés à son propre numéro de téléphone.",
      "entityId": "ent_appointment",
      "id": "rule_appointment_owner_access",
      "kind": "authorization"
    }
  ],
