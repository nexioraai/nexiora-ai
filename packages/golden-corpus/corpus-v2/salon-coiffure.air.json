  "app": {
    "description": [
      {
        "locale": "fr",
        "text": "Application de prise de rendez-vous pour salon de coiffure : consultation des prestations et de leur durée, choix d'un créneau disponible et rappel automatique la veille. Le paiement s'effectue sur place, au salon."
      },
      {
        "locale": "en",
        "text": "Hair salon booking app: browse services and their duration, pick an available time slot and get an automatic reminder the day before. Payment is made on site at the salon."
      }
    ],
