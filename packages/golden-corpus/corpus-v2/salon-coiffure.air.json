  "expectedTests": [
    {
      "description": "Via act_refresh_slots, vérifie que le calcul des créneaux (slot_available_slots) ne retourne que les créneaux au statut disponible, compatibles avec la durée de la prestation, et exclut les chevauchements avec les créneaux déjà réservés.",
      "id": "test_slot_available_slots",
      "kind": "deterministic",
      "targetId": "act_refresh_slots"
    },
    {
      "description": "Via act_compute_reminder_at, vérifie que le calcul du rappel (slot_reminder_schedule) place le rappel la veille à 18h00 heure locale du salon et renvoie shouldSchedule=false lorsque le rappel est désactivé ou que la veille est déjà passée.",
      "id": "test_slot_reminder_schedule",
      "kind": "deterministic",
      "targetId": "act_compute_reminder_at"
    },
    {
      "description": "Via act_generate_reference, vérifie que la référence de réservation (slot_booking_reference) est courte, lisible, stable pour une même entrée et distincte pour deux rendez-vous différents.",
      "id": "test_slot_booking_reference",
      "kind": "deterministic",
      "targetId": "act_generate_reference"
    },
    {
      "description": "Via act_format_duration, vérifie que le libellé de durée (slot_duration_label) est correctement formaté en français (« 1 h 15 ») et en anglais (« 1 hr 15 min »), y compris pour les durées inférieures à une heure.",
      "id": "test_slot_duration_label",
      "kind": "deterministic",
      "targetId": "act_format_duration"
    },
    {
      "description": "Sur ent_service, vérifie que rule_service_duration_positive rejette une durée inférieure à 5 minutes ou supérieure à 300 minutes et accepte les valeurs intermédiaires, et que rule_service_price_valid exige un prix positif.",
      "id": "test_rule_service_duration",
      "kind": "deterministic",
      "targetId": "ent_service"
    },
    {
      "description": "Sur ent_appointment, vérifie que rule_appointment_contact_valid exige un nom et n'accepte qu'un numéro de téléphone de 9 à 20 caractères au format autorisé.",
      "id": "test_rule_appointment_contact",
      "kind": "deterministic",
      "targetId": "ent_appointment"
    },
    {
      "description": "Sur ent_time_slot, vérifie que rule_slot_bookable refuse un créneau sans date de début ou de fin et n'autorise que les statuts du cycle de vie défini.",
      "id": "test_rule_slot_bookable",
      "kind": "deterministic",
      "targetId": "ent_time_slot"
    },
    {
      "description": "Sur ent_appointment, vérifie que rule_appointment_status_flow n'autorise que les statuts pending, confirmed, cancelled, completed et exige un créneau et une prestation, et que rule_appointment_owner_access empêche l'accès aux rendez-vous d'un autre numéro de téléphone.",
      "id": "test_rule_appointment_status_flow",
      "kind": "deterministic",
      "targetId": "ent_appointment"
    },
    {
      "description": "Parcours complet : ouverture des prestations, sélection d'une prestation, choix d'un créneau disponible, saisie des coordonnées et confirmation créant un rendez-vous au statut pending avec sa référence.",
      "id": "test_e2e_booking_flow",
      "kind": "e2e",
      "targetId": "scr_booking"
    },
    {
      "description": "Après confirmation d'un rendez-vous avec rappel activé, une notification locale est programmée sur le canal appointment_reminder à la date calculée dans fld_appt_reminder_at.",
      "id": "test_e2e_reminder_scheduled",
      "kind": "e2e",
      "targetId": "act_schedule_reminder"
    },
    {
      "description": "Depuis Mes rendez-vous, l'annulation passe le statut à cancelled, libère le créneau et supprime le rappel programmé associé.",
      "id": "test_e2e_cancel_appointment",
      "kind": "e2e",
      "targetId": "act_cancel_appointment"
    },
    {
      "description": "Sans réseau, l'écran des prestations affiche le catalogue mis en cache et l'état vide propose de recharger les prestations.",
      "id": "test_e2e_offline_services",
      "kind": "e2e",
      "targetId": "scr_services"
    },
    {
      "description": "Contrat de l'API backend (intg_salon_backend) exercé à la confirmation : schémas et codes de réponse pour la création/mise à jour d'un rendez-vous et la lecture des prestations et créneaux, sur api.salon-rendez-vous.app uniquement.",
      "id": "test_contract_backend_api",
      "kind": "contract",
      "targetId": "act_confirm_booking"
    },
    {
      "description": "Contrat du fournisseur de notifications (intg_push_local_scheduler) : programmation et annulation d'un rappel local sur le canal appointment_reminder, y compris le refus de la permission POST_NOTIFICATIONS.",
      "id": "test_contract_push_scheduler",
      "kind": "contract",
      "targetId": "act_schedule_reminder"
    },
    {
      "description": "Contrat analytics (intg_analytics_product) : l'événement app_opened est envoyé sans identifiant d'appareil ni donnée personnelle, avec IP anonymisée et respect du lot de 20 événements.",
      "id": "test_contract_analytics",
      "kind": "contract",
      "targetId": "act_track_app_start"
    },
    {
      "description": "Contrat du stockage local (intg_offline_cache) lors de la synchronisation des prestations : chiffrement au repos, expiration du cache après 1440 minutes et résolution des conflits en faveur du serveur.",
      "id": "test_contract_offline_cache",
      "kind": "contract",
      "targetId": "act_load_services"
    }
  ],
