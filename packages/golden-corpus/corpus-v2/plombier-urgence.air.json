  "expectedTests": [
    {
      "description": "Règle rule_demande_description_complete : vérifie qu'une demande dont la description est vide ou inférieure à 20 caractères est rejetée, et qu'une description de 20 caractères ou plus est acceptée.",
      "id": "test_rule_description_complete",
      "kind": "deterministic",
      "targetId": "ent_demande"
    },
    {
      "description": "Règle rule_demande_localisation : vérifie que l'adresse d'intervention et la ville sont exigées et que seul un code postal français à 5 chiffres est accepté (rejet de '750', '7501A', '750011').",
      "id": "test_rule_localisation_code_postal",
      "kind": "deterministic",
      "targetId": "ent_demande"
    },
    {
      "description": "Règle rule_demande_statut_valide : vérifie que seuls les statuts du cycle de vie défini sont acceptés et qu'un statut inconnu est refusé.",
      "id": "test_rule_statut_cycle_vie",
      "kind": "deterministic",
      "targetId": "ent_demande"
    },
    {
      "description": "Règle rule_client_contact_joignable : vérifie que le nom est requis et que le téléphone respecte le format français (0612345678 et +33612345678 acceptés, 12345 refusé).",
      "id": "test_rule_contact_client",
      "kind": "deterministic",
      "targetId": "ent_client"
    },
    {
      "description": "Règle rule_photo_rattachee : vérifie qu'une photo sans fichier ou sans demande associée est rejetée.",
      "id": "test_rule_photo_rattachee",
      "kind": "deterministic",
      "targetId": "ent_photo"
    },
    {
      "description": "Règle rule_acces_demandes_du_client : vérifie qu'un client authentifié ne peut lire ni modifier une demande appartenant à un autre client.",
      "id": "test_rule_acces_demandes_client",
      "kind": "deterministic",
      "targetId": "ent_demande"
    },
    {
      "description": "Règle rule_modification_demande_ouverte : vérifie que l'annulation via l'action est refusée lorsque la demande est déjà terminée ou annulée.",
      "id": "test_rule_modification_demande_ouverte",
      "kind": "deterministic",
      "targetId": "act_annuler_demande"
    },
    {
      "description": "Slot slot_reference_demande : vérifie que la référence générée respecte le format PLB-AAAAMMJJ-XXXX, reste déterministe à entrée constante et sans collision sur 1000 générations.",
      "id": "test_slot_reference_unique",
      "kind": "deterministic",
      "targetId": "act_generer_reference"
    },
    {
      "description": "Slot slot_suivi_statut : vérifie que chaque statut est traduit en libellé et message français avec l'étape numérique attendue et le drapeau terminee correct.",
      "id": "test_slot_suivi_statut_libelles",
      "kind": "deterministic",
      "targetId": "act_traduire_statut"
    },
    {
      "description": "Slot slot_preparation_photos : vérifie la compression sous la taille maximale, la conservation de l'orientation et le rejet d'un fichier non image.",
      "id": "test_slot_preparation_photos",
      "kind": "deterministic",
      "targetId": "act_optimiser_photos"
    },
    {
      "description": "Slot slot_geocodage_adresse : vérifie que l'adresse normalisée et les coordonnées sont produites depuis une adresse complète, et l'adresse depuis des coordonnées GPS.",
      "id": "test_slot_geocodage_adresse",
      "kind": "deterministic",
      "targetId": "act_geocoder_adresse"
    },
    {
      "description": "Parcours complet : saisie du formulaire de nouvelle demande (titre, catégorie, description, urgence, adresse, code postal, ville) puis envoi et retour à la liste avec la demande au statut nouvelle.",
      "id": "test_e2e_creation_demande",
      "kind": "e2e",
      "targetId": "scr_nouvelle_demande"
    },
    {
      "description": "Parcours : ajout de photos du problème depuis la galerie, avec demande de permission médias et prévisualisation des fichiers optimisés.",
      "id": "test_e2e_ajout_photos",
      "kind": "e2e",
      "targetId": "act_ajouter_photos"
    },
    {
      "description": "Parcours : partage de la position actuelle depuis le formulaire, remplissage automatique de l'adresse après acceptation de la permission de localisation.",
      "id": "test_e2e_partage_position",
      "kind": "e2e",
      "targetId": "act_partager_position"
    },
    {
      "description": "Parcours : ouverture du suivi d'une demande, affichage du statut, de l'urgence, du lieu sur la carte et des photos envoyées.",
      "id": "test_e2e_suivi_demande",
      "kind": "e2e",
      "targetId": "scr_detail_demande"
    },
    {
      "description": "Parcours : première ouverture sans demande, affichage de l'état vide et création d'une demande via son bouton.",
      "id": "test_e2e_liste_vide",
      "kind": "e2e",
      "targetId": "scr_demandes"
    },
    {
      "description": "Contrat REST de l'intégration intg_api_backend lors de la création d'une demande : endpoints demandes/photos/clients, codes de statut, schémas de réponse et politique réseau deny_by_default limitée à api.plomberie-express.app.",
      "id": "test_contract_api_backend",
      "kind": "contract",
      "targetId": "act_creer_demande"
    },
    {
      "description": "Contrat d'authentification de l'intégration intg_auth_otp : demande d'OTP, vérification, restauration de session au démarrage et suppression de compte.",
      "id": "test_contract_auth_otp",
      "kind": "contract",
      "targetId": "act_authentifier"
    },
    {
      "description": "Contrat d'envoi de médias de l'intégration intg_stockage_medias : obtention d'URL signée côté serveur, respect des types autorisés et de la taille maximale, reprise d'un envoi interrompu.",
      "id": "test_contract_stockage_medias",
      "kind": "contract",
      "targetId": "act_ajouter_photo_detail"
    },
    {
      "description": "Contrat push de l'intégration intg_notifications_push : enregistrement de l'appareil, envoi sur le canal suivi_demande et réception d'une notification de changement de statut.",
      "id": "test_contract_notifications_push",
      "kind": "contract",
      "targetId": "act_notifier_changement_statut"
    },
    {
      "description": "Contrat hors-ligne de l'intégration intg_cache_local : création d'une demande sans réseau, persistance chiffrée puis synchronisation avec politique server_wins au retour du réseau.",
      "id": "test_contract_cache_local",
      "kind": "contract",
      "targetId": "act_synchroniser_hors_ligne"
    }
  ],
