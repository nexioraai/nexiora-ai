  "slots": [
    {
      "allowedImports": [
        "air/runtime/http",
        "air/runtime/logger"
      ],
      "description": "Convertit l'adresse saisie (adresse, code postal, ville) en coordonnées latitude/longitude, ou complète l'adresse à partir de la position GPS partagée par le client.",
      "id": "slot_geocodage_adresse",
      "inputs": [
        {
          "name": "adresse",
          "type": "string"
        },
        {
          "name": "codePostal",
          "type": "string"
        },
        {
          "name": "ville",
          "type": "string"
        },
        {
          "name": "latitude",
          "type": "decimal"
        },
        {
          "name": "longitude",
          "type": "decimal"
        }
      ],
      "outputs": [
        {
          "name": "adresseNormalisee",
          "type": "string"
        },
        {
          "name": "latitude",
          "type": "decimal"
        },
        {
          "name": "longitude",
          "type": "decimal"
        },
        {
          "name": "precision",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [
        "air/runtime/media",
        "air/runtime/logger"
      ],
      "description": "Compresse et redimensionne les photos du problème avant envoi, et retire les métadonnées inutiles tout en conservant l'orientation.",
      "id": "slot_preparation_photos",
      "inputs": [
        {
          "name": "fichier",
          "type": "asset"
        },
        {
          "name": "tailleMaxKo",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "fichierOptimise",
          "type": "asset"
        },
        {
          "name": "tailleKo",
          "type": "number"
        },
        {
          "name": "rejete",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [
        "air/runtime/uuid"
      ],
      "description": "Génère une référence lisible et unique pour une nouvelle demande d'intervention (format PLB-AAAAMMJJ-XXXX).",
      "id": "slot_reference_demande",
      "inputs": [
        {
          "name": "dateCreation",
          "type": "datetime"
        },
        {
          "name": "ville",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "reference",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [
        "air/runtime/i18n",
        "air/runtime/date"
      ],
      "description": "Traduit le statut technique d'une demande en libellé et message de suivi affichables en français, avec l'étape courante du parcours.",
