  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_demande_description",
          "operator": "required"
        },
        {
          "fieldId": "fld_demande_description",
          "operator": "matches",
          "value": "^[\\s\\S]{20,2000}$"
        }
      ],
      "description": "La description du problème est obligatoire et doit contenir au moins 20 caractères pour permettre une estimation fiable.",
      "entityId": "ent_demande",
      "id": "rule_demande_description_complete",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_demande_adresse_intervention",
          "operator": "required"
        },
        {
          "fieldId": "fld_demande_ville",
          "operator": "required"
        },
        {
          "fieldId": "fld_demande_code_postal",
          "operator": "matches",
          "value": "^[0-9]{5}$"
        }
      ],
      "description": "L'adresse d'intervention, le code postal et la ville sont obligatoires ; le code postal doit être un code postal français à 5 chiffres.",
      "entityId": "ent_demande",
      "id": "rule_demande_localisation",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_demande_statut",
          "operator": "in",
          "value": [
            "nouvelle",
            "prise_en_charge",
            "visite_planifiee",
            "devis_envoye",
            "intervention_planifiee",
            "terminee",
            "annulee"
          ]
        }
      ],
      "description": "Le statut d'une demande doit appartenir au cycle de vie défini du suivi d'intervention.",
      "entityId": "ent_demande",
      "id": "rule_demande_statut_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_client_nom_complet",
          "operator": "required"
        },
        {
          "fieldId": "fld_client_telephone",
          "operator": "matches",
          "value": "^(\\+33|0)[1-9][0-9]{8}$"
        }
      ],
      "description": "Le nom et un numéro de téléphone français valide sont obligatoires pour rappeler le client.",
      "entityId": "ent_client",
      "id": "rule_client_contact_joignable",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_photo_fichier",
          "operator": "required"
        },
        {
          "fieldId": "fld_photo_demande",
          "operator": "required"
        }
      ],
      "description": "Chaque photo doit être rattachée à une demande et comporter un fichier image.",
      "entityId": "ent_photo",
      "id": "rule_photo_rattachee",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_demande_client",
          "operator": "required"
        },
        {
          "fieldId": "fld_demande_client",
          "operator": "eq",
          "value": "current_user_client_id"
        }
      ],
      "description": "Un utilisateur authentifié ne peut consulter et modifier que les demandes dont il est le client propriétaire.",
      "entityId": "ent_demande",
      "id": "rule_acces_demandes_du_client",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_demande_statut",
          "operator": "in",
          "value": [
            "nouvelle",
            "prise_en_charge",
            "visite_planifiee",
            "devis_envoye"
          ]
        }
      ],
      "description": "Le client ne peut modifier sa demande que tant qu'elle n'est ni terminée ni annulée.",
      "entityId": "ent_demande",
      "id": "rule_modification_demande_ouverte",
      "kind": "authorization"
    }
  ],
