        "operation": "create"
      },
      "id": "act_creer_commande",
      "name": "Créer la commande depuis le panier",
      "trigger": {
        "blockId": "blk_panier_livraison",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "capability": "payments.psp",
