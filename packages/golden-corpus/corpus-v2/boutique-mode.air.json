  "expectedTests": [
    {
      "description": "Vérifie qu'un article avec un prix nul ou négatif, ou un stock négatif, est rejeté par la règle de validation de l'entité article.",
      "id": "test_regle_prix_stock",
      "kind": "deterministic",
      "targetId": "ent_article"
    },
    {
      "description": "Vérifie qu'un code-barres non conforme au format EAN-13 (13 chiffres) est refusé et qu'un code valide est accepté sur l'entité article.",
      "id": "test_regle_code_barres_ean13",
      "kind": "deterministic",
      "targetId": "ent_article"
    },
    {
      "description": "Vérifie que seuls les statuts du cycle de vie autorisé sont acceptés pour une commande et que le total reste positif ou nul.",
      "id": "test_regle_statut_commande",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "Vérifie qu'une commande sans email valide ou sans adresse de livraison est rejetée.",
      "id": "test_regle_contact_commande",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "Vérifie qu'un client authentifié ne peut consulter que les commandes dont l'email correspond à son compte.",
      "id": "test_acces_commande_client",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "Vérifie que les articles marqués non disponibles n'apparaissent pas dans la liste du catalogue public.",
      "id": "test_articles_indisponibles_masques",
      "kind": "deterministic",
      "targetId": "scr_catalogue"
    },
    {
      "description": "Vérifie le calcul du total TTC et du nombre d'articles du panier lors de l'ajout au panier, frais de livraison inclus, y compris pour un panier vide.",
      "id": "test_slot_total_panier",
      "kind": "deterministic",
      "targetId": "act_ajouter_au_panier"
    },
    {
      "description": "Vérifie que la résolution d'un code-barres connu ouvre l'article attendu et signale l'absence de correspondance pour un code inconnu.",
      "id": "test_slot_resolution_code_barres",
      "kind": "deterministic",
      "targetId": "act_resoudre_code_barres"
    },
    {
      "description": "Vérifie que l'actualisation du suivi produit pour chaque statut le libellé français attendu et une progression cohérente entre 0 et 100.",
      "id": "test_slot_libelle_suivi",
      "kind": "deterministic",
      "targetId": "act_rafraichir_suivi"
    },
    {
      "description": "Valide le contrat du backend commandes lors de la création : schémas de requête/réponse, codes d'erreur et domaine autorisé unique.",
      "id": "test_contrat_catalogue_api",
      "kind": "contract",
      "targetId": "act_creer_commande"
    },
    {
      "description": "Valide le contrat de création d'intention de paiement carte en EUR et l'absence de tout secret côté application.",
      "id": "test_contrat_paiement_psp",
      "kind": "contract",
      "targetId": "act_payer_commande"
    },
    {
      "description": "Valide l'enregistrement de l'appareil et la réception d'une notification sur le canal suivi_commande lors d'un changement de statut.",
      "id": "test_contrat_push_suivi",
      "kind": "contract",
      "targetId": "act_notifier_changement_statut"
    },
    {
      "description": "Parcours complet : depuis le catalogue, scan d'un code-barres en magasin puis affichage de la fiche article correspondante.",
      "id": "test_e2e_scan_vers_fiche",
      "kind": "e2e",
      "targetId": "act_scanner_code_barres"
    },
    {
      "description": "Parcours complet : ajout d'un article au panier, saisie des coordonnées de livraison, création de la commande et paiement par carte.",
      "id": "test_e2e_panier_paiement",
      "kind": "e2e",
      "targetId": "act_payer_commande"
    },
    {
      "description": "Parcours complet : ouverture de l'écran Mes commandes, actualisation du suivi et affichage du statut à jour.",
      "id": "test_e2e_suivi_commande",
      "kind": "e2e",
      "targetId": "scr_commandes"
    },
    {
      "description": "Vérifie que l'état vide du panier s'affiche et que son action renvoie vers l'écran catalogue.",
      "id": "test_e2e_panier_vide",
      "kind": "e2e",
      "targetId": "act_ouvrir_catalogue"
    }
  ],
