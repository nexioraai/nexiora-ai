          },
          {
            "key": "captureMode",
            "value": "automatic"
          },
          {
            "key": "returnScreen",
            "value": "scr_commandes"
          }
        ]
      },
      "id": "act_payer_commande",
      "name": "Payer la commande par carte",
      "trigger": {
        "blockId": "blk_panier_payer",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "capability": "offline_storage",
