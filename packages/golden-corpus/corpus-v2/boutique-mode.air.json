  "network": {
    "allowedDomains": [
      "api.boutique-mode.app"
    ],
    "policy": "deny_by_default"
  },
  "permissions": [
    {
      "permission": "NSCameraUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr",
          "text": "La caméra sert à scanner le code-barres d'une étiquette en magasin pour afficher la fiche de l'article."
        }
      ],
      "requiredByCapability": "camera"
    },
    {
      "permission": "NSMicrophoneUsageDescription",
      "platform": "ios",
      "reason": [
        {
          "locale": "fr",
          "text": "Le micro est requis par le module caméra du système ; aucun enregistrement audio n'est effectué par l'application."
        }
      ],
      "requiredByCapability": "camera"
    },
    {
      "permission": "android.permission.CAMERA",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "La caméra sert à scanner le code-barres d'un article en magasin pour ouvrir sa fiche produit."
        }
      ],
      "requiredByCapability": "camera"
    },
    {
      "permission": "android.permission.RECORD_AUDIO",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "Permission liée au module caméra du système ; l'application n'enregistre aucun son."
        }
      ],
      "requiredByCapability": "camera"
    },
    {
      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "Les notifications vous informent de l'évolution du statut et de l'expédition de vos commandes."
        }
      ],
      "requiredByCapability": "push_notifications"
    }
  ],
  "projectId": "prj_boutique_mode",
  "relations": [
    {
      "fromEntityId": "ent_categorie",
      "id": "rel_categorie_articles",
      "kind": "one_to_many",
      "toEntityId": "ent_article"
    },
    {
      "fromEntityId": "ent_commande",
      "id": "rel_commande_articles",
      "kind": "many_to_many",
      "toEntityId": "ent_article"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_article_prix",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_article_stock",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Le prix d'un article doit être strictement supérieur à 0 et le stock ne peut pas être négatif.",
      "entityId": "ent_article",
      "id": "rule_article_prix_positif",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_article_code_barres",
          "operator": "required"
        },
        {
          "fieldId": "fld_article_code_barres",
          "operator": "matches",
          "value": "^[0-9]{13}$"
        }
      ],
      "description": "Le code-barres doit être un EAN-13 (13 chiffres) pour permettre le scan en magasin.",
      "entityId": "ent_article",
      "id": "rule_article_code_barres",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_statut",
          "operator": "in",
          "value": [
            "en_attente_paiement",
            "payee",
            "en_preparation",
            "expediee",
            "livree",
            "annulee"
          ]
        },
        {
          "fieldId": "fld_commande_total",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Le statut d'une commande doit appartenir au cycle de vie autorisé et le total doit être positif.",
      "entityId": "ent_commande",
      "id": "rule_commande_statut_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_email",
          "operator": "matches",
          "value": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"
        },
        {
          "fieldId": "fld_commande_adresse",
          "operator": "required"
        }
      ],
      "description": "Une commande exige un email client valide et une adresse de livraison renseignée.",
      "entityId": "ent_commande",
      "id": "rule_commande_contact",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_email",
          "operator": "required"
        },
        {
          "fieldId": "fld_commande_email",
          "operator": "eq",
          "value": "@currentUser.email"
        }
      ],
      "description": "Seul le client authentifié propriétaire de la commande (email correspondant au compte) peut consulter son suivi.",
      "entityId": "ent_commande",
      "id": "rule_commande_acces_client",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_article_disponible",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Seuls les articles marqués disponibles sont exposés au catalogue public.",
      "entityId": "ent_article",
      "id": "rule_article_visible",
      "kind": "authorization"
    }
  ],
