      },
      "id": "act_partager_article",
      "name": "Partager la fiche article",
      "trigger": {
        "blockId": "blk_article_partager",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "kind": "navigate",
        "screenId": "scr_catalogue"
      },
      "id": "act_ouvrir_catalogue",
      "name": "Ouvrir le catalogue",
      "trigger": {
        "blockId": "blk_panier_vide",
        "kind": "ui"
      }
    },
    {
      "effect": {
        "entityId": "ent_commande",
