  "slots": [
    {
      "allowedImports": [
        "air/data",
        "air/validation"
      ],
      "description": "Résout un code-barres scanné en magasin vers l'identifiant de l'article correspondant du catalogue.",
      "id": "slot_recherche_par_code_barres",
      "inputs": [
        {
          "name": "codeBarres",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "articleId",
          "type": "reference"
        },
        {
          "name": "trouve",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [
        "air/format"
      ],
      "description": "Calcule le total TTC du panier à partir des lignes (article, quantité, prix unitaire) et des frais de livraison.",
      "id": "slot_calcul_total_panier",
      "inputs": [
        {
          "name": "lignes",
          "type": "json"
        },
        {
          "name": "fraisLivraison",
          "type": "decimal"
        }
      ],
      "outputs": [
        {
          "name": "total",
          "type": "decimal"
        },
        {
          "name": "nombreArticles",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [
        "air/format",
        "air/i18n"
      ],
      "description": "Produit le libellé français et la progression affichable de l'état d'une commande.",
      "id": "slot_libelle_suivi_commande",
      "inputs": [
        {
          "name": "statut",
          "type": "enum"
        },
        {
          "name": "livraisonPrevue",
          "type": "date"
        }
      ],
      "outputs": [
        {
          "name": "libelle",
          "type": "string"
        },
        {
          "name": "progression",
          "type": "number"
        }
      ]
    }
  ]
