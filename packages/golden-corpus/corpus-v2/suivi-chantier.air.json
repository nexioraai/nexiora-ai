  "expectedTests": [
    {
      "description": "Au lancement, l'écran d'entrée affiché est la liste des chantiers avec son en-tête et sa liste rattachée à l'entité chantier.",
      "id": "test_navigation_entree_chantiers",
      "kind": "deterministic",
      "targetId": "scr_chantiers"
    },
    {
      "description": "Règle rule_chantier_avancement_borne : un chantier dont l'avancement vaut -5 ou 120 est rejeté, alors que 0, 50 et 100 sont acceptés.",
      "id": "test_regle_avancement_borne",
      "kind": "deterministic",
      "targetId": "ent_chantier"
    },
    {
      "description": "Règle rule_releve_photo_obligatoire : la création d'un relevé sans photo ou sans date de relevé est refusée par la validation.",
      "id": "test_regle_releve_photo_obligatoire",
      "kind": "deterministic",
      "targetId": "ent_releve"
    },
    {
      "description": "Règle rule_incident_description_complete : un incident sans description ou avec une gravité hors liste (par exemple « bloquant ») est rejeté.",
      "id": "test_regle_incident_description_complete",
      "kind": "deterministic",
      "targetId": "ent_incident"
    },
    {
      "description": "Règle rule_client_releves_synchronises : un client ne reçoit que les relevés dont le champ synchronise vaut true ; les brouillons locaux sont exclus.",
      "id": "test_autorisation_client_releves",
      "kind": "deterministic",
      "targetId": "ent_releve"
    },
    {
      "description": "Règle rule_client_incidents_visibles : un client ne voit que les incidents synchronisés et non au statut « ouvert ».",
      "id": "test_autorisation_client_incidents",
      "kind": "deterministic",
      "targetId": "ent_incident"
    },
    {
      "description": "Contrat du slot slot_sync_hors_ligne déclenché par l'action de synchronisation : la file locale de relevés et d'incidents est traitée et elementsRestants, synchroniseLe et conflits sont retournés.",
      "id": "test_slot_sync_hors_ligne",
      "kind": "contract",
      "targetId": "act_synchroniser_hors_ligne"
    },
    {
      "description": "Contrat du slot slot_calcul_avancement : l'action d'ouverture du chantier renvoie un avancement consolidé entre 0 et 100 et une tendance à partir de l'historique des relevés.",
      "id": "test_slot_calcul_avancement",
      "kind": "contract",
      "targetId": "act_calculer_avancement_consolide"
    },
    {
      "description": "Contrat du slot slot_preparation_photo : l'action d'optimisation retourne une image horodatée et une taille en kilo-octets inférieure à l'original.",
      "id": "test_slot_preparation_photo",
      "kind": "contract",
      "targetId": "act_optimiser_photo_releve"
    },
    {
      "description": "Contrat de l'intégration intg_offline_store via le préchargement : chantiers, relevés et incidents sont écrits puis relus sans réseau en respectant la stratégie de conflit.",
      "id": "test_integration_offline_store",
      "kind": "contract",
      "targetId": "act_precharger_donnees_hors_ligne"
    },
    {
      "description": "Contrat de l'intégration intg_auth_backend via l'action d'authentification : une session hors ligne reste valide pendant la durée configurée et l'endpoint de suppression de compte est exposé.",
      "id": "test_integration_auth_offline",
      "kind": "contract",
      "targetId": "act_authentifier_utilisateur"
    },
    {
      "description": "Parcours complet : le chef de chantier ouvre un chantier, prend une photo, enregistre un relevé sans réseau, puis la synchronisation l'envoie au retour de la connexion.",
      "id": "test_e2e_releve_photo_hors_ligne",
      "kind": "e2e",
      "targetId": "act_enregistrer_releve"
    },
    {
      "description": "Parcours complet : consignation d'un incident depuis le formulaire puis émission de la notification locale au conducteur de travaux.",
      "id": "test_e2e_declaration_incident",
      "kind": "e2e",
      "targetId": "act_enregistrer_incident"
    },
    {
      "description": "Parcours complet : un client sans réseau consulte l'avancement de son chantier et l'historique des relevés préchargés.",
      "id": "test_e2e_consultation_client_hors_ligne",
      "kind": "e2e",
      "targetId": "act_precharger_donnees_hors_ligne"
    },
    {
      "description": "Parcours complet : l'appui sur le bouton de synchronisation vide la file locale et met à jour la date de dernière synchronisation affichée.",
      "id": "test_e2e_synchronisation_manuelle",
      "kind": "e2e",
      "targetId": "act_synchroniser_hors_ligne"
    }
  ],
