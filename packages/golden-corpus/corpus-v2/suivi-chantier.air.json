  "projectId": "prj_btp_suivi_chantier",
  "relations": [
    {
      "fromEntityId": "ent_chantier",
      "id": "rel_chantier_releves",
      "kind": "one_to_many",
      "toEntityId": "ent_releve"
    },
    {
      "fromEntityId": "ent_chantier",
      "id": "rel_chantier_incidents",
      "kind": "one_to_many",
      "toEntityId": "ent_incident"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_chantier_avancement",
          "operator": "required"
        },
        {
          "fieldId": "fld_chantier_avancement",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_chantier_avancement",
          "operator": "lte",
          "value": 100
        }
      ],
      "description": "L'avancement d'un chantier est un pourcentage compris entre 0 et 100.",
      "entityId": "ent_chantier",
      "id": "rule_chantier_avancement_borne",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_chantier_statut",
          "operator": "in",
          "value": [
            "planifie",
            "en_cours",
            "suspendu",
            "receptionne"
          ]
        }
      ],
      "description": "Le statut du chantier doit appartenir à la liste autorisée.",
      "entityId": "ent_chantier",
      "id": "rule_chantier_statut_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_releve_photo",
          "operator": "required"
        },
        {
          "fieldId": "fld_releve_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_releve_avancement",
          "operator": "gte",
          "value": 0
        },
        {
          "fieldId": "fld_releve_avancement",
          "operator": "lte",
          "value": 100
        }
      ],
      "description": "Chaque relevé d'avancement doit comporter une photo, une date et un pourcentage valide.",
      "entityId": "ent_releve",
      "id": "rule_releve_photo_obligatoire",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_incident_gravite",
          "operator": "in",
          "value": [
            "mineur",
            "majeur",
            "critique"
          ]
        },
        {
          "fieldId": "fld_incident_statut",
          "operator": "in",
          "value": [
            "ouvert",
            "en_traitement",
            "resolu"
          ]
        },
        {
          "fieldId": "fld_incident_description",
          "operator": "required"
        },
        {
          "fieldId": "fld_incident_declarant",
          "operator": "required"
        }
      ],
      "description": "Un incident doit préciser sa gravité, son statut et une description détaillée.",
      "entityId": "ent_incident",
      "id": "rule_incident_description_complete",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_releve_synchronise",
          "operator": "eq",
          "value": true
        }
      ],
      "description": "Le client ne peut consulter que les relevés d'avancement validés et synchronisés avec le serveur.",
      "entityId": "ent_releve",
      "id": "rule_client_releves_synchronises",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_incident_synchronise",
          "operator": "eq",
          "value": true
        },
        {
          "fieldId": "fld_incident_statut",
          "operator": "neq",
          "value": "ouvert"
        }
      ],
      "description": "Le client ne voit que les incidents synchronisés qui ne sont pas des brouillons locaux.",
      "entityId": "ent_incident",
      "id": "rule_client_incidents_visibles",
      "kind": "authorization"
    }
  ],
