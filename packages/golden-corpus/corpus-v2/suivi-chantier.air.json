  "slots": [
    {
      "allowedImports": [
        "air/std/json",
        "air/std/date",
        "air/std/storage"
      ],
      "description": "Réconcilie la file locale des relevés et incidents créés hors ligne avec le backend, et renvoie le nombre d'éléments restants et l'horodatage de synchronisation.",
      "id": "slot_sync_hors_ligne",
      "inputs": [
        {
          "name": "chantierId",
          "type": "reference"
        },
        {
          "name": "derniereSync",
          "type": "datetime"
        },
        {
          "name": "fileLocale",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "elementsRestants",
          "type": "number"
        },
        {
          "name": "synchroniseLe",
          "type": "datetime"
        },
        {
          "name": "conflits",
          "type": "json"
        }
      ]
    },
    {
      "allowedImports": [
        "air/std/media",
        "air/std/date"
      ],
      "description": "Compresse et horodate la photo de chantier avant stockage local puis envoi différé.",
      "id": "slot_preparation_photo",
      "inputs": [
        {
          "name": "photoSource",
          "type": "asset"
        },
        {
          "name": "priseLe",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "photoOptimisee",
          "type": "asset"
        },
        {
          "name": "tailleKo",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [
        "air/std/math",
        "air/std/date"
      ],
      "description": "Calcule le pourcentage d'avancement consolidé d'un chantier à partir de l'historique des relevés.",
      "id": "slot_calcul_avancement",
      "inputs": [
        {
          "name": "chantierId",
          "type": "reference"
        },
        {
          "name": "releves",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "avancementConsolide",
          "type": "decimal"
        },
        {
          "name": "tendance",
          "type": "string"
        }
      ]
    }
  ]
