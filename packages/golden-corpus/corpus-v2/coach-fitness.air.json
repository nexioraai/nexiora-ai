      "permission": "android.permission.POST_NOTIFICATIONS",
      "platform": "android",
      "reason": [
        {
          "locale": "fr",
          "text": "Pour vous envoyer les rappels de vos séances planifiées et vous informer des nouveaux programmes vidéo publiés par votre coach."
        }
      ],
