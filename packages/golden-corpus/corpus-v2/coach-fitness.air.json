  "slots": [
    {
      "allowedImports": [],
      "description": "Calcule le statut d'abonnement affichable (essai, actif, expiré, annulé) et la date de fin de période à partir de l'état d'achat intégré restauré.",
      "id": "slot_statut_abonnement",
      "inputs": [
        {
          "name": "achatIntegre",
          "type": "json"
        },
        {
          "name": "dateReference",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "statut",
          "type": "enum"
        },
        {
          "name": "finPeriode",
          "type": "date"
        },
        {
          "name": "renouvellementAuto",
          "type": "boolean"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Agrège les séances réalisées de la semaine pour produire le nombre de séances, les minutes cumulées et le pourcentage d'objectif atteint.",
      "id": "slot_progression_hebdomadaire",
      "inputs": [
        {
          "name": "seances",
          "type": "json"
        },
        {
          "name": "objectifSeances",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "seancesRealisees",
          "type": "number"
        },
        {
          "name": "minutesCumulees",
          "type": "number"
        },
        {
          "name": "pourcentageObjectif",
          "type": "decimal"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Formate une durée en minutes en libellé lisible en français (ex. « 1 h 05 ») pour les listes de programmes et de séances.",
      "id": "slot_libelle_duree",
      "inputs": [
        {
          "name": "dureeMinutes",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "libelle",
          "type": "string"
        }
      ]
    }
  ]
