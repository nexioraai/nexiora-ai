  "projectId": "prj_coach_fit_studio",
  "relations": [
    {
      "fromEntityId": "ent_programme",
      "id": "rel_programme_seances",
      "kind": "one_to_many",
      "toEntityId": "ent_seance"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_programme_titre",
          "operator": "required"
        },
        {
          "fieldId": "fld_programme_niveau",
          "operator": "in",
          "value": [
            "debutant",
            "intermediaire",
            "avance"
          ]
        },
        {
          "fieldId": "fld_programme_duree_minutes",
          "operator": "gt",
          "value": 0
        }
      ],
      "description": "Un programme doit avoir un titre, un niveau reconnu et une durée strictement positive.",
      "entityId": "ent_programme",
      "id": "rule_programme_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_seance_programme",
          "operator": "required"
        },
        {
          "fieldId": "fld_seance_date",
          "operator": "required"
        },
        {
          "fieldId": "fld_seance_statut",
          "operator": "in",
          "value": [
            "planifiee",
            "realisee",
            "annulee"
          ]
        },
        {
          "fieldId": "fld_seance_ressenti",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_seance_ressenti",
          "operator": "lte",
          "value": 5
        }
      ],
      "description": "Une séance doit être rattachée à un programme, datée, avec un statut connu et un ressenti compris entre 1 et 5.",
      "entityId": "ent_seance",
      "id": "rule_seance_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_abonnement_produit",
          "operator": "required"
        },
        {
          "fieldId": "fld_abonnement_offre",
          "operator": "eq",
          "value": "mensuel"
        },
        {
          "fieldId": "fld_abonnement_debut_le",
          "operator": "required"
        }
      ],
      "description": "Un abonnement doit référencer un produit d'achat intégré mensuel avec une date de début renseignée.",
      "entityId": "ent_abonnement",
      "id": "rule_abonnement_coherent",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_abonnement_statut",
          "operator": "in",
          "value": [
            "essai",
            "actif"
          ]
        }
      ],
      "description": "L'accès aux programmes vidéo premium exige un abonnement en cours (essai ou actif).",
      "entityId": "ent_abonnement",
      "id": "rule_acces_contenu_premium",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_programme_premium",
          "operator": "eq",
          "value": false
        }
      ],
      "description": "Les programmes non premium restent consultables sans abonnement.",
      "entityId": "ent_programme",
      "id": "rule_programme_gratuit_visible",
      "kind": "authorization"
    }
  ],
