  "expectedTests": [
    {
      "description": "Vérifie qu'un programme sans titre, avec un niveau inconnu ou une durée nulle/négative est rejeté par la validation (règle rule_programme_valide).",
      "id": "test_rule_programme_valide",
      "kind": "deterministic",
      "targetId": "ent_programme"
    },
    {
      "description": "Vérifie qu'une séance sans programme rattaché ou sans date est refusée et qu'un ressenti hors de l'intervalle 1-5 est invalide (règle rule_seance_valide).",
      "id": "test_rule_seance_valide",
      "kind": "deterministic",
      "targetId": "ent_seance"
    },
    {
      "description": "Vérifie qu'un abonnement doit porter un produit d'achat intégré, l'offre « mensuel » et une date de début renseignée (règle rule_abonnement_coherent).",
      "id": "test_rule_abonnement_coherent",
      "kind": "deterministic",
      "targetId": "ent_abonnement"
    },
    {
      "description": "Vérifie que l'accès aux programmes premium est autorisé uniquement pour un abonnement en essai ou actif, et refusé si expiré ou annulé (règle rule_acces_contenu_premium).",
      "id": "test_rule_acces_contenu_premium",
      "kind": "deterministic",
      "targetId": "act_verifier_statut_abonnement"
    },
    {
      "description": "Vérifie que les programmes non premium restent consultables sans abonnement actif depuis le catalogue (règle rule_programme_gratuit_visible).",
      "id": "test_rule_programme_gratuit_visible",
      "kind": "deterministic",
      "targetId": "scr_programmes"
    },
    {
      "description": "Vérifie que le slot slot_statut_abonnement déduit correctement le statut (essai, actif, expiré, annulé), la fin de période et le renouvellement automatique à partir d'un état d'achat intégré restauré.",
      "id": "test_slot_statut_abonnement",
      "kind": "deterministic",
      "targetId": "act_verifier_statut_abonnement"
    },
    {
      "description": "Vérifie l'agrégation du slot slot_progression_hebdomadaire : nombre de séances réalisées, minutes cumulées et pourcentage d'objectif atteint.",
      "id": "test_slot_progression_hebdomadaire",
      "kind": "deterministic",
      "targetId": "act_calculer_progression"
    },
    {
      "description": "Vérifie le formatage français des durées affichées dans les listes via slot_libelle_duree (ex. 65 → « 1 h 05 », 45 → « 45 min »).",
      "id": "test_slot_libelle_duree",
      "kind": "deterministic",
      "targetId": "scr_programmes"
    },
    {
      "description": "Contrat d'achat intégré : la souscription au produit mensuel renvoie un état d'entitlement exploitable et la validation de reçu est appelée sur le domaine autorisé.",
      "id": "test_contract_iap_abonnement",
      "kind": "contract",
      "targetId": "act_souscrire_abonnement"
    },
    {
      "description": "Contrat d'authentification : restauration de session au démarrage, connexion par email OTP/Apple/Google et disponibilité de la suppression de compte.",
      "id": "test_contract_auth_session",
      "kind": "contract",
      "targetId": "act_authentifier_utilisateur"
    },
    {
      "description": "Contrat de notifications : enregistrement de l'appareil et programmation d'un rappel local sur le canal « rappels_seances ».",
      "id": "test_contract_push_rappels",
      "kind": "contract",
      "targetId": "act_rappel_seance_planifiee"
    },
    {
      "description": "Contrat de stockage hors-ligne : écriture chiffrée de l'abonnement et respect de la limite de taille de cache configurée.",
      "id": "test_contract_cache_local",
      "kind": "contract",
      "targetId": "act_maj_abonnement_local"
    },
    {
      "description": "Parcours complet : depuis le catalogue, ouvrir l'écran d'abonnement, souscrire à l'offre mensuelle et constater le déblocage des programmes premium.",
      "id": "test_e2e_souscription_abonnement",
      "kind": "e2e",
      "targetId": "act_souscrire_abonnement"
    },
    {
      "description": "Sans abonnement actif, l'écran de détail affiche l'état verrouillé et la lecture vidéo redirige vers l'offre d'abonnement.",
      "id": "test_e2e_lecture_video_verrouillee",
      "kind": "e2e",
      "targetId": "scr_programme_detail"
    },
    {
      "description": "Parcours de suivi : enregistrer une séance depuis le formulaire, la retrouver dans l'historique et vérifier la programmation du rappel.",
      "id": "test_e2e_enregistrer_seance",
      "kind": "e2e",
      "targetId": "act_enregistrer_seance"
    },
    {
      "description": "Parcours de restauration : appuyer sur « Restaurer mes achats » recalcule le statut d'abonnement affiché sur l'écran dédié.",
      "id": "test_e2e_restauration_achats",
      "kind": "e2e",
      "targetId": "scr_abonnement"
    }
  ],
