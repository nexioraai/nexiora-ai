  "slots": [
    {
      "allowedImports": [],
      "description": "Calcule le montant total d'une commande à partir du prix unitaire du panier, de la quantité et des frais de livraison applicables.",
      "id": "slot_calcul_montant_commande",
      "inputs": [
        {
          "name": "prixUnitaire",
          "type": "decimal"
        },
        {
          "name": "quantite",
          "type": "number"
        },
        {
          "name": "codePostal",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "montantTotal",
          "type": "decimal"
        },
        {
          "name": "fraisLivraison",
          "type": "decimal"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Génère une référence de commande lisible et unique à partir de la date de commande.",
      "id": "slot_generation_reference",
      "inputs": [
        {
          "name": "dateCommande",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "reference",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Vérifie que la position de l'adresse saisie appartient à la zone de livraison et estime la distance depuis le dépôt.",
      "id": "slot_zone_livraison",
      "inputs": [
        {
          "name": "latitude",
          "type": "decimal"
        },
        {
          "name": "longitude",
          "type": "decimal"
        }
      ],
      "outputs": [
        {
          "name": "eligible",
          "type": "boolean"
        },
        {
          "name": "distanceKm",
          "type": "decimal"
        },
        {
          "name": "messageZone",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Produit le libellé français du statut de commande et le texte de la notification envoyée à la livraison.",
      "id": "slot_libelle_statut_livraison",
      "inputs": [
        {
          "name": "statut",
          "type": "enum"
        },
        {
          "name": "dateLivraisonPrevue",
          "type": "date"
        },
        {
          "name": "creneau",
          "type": "enum"
        }
      ],
      "outputs": [
        {
          "name": "libelleStatut",
          "type": "string"
        },
        {
          "name": "messageNotification",
          "type": "string"
        }
      ]
    }
  ]
