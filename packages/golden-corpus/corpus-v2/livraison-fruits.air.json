  "expectedTests": [
    {
      "description": "L'écran d'accueil affiche les paniers de la semaine (bloc blk_liste_paniers) avec nom, description, prix et badge de taille depuis le dataset initial.",
      "id": "test_paniers_liste_affichage",
      "kind": "deterministic",
      "targetId": "scr_paniers_semaine"
    },
    {
      "description": "Quand aucun panier n'est disponible, l'état vide s'affiche et son bouton déclenche l'actualisation des paniers.",
      "id": "test_paniers_etat_vide",
      "kind": "deterministic",
      "targetId": "act_rafraichir_paniers"
    },
    {
      "description": "L'écran de détail présente le nom, la composition, le prix et les badges taille/semaine du panier sélectionné.",
      "id": "test_panier_detail_entete",
      "kind": "deterministic",
      "targetId": "scr_panier_detail"
    },
    {
      "description": "Un panier avec un prix nul ou négatif, ou sans nom, est rejeté par la règle de validation rule_panier_prix_positif.",
      "id": "test_regle_prix_panier",
      "kind": "deterministic",
      "targetId": "ent_panier"
    },
    {
      "description": "Un stock disponible négatif est refusé (rule_panier_stock) et un panier à stock zéro n'est pas commandable.",
      "id": "test_regle_stock_panier",
      "kind": "deterministic",
      "targetId": "ent_panier"
    },
    {
      "description": "Le code postal doit comporter 5 chiffres, la ville être renseignée et le téléphone respecter le format français (rule_adresse_valide).",
      "id": "test_regle_adresse_valide",
      "kind": "deterministic",
      "targetId": "ent_adresse"
    },
    {
      "description": "Une commande sans adresse, avec quantité inférieure à 1 ou montant nul est refusée (rule_commande_valide).",
      "id": "test_regle_commande_valide",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "Une commande de plus de 5 paniers identiques est rejetée (rule_commande_quantite_max).",
      "id": "test_regle_quantite_max",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "L'annulation est refusée dès que la commande est en livraison ou livrée (rule_commande_annulation).",
      "id": "test_regle_annulation",
      "kind": "deterministic",
      "targetId": "ent_commande"
    },
    {
      "description": "Le calcul du montant total (slot_calcul_montant_commande) combine correctement prix unitaire, quantité et frais de livraison selon le code postal.",
      "id": "test_slot_montant_total",
      "kind": "deterministic",
      "targetId": "act_calculer_montant_commande"
    },
    {
      "description": "La création de commande produit une référence lisible et unique pour deux commandes créées le même jour (slot_generation_reference).",
      "id": "test_slot_reference_unique",
      "kind": "deterministic",
      "targetId": "act_creer_commande"
    },
    {
      "description": "Une position hors zone renvoie eligible=false avec un message explicite, une position dans la zone renvoie une distance cohérente (slot_zone_livraison).",
      "id": "test_slot_zone_livraison",
      "kind": "deterministic",
      "targetId": "act_verifier_zone_livraison"
    },
    {
      "description": "Chaque statut de commande produit le libellé français attendu et le message de notification de livraison (slot_libelle_statut_livraison).",
      "id": "test_slot_libelle_statut",
      "kind": "deterministic",
      "targetId": "act_libelle_statut_livraison"
    },
    {
      "description": "La soumission du formulaire d'adresse crée une adresse de livraison persistée.",
      "id": "test_form_adresse_creation",
      "kind": "deterministic",
      "targetId": "act_enregistrer_adresse"
    },
    {
      "description": "Le bouton de position récupère les coordonnées de l'appareil et alimente latitude/longitude de l'adresse.",
      "id": "test_position_prefill",
      "kind": "e2e",
      "targetId": "act_localiser_adresse"
    },
    {
      "description": "Parcours complet : sélection d'un panier, saisie de l'adresse, validation de la commande puis paiement carte aboutissant au statut payee.",
      "id": "test_parcours_commande_paiement",
      "kind": "e2e",
      "targetId": "act_payer_commande"
    },
    {
      "description": "Le passage du statut de commande à livree déclenche la notification de dépôt du panier.",
      "id": "test_notification_livraison",
      "kind": "e2e",
      "targetId": "act_notifier_livraison"
    },
    {
      "description": "Le bouton d'alerte livraison demande la permission de notification et abonne au sujet suivi_livraison.",
      "id": "test_activation_notifications",
      "kind": "e2e",
      "targetId": "act_activer_notifications_livraison"
    },
    {
      "description": "L'écran Mes commandes affiche référence, date de livraison prévue, montant et badge de statut.",
      "id": "test_mes_commandes_suivi",
      "kind": "e2e",
      "targetId": "scr_mes_commandes"
    },
    {
      "description": "Le contrat de checkout PSP (intg_paiement_carte) respecte devise EUR, méthode carte et retourne un statut de paiement exploitable.",
      "id": "test_contrat_paiement_psp",
      "kind": "contract",
      "targetId": "act_payer_commande"
    },
    {
      "description": "Les endpoints paniers, adresses et commandes de l'API (intg_api_commandes) respectent les schémas des entités déclarées.",
      "id": "test_contrat_api_commandes",
      "kind": "contract",
      "targetId": "act_creer_commande"
    },
    {
      "description": "L'enregistrement d'appareil et l'envoi sur le sujet suivi_livraison respectent le contrat du fournisseur push (intg_push_livraison).",
      "id": "test_contrat_push",
      "kind": "contract",
      "targetId": "act_notifier_livraison"
    },
    {
      "description": "Le flux email OTP et la suppression de compte respectent le contrat du fournisseur d'authentification (intg_auth_backend).",
      "id": "test_contrat_auth",
      "kind": "contract",
      "targetId": "act_authentifier_client"
    },
    {
      "description": "La synchronisation hors-ligne des paniers, adresses et commandes respecte le contrat de l'endpoint de sync (intg_stockage_hors_ligne).",
      "id": "test_contrat_sync_offline",
      "kind": "contract",
      "targetId": "act_charger_paniers"
    }
  ],
