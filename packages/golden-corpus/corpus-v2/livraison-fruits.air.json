  "projectId": "prj_paniers_frais",
  "relations": [
    {
      "fromEntityId": "ent_panier",
      "id": "rel_panier_commandes",
      "kind": "one_to_many",
      "toEntityId": "ent_commande"
    },
    {
      "fromEntityId": "ent_adresse",
      "id": "rel_adresse_commandes",
      "kind": "one_to_many",
      "toEntityId": "ent_commande"
    }
  ],
  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_panier_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_panier_prix",
          "operator": "gt",
          "value": 0
        }
      ],
      "description": "Le prix d'un panier doit être strictement supérieur à zéro et le panier doit porter un nom.",
      "entityId": "ent_panier",
      "id": "rule_panier_prix_positif",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_panier_stock",
          "operator": "gte",
          "value": 0
        }
      ],
      "description": "Le stock disponible ne peut pas être négatif ; un panier sans stock n'est pas proposé à la commande.",
      "entityId": "ent_panier",
      "id": "rule_panier_stock",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_adresse_code_postal",
          "operator": "matches",
          "value": "^[0-9]{5}$"
        },
        {
          "fieldId": "fld_adresse_ville",
          "operator": "required"
        },
        {
          "fieldId": "fld_adresse_telephone",
          "operator": "matches",
          "value": "^(\\+33|0)[1-9][0-9]{8}$"
        }
      ],
      "description": "L'adresse de livraison doit comporter un code postal français à 5 chiffres, une ville et un téléphone de contact.",
      "entityId": "ent_adresse",
      "id": "rule_adresse_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_quantite",
          "operator": "gte",
          "value": 1
        },
        {
          "fieldId": "fld_commande_montant_total",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_commande_statut",
          "operator": "in",
          "value": [
            "en_attente_paiement",
            "payee",
            "en_preparation",
            "en_livraison",
            "livree",
            "annulee"
          ]
        },
        {
          "fieldId": "fld_commande_adresse",
          "operator": "required"
        }
      ],
      "description": "Une commande porte au moins un panier, un montant total positif et un statut connu.",
      "entityId": "ent_commande",
      "id": "rule_commande_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_quantite",
          "operator": "lte",
          "value": 5
        }
      ],
      "description": "Un client ne peut pas commander plus de 5 paniers identiques par semaine.",
      "entityId": "ent_commande",
      "id": "rule_commande_quantite_max",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_reference",
          "operator": "required"
        }
      ],
      "description": "Un client authentifié n'accède qu'à ses propres commandes, identifiées par leur référence.",
      "entityId": "ent_commande",
      "id": "rule_commande_acces_client",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_commande_statut",
          "operator": "in",
          "value": [
            "en_attente_paiement",
            "payee",
            "en_preparation"
          ]
        }
      ],
      "description": "L'annulation par le client n'est autorisée que tant que la commande n'est pas en livraison ou livrée.",
      "entityId": "ent_commande",
      "id": "rule_commande_annulation",
      "kind": "authorization"
    }
  ],
