export function generatePrismaSchema(erp: any) {

let schema = `
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}
`

erp.modules.forEach((module: any) => {

const fields = module.fields
.map((field: string) =>
`${field} String?`
)
.join('\n')

const relations = (module.relations || [])
.map((r: any) => {

const relationName =
r.field.replace('_id', '')

return `
${relationName} ${r.target}? @relation(fields: [${r.field}], references: [id])
`
})
.join('\n')

schema += `
model ${module.name} {
id String @id @default(cuid())

${fields}

${relations}

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}
`
})

return schema
}
