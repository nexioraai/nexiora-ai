// src/app/sites/[slug]/themes/BoldTheme.tsx
import Image from 'next/image'
import Link from 'next/link'
import { Bricolage_Grotesque, Inter_Tight } from 'next/font/google'
import {
  Phone,
  Mail,
  MapPin,
  Star,
  ArrowUpRight,
  Asterisk,
} from 'lucide-react'
import { Instagram, Facebook, TikTok, WhatsApp } from './BrandIcons'
import MobileNav from './MobileNav'
import ContactForm from '../ContactForm'
import { type Site, normalizeService, normalizeTestimonial, normalizeProduct } from './shared'
import { getDict } from './i18n'

const bricolage = Bricolage_Grotesque({
  subsets: ['latin'],
  weight: ['400', '600', '700', '800'],
  variable: '--font-bricolage',
})
const interTight = Inter_Tight({
  subsets: ['latin'],
  weight: ['400', '500', '600'],
  variable: '--font-inter-tight',
})

export default function BoldTheme({ site }: { site: Site }) {
  const primary = site.primary_color || '#FF3B1F'
  const t = getDict(site.lang)
  const services = (site.services || []).map(normalizeService)
  const testimonials = (site.testimonials || []).map(normalizeTestimonial)
  const products = (site.products || []).map(normalizeProduct)
  const gallery: string[] = (site.gallery || []).filter((u: any) => typeof u === 'string' && u.length > 0 && u.startsWith('http'))
  const contact = site.contact || {}
  const social = site.social_links || {}
  const cta = site.cta || 'Contactez-nous'
  const ctaHref = products.length > 0 ? '#shop' : '#contact'

  // Words for the marquee — uses slogan if present, otherwise generic
  const marqueeWords = (site.slogan
    ? site.slogan.split(/[•·,—-]+/).map((s) => s.trim()).filter(Boolean)
    : ['Authentic', 'Trusted', 'Premium', 'Local', 'Fast']
  ).slice(0, 6)

  return (
    <div
      className={`${bricolage.variable} ${interTight.variable} min-h-screen bg-white text-black antialiased`}
      style={{
        ['--brand' as any]: primary,
        fontFamily: 'var(--font-inter-tight), system-ui, sans-serif',
      }}
    >
      {/* =================== HEADER =================== */}
      <header className="sticky top-0 z-50 bg-white border-b-[3px] border-black">
        <div className="max-w-7xl mx-auto px-6 md:px-10 h-20 flex items-center justify-between">
          <Link
            href={`/sites/${site.slug}`}
            className="text-3xl md:text-4xl tracking-tighter leading-none"
            style={{ fontFamily: 'var(--font-bricolage), system-ui, sans-serif', fontWeight: 800 }}
          >
            {site.name.toUpperCase()}
          </Link>
          <nav className="hidden md:flex items-center gap-8">
            <a href="#home" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.home}</a>
            <a href="#about" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.about}</a>
            <a href="#services" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.services}</a>
            {products.length > 0 && (
              <a href="#shop" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.shop}</a>
            )}
            <a href="#gallery" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.bold.navWork}</a>
            <a href="#testimonials" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.reviews}</a>
            <a href="#contact" className="text-xs uppercase tracking-[0.2em] font-medium hover:opacity-60 transition-opacity">{t.nav.contact}</a>
            <a
              href={ctaHref}
              className="group relative inline-flex items-center gap-2 px-6 py-3 bg-black text-white text-sm font-medium uppercase tracking-wider transition-all"
            >
              <span className="absolute inset-0 translate-x-0 translate-y-0 group-hover:-translate-x-1 group-hover:-translate-y-1 transition-transform" style={{ backgroundColor: primary }} />
              <span className="relative">{cta}</span>
              <ArrowUpRight className="w-4 h-4 relative" />
            </a>
          </nav>
        </div>
      </header>

      {/* Mobile Navigation */}
      <MobileNav site={site} cta={cta} ctaHref={ctaHref} />

      {/* =================== MARQUEE =================== */}
      <div className="border-b-[3px] border-black bg-white py-4 overflow-hidden">
        <div className="flex gap-12 animate-[marquee_30s_linear_infinite] whitespace-nowrap">
          {[...marqueeWords, ...marqueeWords, ...marqueeWords, ...marqueeWords].map((w, i) => (
            <div key={i} className="flex items-center gap-12 shrink-0">
              <Asterisk className="w-6 h-6" style={{ color: primary }} />
              <span
                className="text-xl md:text-2xl uppercase tracking-tight"
                style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700 }}
              >
                {w}
              </span>
            </div>
          ))}
        </div>
        <style>{`
          @keyframes marquee {
            from { transform: translateX(0); }
            to   { transform: translateX(-50%); }
          }
        `}</style>
      </div>

      {/* =================== HERO =================== */}
      <main>
      <section id="home" className="relative overflow-hidden border-b-[3px] border-black">
        {site.hero_image && (
          <>
            <Image src={site.hero_image} alt="" fill priority sizes="100vw" className="object-cover" />
            <div className="absolute inset-0 bg-black/55" />
          </>
        )}

        <div className="relative max-w-7xl mx-auto px-6 md:px-10 py-24 md:py-36">
          <div className="grid md:grid-cols-12 gap-8 items-end">
            <div className="md:col-span-9">
              {site.slogan && (
                <div
                  className="inline-block mb-8 px-4 py-2 rotate-[-2deg] border-[3px] border-black bg-white text-sm uppercase tracking-widest font-semibold"
                  style={{ fontFamily: 'var(--font-bricolage)' }}
                >
                  ★ {site.slogan}
                </div>
              )}
              <h1
                className={`text-4xl sm:text-5xl md:text-8xl lg:text-[10rem] leading-[0.85] tracking-tighter ${site.hero_image ? 'text-white' : 'text-black'}`}
                style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
              >
                {(site.hero_title || site.name).toUpperCase()}
              </h1>
              {site.hero_subtitle && (
                <p className={`mt-8 max-w-2xl text-xl md:text-2xl leading-snug ${site.hero_image ? 'text-white/85' : 'text-black/70'}`}>
                  {site.hero_subtitle}
                </p>
              )}
            </div>
            <div className="md:col-span-3 flex md:justify-end">
              <a
                href={ctaHref}
                className="group relative inline-flex items-center gap-3 px-6 sm:px-8 py-4 sm:py-5 bg-black text-white uppercase tracking-wider font-semibold text-sm sm:text-base whitespace-normal sm:whitespace-nowrap"
              >
                <span
                  className="absolute inset-0 translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform"
                  style={{ backgroundColor: primary }}
                />
                <span className="relative flex items-center gap-3">
                  {cta}
                  <ArrowUpRight className="w-5 h-5" />
                </span>
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* =================== ABOUT =================== */}
      {site.about && (
        <section id="about" className="border-b-[3px] border-black" style={{ backgroundColor: primary }}>
          <div className="max-w-7xl mx-auto px-6 md:px-10 py-24 md:py-32">
            <div className="grid md:grid-cols-[auto_1fr] gap-12 md:gap-20 items-start">
              <div
                className="text-[10rem] md:text-[14rem] leading-[0.8] tracking-tighter text-black/90"
                style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
              >
                01
              </div>
              <div className="pt-6 md:pt-12">
                <div className="text-xs uppercase tracking-[0.3em] font-bold mb-6 text-black/70">
                  ★ {t.bold.aboutKicker}
                </div>
                <h2
                  className="text-4xl md:text-6xl leading-[0.95] tracking-tight mb-10 text-black"
                  style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700 }}
                >
                  {site.hero_title ? t.bold.aboutTitle : `${site.name}.`}
                </h2>
                <p className="text-lg md:text-2xl leading-relaxed text-black/85 max-w-2xl">
                  {site.about}
                </p>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* =================== SERVICES (numbered rows) =================== */}
      {services.length > 0 && (
        <section id="services" className="border-b-[3px] border-black bg-white">
          <div className="max-w-7xl mx-auto px-6 md:px-10 pt-24 md:pt-32 pb-8">
            <div className="flex items-end justify-between mb-16 flex-wrap gap-6">
              <div>
                <div className="text-xs uppercase tracking-[0.3em] font-bold mb-4" style={{ color: primary }}>
                  ★ {t.bold.servicesKicker}
                </div>
                <h2
                  className="text-5xl md:text-7xl leading-[0.9] tracking-tighter"
                  style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
                >
                  {t.bold.servicesTitle}
                </h2>
              </div>
              <div className="text-sm font-medium text-black/60">
                {String(services.length).padStart(2, '0')} {t.bold.servicesCount}
              </div>
            </div>
          </div>

          <div>
            {services.map((s, i) => {
              const Icon = s.Icon
              return (
                <a
                  key={i}
                  href="#contact"
                  className="group block border-t-[3px] border-black hover:bg-black hover:text-white transition-colors"
                >
                  <div className="max-w-7xl mx-auto px-6 md:px-10 py-8 md:py-10">
                    <div className="grid md:grid-cols-[100px_1fr_auto_60px] gap-6 md:gap-10 items-center">
                      <div
                        className="text-4xl md:text-5xl tracking-tighter group-hover:translate-x-2 transition-transform"
                        style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700, color: primary }}
                      >
                        {String(i + 1).padStart(2, '0')}
                      </div>
                      <div>
                        <h3
                          className="text-3xl md:text-5xl tracking-tight leading-none mb-2"
                          style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700 }}
                        >
                          {s.title}
                        </h3>
                      </div>
                      <div className="text-base md:text-lg max-w-md md:text-right opacity-80 leading-snug">
                        {s.description}
                      </div>
                      <div className="flex justify-end">
                        <div
                          className="w-14 h-14 flex items-center justify-center border-[3px] border-current group-hover:rotate-45 transition-transform"
                        >
                          <Icon className="w-6 h-6" />
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              )
            })}
          </div>
        </section>
      )}

      {/* =================== SHOP =================== */}
      {products.length > 0 && (
        <section id="shop" className="border-b-[3px] border-black bg-white py-24 md:py-32">
          <div className="max-w-7xl mx-auto px-6 md:px-10">
            <div className="flex items-end justify-between mb-16 flex-wrap gap-6">
              <div>
                <div className="text-xs uppercase tracking-[0.3em] font-bold mb-4" style={{ color: primary }}>
                  ★ {t.bold.shopKicker}
                </div>
                <h2
                  className="text-5xl md:text-7xl leading-[0.9] tracking-tighter"
                  style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
                >
                  {t.bold.shopTitle}
                </h2>
              </div>
              <div className="text-sm font-medium text-black/60">
                {String(products.length).padStart(2, '0')} {t.bold.shopCount}
              </div>
            </div>

            <div className="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
              {products.map((p, i) => (
                <div key={i} className="group relative">
                  <div
                    className="absolute inset-0 translate-x-3 translate-y-3 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform"
                    style={{ backgroundColor: primary }}
                  />
                  <div className="relative border-[3px] border-black bg-white flex flex-col h-full">
                    <div className="aspect-square relative overflow-hidden bg-neutral-100 border-b-[3px] border-black">
                      {p.image ? (
                        <Image
                          src={p.image}
                          alt={p.name}
                          fill
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw"
                          className="object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      ) : (
                        <div
                          className="w-full h-full flex items-center justify-center text-6xl tracking-tighter"
                          style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800, color: primary }}
                        >
                          {p.name.charAt(0).toUpperCase()}
                        </div>
                      )}
                    </div>
                    <div className="p-5 flex flex-col flex-1">
                      <h3
                        className="text-xl leading-tight tracking-tight mb-2"
                        style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700 }}
                      >
                        {p.name.toUpperCase()}
                      </h3>
                      {p.description && (
                        <p className="text-sm text-black/70 mb-4 line-clamp-2 flex-1">
                          {p.description}
                        </p>
                      )}
                      <div className="flex items-center justify-between pt-3 border-t-[2px] border-black mt-auto">
                        {p.price ? (
                          <span
                            className="text-2xl tracking-tight"
                            style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800, color: primary }}
                          >
                            {p.price}
                          </span>
                        ) : (
                          <span className="text-xs uppercase tracking-widest font-bold text-black/50">{t.bold.onQuote}</span>
                        )}
                        <a
                          href="#contact"
                          className="inline-flex items-center gap-1 text-xs uppercase tracking-widest font-bold hover:gap-2 transition-all"
                        >
                          {t.bold.order}
                          <ArrowUpRight className="w-4 h-4" />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* =================== GALLERY =================== */}
      {gallery.length > 0 && (
        <section id="gallery" className="border-b-[3px] border-black bg-white py-24 md:py-32 overflow-hidden">
          <div className="max-w-7xl mx-auto px-6 md:px-10 mb-16">
            <div className="text-xs uppercase tracking-[0.3em] font-bold mb-4" style={{ color: primary }}>
              ★ {t.bold.galleryKicker}
            </div>
            <h2
              className="text-5xl md:text-7xl leading-[0.9] tracking-tighter"
              style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
            >
              {t.bold.galleryTitle}
            </h2>
          </div>

          <div className="px-6 md:px-10">
            <div className="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8 max-w-7xl mx-auto">
              {gallery.slice(0, 9).map((url, i) => (
                <div key={i} className="relative group">
                  <div
                    className="absolute inset-0 translate-x-3 translate-y-3 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform"
                    style={{ backgroundColor: primary }}
                  />
                  <div
                    className="relative border-[3px] border-black overflow-hidden"
                    style={{ aspectRatio: i % 4 === 0 ? '1 / 1' : '3 / 4' }}
                  >
                    <Image src={url} alt="" fill sizes="(max-width: 768px) 50vw, 33vw" className="object-cover transition-transform duration-700 group-hover:scale-105" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* =================== TESTIMONIALS =================== */}
      {testimonials.length > 0 && (
        <section id="testimonials" className="border-b-[3px] border-black bg-black text-white py-24 md:py-32">
          <div className="max-w-7xl mx-auto px-6 md:px-10">
            <div className="text-center mb-20">
              <div className="text-xs uppercase tracking-[0.3em] font-bold mb-4" style={{ color: primary }}>
                ★ {t.bold.testimonialsKicker}
              </div>
              <h2
                className="text-5xl md:text-7xl leading-[0.9] tracking-tighter"
                style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
              >
                {t.bold.testimonialsTitle}
              </h2>
            </div>

            <div className="grid md:grid-cols-3 gap-6">
              {testimonials.slice(0, 3).map((t, i) => (
                <div
                  key={i}
                  className="relative border-[3px] border-white p-8 md:p-10"
                >
                  <div
                    className="absolute -top-6 -left-2 text-9xl leading-none"
                    style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800, color: primary }}
                  >
                    "
                  </div>
                  <div className="flex gap-1 mb-6 pt-4">
                    {Array.from({ length: 5 }).map((_, k) => (
                      <Star
                        key={k}
                        className="w-5 h-5"
                        fill={k < t.rating ? primary : 'transparent'}
                        style={{ color: primary }}
                      />
                    ))}
                  </div>
                  <p className="text-xl md:text-2xl leading-snug mb-8" style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 500 }}>
                    {t.content}
                  </p>
                  <div className="pt-6 border-t-[2px] border-white/20">
                    <div className="uppercase tracking-wider text-sm font-bold">{t.name}</div>
                    {t.role && <div className="text-xs uppercase tracking-wider text-white/50 mt-1">{t.role}</div>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {site.faq && site.faq.length > 0 && (
        <section id="faq" className="border-b-[3px] border-black bg-white py-24 md:py-32">
          <div className="max-w-4xl mx-auto px-6 md:px-10">
            <h2 className="text-5xl md:text-7xl uppercase mb-16 leading-none" style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}>
              {({ fr: 'Questions fréquentes', en: 'FAQ', es: 'Preguntas frecuentes', ar: 'الأسئلة الشائعة' } as Record<string, string>)[site.lang || 'en'] || 'FAQ'}
            </h2>
            <div className="space-y-0">
              {site.faq.map((item, i) => (
                <details key={i} className="group border-t-[3px] border-black py-6">
                  <summary className="cursor-pointer list-none flex justify-between items-center text-xl md:text-2xl uppercase" style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 700 }}>
                    {item.question}
                    <span className="ml-4 transition-transform group-open:rotate-45" style={{ color: primary }}>+</span>
                  </summary>
                  <p className="mt-4 text-lg leading-relaxed" style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 400 }}>{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* =================== CONTACT =================== */}
      <section id="contact" className="border-b-[3px] border-black bg-white">
        {/* Top info strip */}
        <div className="border-b-[3px] border-black" style={{ backgroundColor: primary }}>
          <div className="max-w-7xl mx-auto px-6 md:px-10 py-6 flex flex-wrap gap-x-10 gap-y-3 items-center justify-between">
            {contact.phone && (
              <a href={`tel:${contact.phone}`} className="flex items-center gap-3 text-black hover:opacity-70 transition-opacity">
                <Phone className="w-5 h-5" />
                <span className="font-semibold">{contact.phone}</span>
              </a>
            )}
            {contact.email && (
              <a href={`mailto:${contact.email}`} className="flex items-center gap-3 text-black hover:opacity-70 transition-opacity">
                <Mail className="w-5 h-5" />
                <span className="font-semibold">{contact.email}</span>
              </a>
            )}
            {contact.address && (
              <div className="flex items-center gap-3 text-black">
                <MapPin className="w-5 h-5" />
                <span className="font-semibold">{contact.address}</span>
              </div>
            )}
          </div>
        </div>

        <div className="max-w-7xl mx-auto px-6 md:px-10 py-24 md:py-32">
          <div className="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
            <div>
              <div className="text-xs uppercase tracking-[0.3em] font-bold mb-4" style={{ color: primary }}>
                ★ {t.bold.contactKicker}
              </div>
              <h2
                className="text-5xl md:text-7xl leading-[0.9] tracking-tighter mb-8"
                style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
              >
                {t.bold.contactTitle1}<br />{t.bold.contactTitle2}
              </h2>
              <p className="text-xl text-black/70 mb-10 max-w-md">
                {t.bold.contactSubtitle}
              </p>

              {/* Socials */}
              {(social.instagram || social.facebook || social.whatsapp || social.tiktok) && (
                <div className="flex gap-3 flex-wrap">
                  {social.instagram && (
                    <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" className="w-12 h-12 border-[3px] border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">
                      <Instagram className="w-5 h-5" />
                    </a>
                  )}
                  {social.facebook && (
                    <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" className="w-12 h-12 border-[3px] border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">
                      <Facebook className="w-5 h-5" />
                    </a>
                  )}
                  {social.tiktok && (
                    <a href={social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" className="w-12 h-12 border-[3px] border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">
                      <TikTok className="w-5 h-5" />
                    </a>
                  )}
                  {social.whatsapp && (
                    <a href={`https://wa.me/${String(social.whatsapp).replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" className="w-12 h-12 border-[3px] border-black flex items-center justify-center hover:bg-[#25D366] hover:text-white hover:border-[#25D366] transition-colors">
                      <WhatsApp className="w-5 h-5" />
                    </a>
                  )}
                </div>
              )}
            </div>

            <div className="border-[3px] border-black bg-white p-8 md:p-10">
              <ContactForm slug={site.slug} brand={primary} lang={site.lang} />
            </div>
          </div>
        </div>
      </section>

      </main>
      {/* =================== FOOTER =================== */}
      <footer className="bg-black text-white pt-24 pb-10">
        <div className="max-w-7xl mx-auto px-6 md:px-10">
          <div
            className="text-[15vw] md:text-[12vw] leading-[0.85] tracking-tighter mb-12"
            style={{ fontFamily: 'var(--font-bricolage)', fontWeight: 800 }}
          >
            {site.name.toUpperCase()}.
          </div>
          <div className="pt-8 border-t-[2px] border-white/20 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm">
            <div className="text-white/60 uppercase tracking-wider">
              © {new Date().getFullYear()} {site.name}. {t.labels.rightsReserved}
            </div>
            <div className="flex items-center gap-2 text-white/60 uppercase tracking-wider">
              <span>{t.labels.poweredBy}</span>
              <a href="https://nexiora.ca" target="_blank" rel="noopener noreferrer" className="font-bold text-white hover:opacity-70 transition-opacity">
                Nexiora ↗
              </a>
            </div>
          </div>
        </div>
      </footer>

      {/* Floating WhatsApp */}
      {social.whatsapp && (
        <a
          href={`https://wa.me/${String(social.whatsapp).replace(/\D/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          className="fixed bottom-6 right-6 z-40 w-14 h-14 flex items-center justify-center bg-[#25D366] text-white border-[3px] border-black hover:scale-110 transition-transform"
        >
          <WhatsApp className="w-7 h-7" />
        </a>
      )}
    </div>
  )
}
