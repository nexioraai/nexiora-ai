'use client';

import { useState } from 'react';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

export default function ContactForm({
  slug,
  color,
}: {
  slug: string;
  color: string;
}) {
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [message, setMessage] = useState('');
  const [status, setStatus] = useState<
    'idle' | 'sending' | 'sent' | 'error'
  >('idle');

  const handleSubmit = async () => {
    if (!name || !email || !message) {
      setStatus('error');
      return;
    }
    setStatus('sending');
    const { error } = await supabase.from('messages').insert({
      site_slug: slug,
      name,
      email,
      message,
    });
    if (error) {
      console.error(error);
      setStatus('error');
    } else {
      setStatus('sent');
      setName('');
      setEmail('');
      setMessage('');
    }
  };

  if (status === 'sent') {
    return (
      <div
        style={{
          maxWidth: '640px',
          margin: '0 auto 3rem',
          background: '#f0fdf4',
          border: '2px solid #86efac',
          borderRadius: '24px',
          padding: '3rem 2.5rem',
          textAlign: 'center',
        }}
      >
        <div style={{ fontSize: '2.5rem', marginBottom: '0.75rem' }}>
          ✅
        </div>
        <p
          style={{
            fontSize: '1.3rem',
            fontWeight: 800,
            color: '#166534',
            margin: '0 0 0.5rem',
          }}
        >
          Message sent!
        </p>
        <p style={{ color: '#15803d', margin: 0 }}>
          Thank you — we will get back to you very soon.
        </p>
      </div>
    );
  }

  return (
    <div style={{ maxWidth: '640px', margin: '0 auto 3rem' }}>
      <style>{`
        .nx-cf input, .nx-cf textarea {
          width: 100%;
          box-sizing: border-box;
          padding: 0.95rem 1.1rem;
          border: 1.5px solid #e2e8f0;
          border-radius: 12px;
          font-size: 1rem;
          font-family: inherit;
          background: #ffffff;
          color: #111827;
          outline: none;
          transition: border-color .15s ease, box-shadow .15s ease;
        }
        .nx-cf input::placeholder, .nx-cf textarea::placeholder {
          color: #94a3b8;
        }
        .nx-cf input:focus, .nx-cf textarea:focus {
          border-color: ${color};
          box-shadow: 0 0 0 3px color-mix(in srgb, ${color} 25%, transparent);
        }
        .nx-cf button {
          transition: filter .15s ease, transform .15s ease;
        }
        .nx-cf button:hover:not(:disabled) {
          filter: brightness(0.92);
          transform: translateY(-1px);
        }
      `}</style>

      <div
        className="nx-cf"
        style={{
          background: '#f8fafc',
          borderRadius: '24px',
          padding: '2.5rem',
          display: 'flex',
          flexDirection: 'column',
          gap: '1rem',
          boxShadow: '0 10px 40px rgba(0,0,0,0.06)',
        }}
      >
        <span
          style={{
            fontSize: '0.8rem',
            fontWeight: 700,
            letterSpacing: '0.08em',
            textTransform: 'uppercase',
            color: color,
            marginBottom: '0.25rem',
          }}
        >
          Send us a message
        </span>

        <input
          type="text"
          placeholder="Your name"
          value={name}
          onChange={(e) => setName(e.target.value)}
        />
        <input
          type="email"
          placeholder="Your email"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
        />
        <textarea
          placeholder="Your message"
          value={message}
          onChange={(e) => setMessage(e.target.value)}
          rows={4}
          style={{ resize: 'vertical' }}
        />

        {status === 'error' && (
          <p
            style={{
              color: '#dc2626',
              margin: 0,
              fontSize: '0.95rem',
            }}
          >
            Please fill in all fields with a valid email.
          </p>
        )}

        <button
          onClick={handleSubmit}
          disabled={status === 'sending'}
          style={{
            background: color,
            color: 'white',
            border: 'none',
            padding: '1rem',
            borderRadius: '12px',
            fontSize: '1.1rem',
            fontWeight: 700,
            cursor: status === 'sending' ? 'wait' : 'pointer',
            marginTop: '0.25rem',
          }}
        >
          {status === 'sending' ? 'Sending...' : 'Send Message'}
        </button>
      </div>
    </div>
  );
}
