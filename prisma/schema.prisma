
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}

model drivers {

id String @id @default(cuid())

driver_id String?
full_name String?
phone String?
email String?
license_number String?
license_type String?
license_expiry_date String?
date_of_birth String?
hire_date String?
status String?
address String?
emergency_contact String?
total_deliveries String?
rating_average String?
notes String?

vehicle_assignments vehicle_assignments[]
deliveries deliveries[]
incidents incidents[]
plans route_planning[] @relation("PlanDriver")
tracking_events tracking_events[] @relation("EventDriver")
fuel_logs fuel_logs[] @relation("FuelLogDriver")

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model vehicles {

id String @id @default(cuid())

vehicle_id String?
plate_number String?
brand String?
model String?
year String?
type String?
fuel_type String?
capacity_kg String?
volume_m3 String?
color String?
vin_number String?
registration_number String?
registration_expiry String?
insurance_policy String?
insurance_expiry String?
current_mileage String?
status String?
last_maintenance_date String?
next_maintenance_km String?
gps_device_id String?
notes String?

vehicle_assignments vehicle_assignments[]
vehicle_maintenance vehicle_maintenance[]
deliveries deliveries[]
fuel_logs fuel_logs[]
plans route_planning[] @relation("PlanVehicle")
incidents incidents[] @relation("IncidentVehicle")

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model vehicle_assignments {

id String @id @default(cuid())

assignment_id String?
vehicle_id String?
driver_id String?
assigned_date String?
unassigned_date String?
assignment_type String?
status String?
notes String?

driver drivers[] 
vehicle vehicles[] 

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model deliveries {

id String @id @default(cuid())

delivery_id String?
delivery_code String?
driver_id String?
vehicle_id String?
route_id String?
sender_name String?
sender_phone String?
sender_address String?
recipient_name String?
recipient_phone String?
recipient_address String?
recipient_city String?
scheduled_date String?
scheduled_time_slot String?
pickup_datetime String?
delivery_datetime String?
status String?
priority String?
package_type String?
weight_kg String?
volume_m3 String?
fragile String?
proof_of_delivery String?
signature_collected String?
photo_url String?
delivery_notes String?
failure_reason String?
attempt_count String?
created_at String?

driver drivers[] 
vehicle vehicles[] 
route routes? @relation(
"DeliveryRoute",
fields: [route_id],
references: [route_id]
)
tracking_events tracking_events[]
incidents incidents[] @relation("IncidentDelivery")

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model routes {

id String @id @default(cuid())

route_id String?
route_name String?
route_code String?
origin_city String?
destination_city String?
waypoints String?
estimated_distance_km String?
estimated_duration_min String?
zone String?
status String?
notes String?

deliveries deliveries[] @relation("DeliveryRoute")
route_planning route_planning[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model route_planning {

id String @id @default(cuid())

plan_id String?
route_id String?
driver_id String?
vehicle_id String?
plan_date String?
departure_time String?
expected_return_time String?
total_stops String?
total_deliveries String?
total_weight_kg String?
total_volume_m3 String?
status String?
optimization_score String?
notes String?

route routes[] 
driver drivers? @relation(
"PlanDriver",
fields: [driver_id],
references: [driver_id]
)
vehicle vehicles? @relation(
"PlanVehicle",
fields: [vehicle_id],
references: [vehicle_id]
)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model tracking_events {

id String @id @default(cuid())

event_id String?
delivery_id String?
driver_id String?
event_type String?
event_datetime String?
latitude String?
longitude String?
address_snapshot String?
description String?
created_by String?

delivery deliveries[] 
driver drivers? @relation(
"EventDriver",
fields: [driver_id],
references: [driver_id]
)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model vehicle_maintenance {

id String @id @default(cuid())

maintenance_id String?
vehicle_id String?
maintenance_type String?
description String?
scheduled_date String?
completed_date String?
mileage_at_service String?
next_service_mileage String?
garage_name String?
technician_name String?
cost String?
invoice_number String?
parts_replaced String?
status String?
notes String?

vehicle vehicles[] 

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model fuel_logs {

id String @id @default(cuid())

fuel_log_id String?
vehicle_id String?
driver_id String?
date String?
fuel_type String?
liters String?
cost_per_liter String?
total_cost String?
mileage_at_refuel String?
station_name String?
payment_method String?
receipt_number String?
notes String?

vehicle vehicles[] 
driver drivers? @relation(
"FuelLogDriver",
fields: [driver_id],
references: [driver_id]
)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model incidents {

id String @id @default(cuid())

incident_id String?
driver_id String?
vehicle_id String?
delivery_id String?
incident_date String?
incident_type String?
severity String?
location String?
latitude String?
longitude String?
description String?
third_party_involved String?
police_report_number String?
insurance_claim_number String?
estimated_damage_cost String?
status String?
resolution_notes String?
photos String?

driver drivers[] 
vehicle vehicles? @relation(
"IncidentVehicle",
fields: [vehicle_id],
references: [vehicle_id]
)
deliverie deliveries? @relation(
"IncidentDelivery",
fields: [delivery_id],
references: [delivery_id]
)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}
