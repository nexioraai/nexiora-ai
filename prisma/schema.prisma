
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}

model vehicles {

id String @id @default(cuid())

vehicle_id String?
registration_number String?
brand String?
model String?
year String?
vehicle_type String?
fuel_type String?
payload_capacity_kg String?
volume_capacity_m3 String?
current_mileage_km String?
last_service_date String?
next_service_date String?
insurance_number String?
insurance_expiry_date String?
technical_inspection_date String?
technical_inspection_expiry String?
gps_tracker_id String?
status String?
current_location String?
acquisition_date String?
acquisition_cost String?
assigned_driver_id String?
notes String?



createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model drivers {

id String @id @default(cuid())

driver_id String?
first_name String?
last_name String?
date_of_birth String?
national_id String?
phone String?
email String?
address String?
city String?
license_number String?
license_category String?
license_issue_date String?
license_expiry_date String?
adr_certificate String?
adr_expiry_date String?
hire_date String?
employment_type String?
status String?
total_km_driven String?
total_deliveries_completed String?
rating_score String?
emergency_contact_name String?
emergency_contact_phone String?
notes String?



createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model customers {

id String @id @default(cuid())

customer_id String?
company_name String?
contact_first_name String?
contact_last_name String?
phone String?
mobile String?
email String?
billing_address String?
billing_city String?
billing_postal_code String?
billing_country String?
default_delivery_address String?
default_delivery_city String?
default_delivery_postal_code String?
tax_number String?
registration_number String?
payment_terms_days String?
credit_limit String?
currency String?
customer_type String?
account_status String?
total_orders String?
total_revenue String?
assigned_account_manager String?
notes String?
created_at String?



createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model deliveries {

id String @id @default(cuid())

delivery_id String?
delivery_reference String?
customer_id String?
driver_id String?
vehicle_id String?
pickup_address String?
pickup_city String?
pickup_postal_code String?
pickup_country String?
pickup_contact_name String?
pickup_contact_phone String?
scheduled_pickup_date String?
actual_pickup_date String?
delivery_address String?
delivery_city String?
delivery_postal_code String?
delivery_country String?
delivery_contact_name String?
delivery_contact_phone String?
scheduled_delivery_date String?
actual_delivery_date String?
cargo_description String?
cargo_weight_kg String?
cargo_volume_m3 String?
cargo_quantity String?
cargo_type String?
is_fragile String?
requires_refrigeration String?
temperature_min String?
temperature_max String?
distance_km String?
estimated_duration_hours String?
actual_duration_hours String?
delivery_status String?
priority_level String?
tracking_code String?
proof_of_delivery_signature String?
proof_of_delivery_photo String?
delivery_notes String?
failure_reason String?
delivery_cost String?
billing_status String?
created_at String?
updated_at String?



createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}
