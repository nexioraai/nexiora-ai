
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}

model menu_items {
id String @id @default(cuid())

item_id String?
name String?
description String?
category String?
subcategory String?
base_price String?
cost_price String?
profit_margin String?
preparation_time_minutes String?
calories String?
allergens String?
dietary_tags String?
is_available String?
is_seasonal String?
image_url String?
recipe_id String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model recipes {
id String @id @default(cuid())

recipe_id String?
name String?
instructions String?
serving_size String?
prep_time_minutes String?
cook_time_minutes String?
difficulty_level String?
plating_notes String?
version String?
created_by_chef String?
last_updated String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model recipe_ingredients {
id String @id @default(cuid())

line_id String?
recipe_id String?
ingredient_id String?
quantity String?
unit_of_measure String?
preparation_note String?
is_optional String?
substitute_ingredient_id String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

