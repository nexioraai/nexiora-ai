
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}

model customers {
id String @id @default(cuid())

name String?
phone String?
email String?
address String?
customer_type String?
created_at String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model suppliers {
id String @id @default(cuid())

name String?
phone String?
email String?
address String?
tax_id String?
payment_terms String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model products {
id String @id @default(cuid())

name String?
sku String?
price String?
cost String?
category String?
stock_quantity String?
reorder_level String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model orders {
id String @id @default(cuid())

order_id String?
customer_id String?
order_date String?
status String?
total_amount String?
payment_status String?
delivery_date String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model inventory {
id String @id @default(cuid())

product_id String?
warehouse_location String?
quantity_on_hand String?
quantity_reserved String?
last_updated String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model invoices {
id String @id @default(cuid())

invoice_id String?
order_id String?
issue_date String?
due_date String?
amount String?
tax String?
status String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model employees {
id String @id @default(cuid())

name String?
role String?
department String?
email String?
salary String?
hire_date String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model purchases {
id String @id @default(cuid())

purchase_order_id String?
supplier_id String?
order_date String?
expected_delivery String?
status String?
total_cost String?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}
