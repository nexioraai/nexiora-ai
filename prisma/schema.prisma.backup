
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url = env("DATABASE_URL")
}

model vehicles {

id String @id @default(cuid())

vehicle_id String?
license_plate String?
brand String?
model String?
year String?
vehicle_type String?
fuel_type String?
mileage_current String?
mileage_last_service String?
payload_capacity_kg String?
volume_capacity_m3 String?
registration_number String?
registration_expiry_date String?
insurance_provider String?
insurance_policy_number String?
insurance_expiry_date String?
technical_inspection_date String?
technical_inspection_expiry String?
status String?
acquisition_date String?
acquisition_cost String?
gps_device_id String?
current_location String?
assigned_depot String?
notes String?

drivers drivers[]
deliveries deliveries[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model drivers {

id String @id @default(cuid())

driver_id String?
first_name String?
last_name String?
date_of_birth String?
national_id String?
phone String?
emergency_phone String?
email String?
address String?
city String?
hire_date String?
employment_type String?
license_number String?
license_category String?
license_issue_date String?
license_expiry_date String?
medical_certificate_expiry String?
adr_certificate String?
adr_expiry_date String?
status String?
assigned_vehicle_id String?
total_deliveries String?
total_km_driven String?
rating_average String?
salary_base String?
bonus_per_delivery String?
bank_account String?
notes String?

assigned_vehicle vehicles?
deliveries deliveries[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model customers {

id String @id @default(cuid())

customer_id String?
company_name String?
contact_first_name String?
contact_last_name String?
customer_type String?
phone String?
mobile String?
email String?
tax_id String?
billing_address String?
billing_city String?
billing_postal_code String?
billing_country String?
default_delivery_address String?
default_delivery_city String?
default_delivery_postal_code String?
default_delivery_country String?
delivery_instructions String?
preferred_delivery_time_slot String?
credit_limit String?
payment_terms_days String?
contract_start_date String?
contract_end_date String?
rate_per_km String?
rate_per_kg String?
flat_delivery_rate String?
status String?
account_manager String?
total_deliveries String?
total_revenue String?
notes String?

deliveries deliveries[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model deliveries {

id String @id @default(cuid())

delivery_id String?
delivery_reference String?
customer_id String?
driver_id String?
vehicle_id String?
route_id String?
delivery_type String?
status String?
priority String?
pickup_address String?
pickup_city String?
pickup_postal_code String?
pickup_contact_name String?
pickup_contact_phone String?
pickup_scheduled_date String?
pickup_scheduled_time_from String?
pickup_scheduled_time_to String?
pickup_actual_datetime String?
delivery_address String?
delivery_city String?
delivery_postal_code String?
delivery_contact_name String?
delivery_contact_phone String?
delivery_scheduled_date String?
delivery_scheduled_time_from String?
delivery_scheduled_time_to String?
delivery_actual_datetime String?
distance_km String?
weight_kg String?
volume_m3 String?
package_count String?
fragile String?
requires_cold_chain String?
requires_signature String?
special_instructions String?
delivery_cost String?
billing_status String?
proof_of_delivery_photo String?
signature_image String?
recipient_name String?
gps_track_start String?
gps_track_end String?
failure_reason String?
attempt_count String?
notes String?

vehicle vehicles?
driver drivers?
customer customers?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}
