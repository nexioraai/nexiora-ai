  "expectedTests": [
    {
      "description": "Vérifie que la validation de l'entité conteneur rejette un numéro non conforme au format ISO 6346 (4 lettres majuscules + 7 chiffres) et accepte « MSCU1234567 ».",
      "id": "test_numero_conteneur_iso6346",
      "kind": "deterministic",
      "targetId": "ent_conteneur"
    },
    {
      "description": "Vérifie que l'enregistrement d'un suivi échoue si le navire, un port ou la date d'arrivée estimée est absent.",
      "id": "test_trajet_complet_requis",
      "kind": "deterministic",
      "targetId": "act_enregistrer_suivi"
    },
    {
      "description": "Vérifie qu'un statut de dédouanement hors de la liste reconnue est refusé et que la date de mise à jour du conteneur est obligatoire.",
      "id": "test_statut_douane_valide",
      "kind": "deterministic",
      "targetId": "ent_conteneur"
    },
    {
      "description": "Vérifie qu'un importateur authentifié ne voit que les conteneurs portant sa référence client et aucun autre.",
      "id": "test_cloisonnement_conteneurs_client",
      "kind": "deterministic",
      "targetId": "act_authentifier_importateur"
    },
    {
      "description": "Vérifie que l'action de libellé traduit chaque code de statut douanier en libellé français lisible et retourne un ton de badge cohérent.",
      "id": "test_libelle_statut_douane",
      "kind": "deterministic",
      "targetId": "act_libeller_statuts"
    },
    {
      "description": "Vérifie le formatage français de la date d'arrivée estimée et le calcul des jours restants au fuseau d'Abidjan (UTC+0), y compris pour une ETA dépassée.",
      "id": "test_eta_lisible_fuseau_abidjan",
      "kind": "deterministic",
      "targetId": "act_afficher_eta"
    },
    {
      "description": "Vérifie que le message d'alerte composé mentionne le numéro de conteneur, l'ancien et le nouveau statut dans son titre et son corps.",
      "id": "test_message_notification_statut",
      "kind": "deterministic",
      "targetId": "act_composer_message_alerte"
    },
    {
      "description": "Vérifie que l'indicateur de fraîcheur signale des données obsolètes au-delà du seuil et affiche le nombre d'éléments en attente.",
      "id": "test_indicateur_synchronisation",
      "kind": "deterministic",
      "targetId": "act_etat_synchronisation"
    },
    {
      "description": "Vérifie que sur l'écran des conteneurs l'état vide n'est affiché que lorsque l'entité conteneur est vide, et masqué dès qu'un conteneur est suivi.",
      "id": "test_etat_vide_conteneurs_conditionne",
      "kind": "deterministic",
      "targetId": "scr_conteneurs"
    },
    {
      "description": "Vérifie que le bouton « Actualiser les statuts » de l'écran des conteneurs n'apparaît que si au moins un conteneur est suivi.",
      "id": "test_cta_actualiser_visible_avec_donnees",
      "kind": "deterministic",
      "targetId": "scr_conteneurs"
    },
    {
      "description": "Vérifie que sur l'écran des alertes l'état vide s'affiche uniquement en l'absence d'alerte et que le bouton « Tout marquer comme lu » s'affiche uniquement en présence d'alertes.",
      "id": "test_etat_vide_alertes_conditionne",
      "kind": "deterministic",
      "targetId": "scr_notifications"
    },
    {
      "description": "Vérifie qu'une alerte de statut exige un conteneur référencé, un nouveau statut et une date de survenue, et que son marquage comme lue met bien à jour l'indicateur de lecture.",
      "id": "test_alerte_changement_statut_coherente",
      "kind": "deterministic",
      "targetId": "ent_alerte_statut"
    },
    {
      "description": "Parcours complet : depuis la liste, ouvrir « Suivre un conteneur », renseigner le formulaire avec un numéro ISO valide, enregistrer, puis retrouver le conteneur dans la liste.",
      "id": "test_parcours_ajout_suivi",
      "kind": "e2e",
      "targetId": "act_enregistrer_suivi"
    },
    {
      "description": "Parcours complet : un changement de statut de dédouanement côté serveur déclenche une notification push dont l'ouverture mène à l'écran de détail du conteneur concerné.",
      "id": "test_parcours_notification_changement_statut",
      "kind": "e2e",
      "targetId": "act_notifier_changement_statut"
    },
    {
      "description": "Parcours complet : après un préchargement réussi, couper le réseau et vérifier que la liste et le détail des conteneurs restent consultables avec l'indicateur de dernière synchronisation.",
      "id": "test_consultation_hors_ligne",
      "kind": "e2e",
      "targetId": "act_precharger_hors_ligne"
    },
    {
      "description": "Parcours complet : depuis le détail, déclencher le partage et vérifier que le texte partagé contient le numéro de conteneur et un lien de suivi valide.",
      "id": "test_partage_suivi_deep_link",
      "kind": "e2e",
      "targetId": "act_partager_suivi_conteneur"
    },
    {
      "description": "Contrat de synchronisation : l'endpoint renvoie les conteneurs, navires et alertes attendus avec les champs requis, et la politique server_wins est respectée en cas de conflit.",
      "id": "test_contrat_synchronisation_offline",
      "kind": "contract",
      "targetId": "act_synchroniser_conteneurs"
    },
    {
      "description": "Contrat d'intégration push : l'enregistrement de l'appareil sur le canal statuts_douane réussit et aucun secret n'est transmis depuis le client.",
      "id": "test_contrat_enregistrement_push",
      "kind": "contract",
      "targetId": "act_activer_notifications_push"
    },
    {
      "description": "Contrat d'authentification : restauration de session, renouvellement de session et appel de suppression de compte conformes au backend.",
      "id": "test_contrat_session_auth",
      "kind": "contract",
      "targetId": "act_authentifier_importateur"
    },
    {
      "description": "Contrat réseau : lors de l'actualisation des statuts, toute requête vers un domaine autre que api.suivi-conteneurs-abidjan.app est bloquée par la politique deny_by_default.",
      "id": "test_contrat_reseau_deny_by_default",
      "kind": "contract",
      "targetId": "act_synchroniser_conteneurs"
    }
  ],
