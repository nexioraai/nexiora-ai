  "slots": [
    {
      "allowedImports": [],
      "description": "Convertit un code de statut douanier en libellé français lisible et en couleur de badge pour l'affichage en liste et en détail.",
      "id": "slot_libelle_statut_douane",
      "inputs": [
        {
          "name": "statutDouane",
          "type": "enum"
        },
        {
          "name": "miseAJourLe",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "libelle",
          "type": "string"
        },
        {
          "name": "tonBadge",
          "type": "string"
        }
      ]
    },
    {
      "allowedImports": [
        "date-fns"
      ],
      "description": "Formate la date d'arrivée estimée en français (ex. « arrivée prévue le 14 juin, dans 5 jours ») en tenant compte du fuseau d'Abidjan.",
      "id": "slot_eta_lisible",
      "inputs": [
        {
          "name": "dateArriveeEstimee",
          "type": "date"
        },
        {
          "name": "maintenant",
          "type": "datetime"
        }
      ],
      "outputs": [
        {
          "name": "texteEta",
          "type": "string"
        },
        {
          "name": "joursRestants",
          "type": "number"
        }
      ]
    },
    {
      "allowedImports": [],
      "description": "Compose le titre et le corps de la notification push envoyée lors d'un changement de statut de dédouanement.",
      "id": "slot_message_notification_statut",
      "inputs": [
        {
          "name": "numeroConteneur",
          "type": "string"
        },
        {
          "name": "ancienStatut",
          "type": "enum"
        },
        {
          "name": "nouveauStatut",
          "type": "enum"
        }
      ],
      "outputs": [
        {
          "name": "titre",
          "type": "string"
        },
        {
          "name": "corps",
          "type": "text"
        }
      ]
    },
    {
      "allowedImports": [
        "date-fns"
      ],
      "description": "Calcule l'indicateur de fraîcheur des données hors-ligne (dernière synchronisation réussie et nombre d'éléments en attente).",
      "id": "slot_etat_synchronisation",
      "inputs": [
        {
          "name": "derniereSynchro",
          "type": "datetime"
        },
        {
          "name": "elementsEnAttente",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "texteSynchro",
          "type": "string"
        },
        {
          "name": "donneesObsoletes",
          "type": "boolean"
        }
      ]
    }
  ]
