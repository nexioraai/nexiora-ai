  "rules": [
    {
      "assertions": [
        {
          "fieldId": "fld_conteneur_numero",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_numero",
          "operator": "matches",
          "value": "^[A-Z]{4}[0-9]{7}$"
        }
      ],
      "description": "Le numéro de conteneur doit respecter le format ISO 6346 : 4 lettres majuscules suivies de 7 chiffres (ex. MSCU1234567).",
      "entityId": "ent_conteneur",
      "id": "rule_conteneur_numero_iso6346",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_conteneur_navire",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_port_depart",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_port_arrivee",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_eta",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_port_arrivee",
          "operator": "neq",
          "value": ""
        }
      ],
      "description": "Un conteneur suivi doit indiquer son navire, ses ports de départ et d'arrivée ainsi que sa date d'arrivée estimée.",
      "entityId": "ent_conteneur",
      "id": "rule_conteneur_trajet_complet",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_conteneur_statut_douane",
          "operator": "in",
          "value": [
            "en_attente_documents",
            "declaration_deposee",
            "en_cours_verification",
            "droits_a_payer",
            "dedouane",
            "litige"
          ]
        },
        {
          "fieldId": "fld_conteneur_maj_le",
          "operator": "required"
        }
      ],
      "description": "Le statut de dédouanement doit appartenir à la liste des étapes douanières reconnues.",
      "entityId": "ent_conteneur",
      "id": "rule_conteneur_statut_valide",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_alerte_conteneur",
          "operator": "required"
        },
        {
          "fieldId": "fld_alerte_nouveau_statut",
          "operator": "required"
        },
        {
          "fieldId": "fld_alerte_survenue_le",
          "operator": "required"
        },
        {
          "fieldId": "fld_alerte_titre",
          "operator": "required"
        }
      ],
      "description": "Une alerte doit référencer un conteneur, porter un nouveau statut différent de l'ancien et une date de survenue.",
      "entityId": "ent_alerte_statut",
      "id": "rule_alerte_changement_statut",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_navire_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_navire_numero_voyage",
          "operator": "required"
        }
      ],
      "description": "Un navire doit porter un nom et un numéro de voyage pour être rattaché à des conteneurs.",
      "entityId": "ent_navire",
      "id": "rule_navire_identification",
      "kind": "validation"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_conteneur_reference_client",
          "operator": "required"
        },
        {
          "fieldId": "fld_conteneur_reference_client",
          "operator": "eq",
          "value": "@current_user.reference_client"
        }
      ],
      "description": "Un importateur connecté ne peut consulter que les conteneurs dont la référence client correspond à son compte.",
      "entityId": "ent_conteneur",
      "id": "rule_acces_conteneurs_client",
      "kind": "authorization"
    },
    {
      "assertions": [
        {
          "fieldId": "fld_alerte_conteneur",
          "operator": "required"
        }
      ],
      "description": "Les alertes de statut ne sont lisibles que par le destinataire du conteneur concerné.",
      "entityId": "ent_alerte_statut",
      "id": "rule_acces_alertes_client",
      "kind": "authorization"
    }
  ],
